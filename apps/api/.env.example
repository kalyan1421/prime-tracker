# apps/api/.env — copy to .env and fill in. Never commit the filled file.
# In production these are not read from a file at all: the deploy pulls them from
# SSM Parameter Store under /prime-tracker/* (see infra/terraform/ssm.tf).

# ── Database ────────────────────────────────────────────────────────────────
# DIRECT_URL bypasses the connection pool — Prisma migrations need it.
DATABASE_URL="postgresql://prime:prime_secret@localhost:5432/prime_tracker?schema=public"
DIRECT_URL="postgresql://prime:prime_secret@localhost:5432/prime_tracker?schema=public"
REDIS_URL="redis://localhost:6379"

# ── Auth ────────────────────────────────────────────────────────────────────
# Two DIFFERENT secrets. Sharing one means a refresh token is accepted as an
# access token. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Google Workspace SSO. The callback must match the authorised redirect URI in the
# Google Cloud console exactly, including the port.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
# Restricts sign-in to one Workspace domain. Empty = any Google account.
GOOGLE_ALLOWED_DOMAIN="primedevelopers.com"

TOTP_ISSUER="Prime Tracker"

# AES-256-GCM key for encrypted columns (loan terms). 32 bytes, hex or base64.
# CHANGING THIS MAKES EXISTING ENCRYPTED ROWS UNREADABLE — it must be carried
# across environments, not regenerated. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# ── Storage ─────────────────────────────────────────────────────────────────
# "local" writes to apps/api/uploads; "s3" uses the bucket below.
STORAGE_DRIVER="local"
AWS_REGION="us-east-1"
S3_BUCKET=""
S3_PUBLIC_BASE_URL=""

# ── QuickBooks (optional; sync is unverified against live credentials) ───────
QB_CLIENT_ID=""
QB_CLIENT_SECRET=""
QB_REDIRECT_URI="http://localhost:3001/api/quickbooks/callback"
QB_ENVIRONMENT="sandbox"

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT="3001"
FRONTEND_URL="http://localhost:5173"
# Comma-separated. Must include every origin the browser loads the SPA from —
# a missing port here is the usual cause of a failed presigned upload.
CORS_ORIGINS="http://localhost:5173"

# Seeds demo users and enables the local one-click role login (docs/DEV_LOGIN.md).
# Gated off in production; never set true there.
DEMO_MODE="false"

# ── Throttling ──────────────────────────────────────────────────────────────
# TTL in seconds, LIMIT in requests. The general limit is 10/sec — low enough that
# a client-side loop doing one write per item silently truncates. Use bulk routes.
THROTTLE_TTL="1"
THROTTLE_LIMIT="10"
AUTH_THROTTLE_TTL="60"
AUTH_THROTTLE_LIMIT="10"
