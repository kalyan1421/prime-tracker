// =============================================
// Prime Tracker — Prisma Schema
// Single-tenant now, multi-tenant ready (tenantId fields commented)
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- Auth & RBAC ----

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  avatarUrl    String?
  googleId     String?    @unique
  // Directory fields — self-editable, and editable by an admin on someone else.
  // Never authorization-relevant, unlike role/roles/isActive.
  phone        String?
  jobTitle     String?
  role         UserRole   @default(VIEWER)
  roles        UserRole[] @default([])
  isActive     Boolean    @default(true)
  passwordHash String?
  mfaEnabled   Boolean    @default(false)
  mfaSecret    String? // encrypted TOTP secret
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  // tenantId   String?   // future multi-tenant

  milestones                        Milestone[]                     @relation("MilestoneOwner")
  auditEvents                       AuditEvent[]
  sessions                          RefreshToken[]
  unitComments                      UnitComment[]
  projectComments                   ProjectComment[]
  notifications                     Notification[]
  notificationPreferences           NotificationPreference[]
  assignedLeads                     Lead[]                          @relation("LeadAssignee")
  createdLeads                      Lead[]                          @relation("LeadCreator")
  leadActivities                    LeadActivity[]                  @relation("ActivityCreator")
  drawRequests                      DrawRequest[]                   @relation("DrawCreator")
  approvedDraws                     DrawRequest[]                   @relation("DrawApprover")
  uploadedDocuments                 Document[]                      @relation("DocumentUploader")
  assignedTasks                     Task[]                          @relation("TaskAssignee")
  createdTasks                      Task[]                          @relation("TaskCreator")
  taskComments                      TaskComment[]
  taskAttachments                   TaskAttachment[]                @relation("TaskAttachmentUploader")
  orgMemberships                    OrgMembership[]                 @relation("OrgMember")
  managedMembers                    OrgMembership[]                 @relation("ManagedBy")
  projectMemberships                ProjectMember[]
  // New relations from Slices 1, 5, 7, 8
  milestonePhotos                   MilestonePhoto[]                @relation("MilestonePhotoUploader")
  // C6 — the sign-off half of milestone photo evidence. Deliberately a SECOND relation:
  // the person who shot the photo and the person who vouches for it are different people,
  // and collapsing them into one column is exactly what makes a sign-off meaningless.
  milestonePhotoReviews             MilestonePhoto[]                @relation("MilestonePhotoReviewer")
  milestoneSignoffOverrides         Milestone[]                     @relation("MilestoneSignoffOverrider")
  budgetRevisionsCreated            BudgetRevision[]                @relation("BudgetRevCreator")
  budgetRevisionsApproved           BudgetRevision[]                @relation("BudgetRevApprover")
  drawApprovals                     DrawApproval[]                  @relation("DrawApprovalActor")
  drawDocuments                     DrawDocument[]                  @relation("DrawDocUploader")
  // Document Vault Phase 1
  uploadedDocVersions               DocumentVersion[]               @relation("VersionUploader")
  // Document Vault Phase 2 — buyer portal
  clientProfile                     Client?                         @relation("ClientUser")
  // Sprint 2 — Campaign attribution
  campaignsCreated                  Campaign[]                      @relation("CampaignCreator")
  campaignSpendRecorded             CampaignSpend[]                 @relation("CampaignSpender")
  // Interior / Fit-Out + Sale Payments
  interiorProjects                  InteriorProject[]               @relation("InteriorPM")
  snagItems                         SnagItem[]                      @relation("SnagAssignee")
  discountApprovedSales             Sale[]                          @relation("SaleDiscountApprover")
  cancelledSales                    SaleCancellation[]              @relation("SaleCancelledBy")
  dailyLogs                         DailyLog[]                      @relation("DailyLogAuthor")
  // Leasing depth — rent timeline + deposit/TI ledger
  leaseRentPeriods                  LeaseRentPeriod[]               @relation("LeaseRentPeriodCreator")
  leaseRentCorrections              LeaseRentPeriodCorrection[]     @relation("LeaseRentPeriodCorrector")
  leaseObligationPayments           LeaseObligationPayment[]        @relation("LeaseObligationPaymentRecorder")
  leaseRentInvoices                 LeaseRentInvoice[]              @relation("LeaseRentInvoiceRecorder")
  leaseAssignmentsRecorded          LeaseTenantAssignment[]         @relation("LeaseAssignmentRecorder")
  historicalDeletionsRequested      HistoricalRecordDeletion[]      @relation("HistoricalDeletionRequester")
  historicalDeletionsDecided        HistoricalRecordDeletion[]      @relation("HistoricalDeletionDecider")
  taskUpdates                       TaskUpdate[]                    @relation("TaskUpdateAuthor")
  taskAssignments                   TaskAssignment[]                @relation("TaskAssignmentUser")
  // Unit construction checklist
  constructionStageTemplatesCreated ConstructionStageTemplateItem[] @relation("ConstructionStageTemplateCreator")
  constructionStagesOwned           UnitConstructionStage[]         @relation("UnitConstructionStageOwner")
  stagePhotosUploaded               UnitConstructionStagePhoto[]    @relation("StagePhotoUploader")
  checklistTemplatesCreated         ChecklistTemplate[]             @relation("ChecklistTemplateCreator")
  unitAssignments                   UnitAssignee[]                  @relation("UnitAssigneeUser")
  unitAssignmentsMade               UnitAssignee[]                  @relation("UnitAssigneeAssigner")
  constructionStagesCreated         UnitConstructionStage[]         @relation("UnitConstructionStageCreator")
  // Unit occupancy log
  unitStatusEvents                  UnitStatusEvent[]               @relation("UnitStatusEventRecorder")
  // C3 — the PM review gate on a milestone slip cascade
  slipProposalsRequested            MilestoneSlipProposal[]         @relation("SlipProposalRequester")
  slipProposalsDecided              MilestoneSlipProposal[]         @relation("SlipProposalDecider")
  // S3 — unit swap mid-contract
  saleUnitTransfersRecorded         SaleUnitTransfer[]              @relation("SaleUnitTransferRecorder")
  // Global Update Board — org-wide, not project-scoped (see model UpdateBoardPost)
  createdUpdateBoardPosts           UpdateBoardPost[]               @relation("UpdateBoardPostCreator")
  updateBoardAssignments            UpdateBoardAssignment[]         @relation("UpdateBoardAssignmentUser")
  updateBoardAttachments            UpdateBoardAttachment[]         @relation("UpdateBoardAttachmentUploader")
  updateBoardComments               UpdateBoardComment[]            @relation("UpdateBoardCommentAuthor")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

enum UserRole {
  SUPER_ADMIN
  FOUNDER
  EXECUTIVE
  FINANCE
  ACCOUNTING
  AR_AP
  PROJECT_MANAGER
  CONSTRUCTION
  SALES
  MARKETING
  LEGAL
  VIEWER
  // Buyer portal role (Phase 2 of Document Vault rollout) — sees only their own unit
  CLIENT
}

enum OrgRole {
  LEAD
  EMPLOYEE
}

// ---- Organizations ----

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  entityType  String? // LLC, LP, Corp
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships OrgMembership[]
  projects    Project[]
  settings    OrgSettings?

  @@map("organizations")
}

model OrgMembership {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("OrgMember", fields: [userId], references: [id], onDelete: Cascade)
  orgRole   OrgRole      @default(EMPLOYEE)
  reportsTo String?
  manager   User?        @relation("ManagedBy", fields: [reportsTo], references: [id])
  joinedAt  DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
  @@map("org_memberships")
}

// ---- Projects ----

model Project {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  location       String
  address        String?
  acreage        Decimal?      @db.Decimal(10, 3)
  // Top-down "control total" approved by Finance/Founder. Detailed budget lines are
  // tracked bottom-up against this; the Approved-vs-Planned gap is a key signal.
  approvedBudget Decimal?      @db.Decimal(14, 2)
  status         String        @default("ACTIVE")
  phase          String        @default("PRE_DEVELOPMENT")
  projectType    ProjectType?
  description    String?
  startDate      DateTime?
  targetEnd      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime? // soft-delete: archived rows excluded from default reads
  // tenantId  String?
  orgId          String?
  org            Organization? @relation(fields: [orgId], references: [id])

  buildings        Building[]
  milestones       Milestone[]
  budgetLines      BudgetLine[]
  commitments      Commitment[]
  actuals          Actual[]
  loans            Loan[]
  sales            Sale[]
  kpiSnapshots     KpiSnapshot[]
  qbMappings       QBProjectMapping[]
  comments         ProjectComment[]
  leads            Lead[]
  drawRequests     DrawRequest[]
  cashFlowEntries  CashFlowEntry[]
  contracts        Contract[]
  documents        Document[]
  equityPositions  EquityPosition[]
  capitalCalls     CapitalCall[]
  distributions    Distribution[]
  tasks            Task[]
  members          ProjectMember[]
  clients          Client[]
  campaignProjects CampaignProject[]
  dailyLogs        DailyLog[]
  slipProposals    MilestoneSlipProposal[]
  // Optional tag only — see UpdateBoardPost. Does not scope who can see the board.
  updateBoardPosts UpdateBoardPost[]

  @@index([orgId])
  @@index([status, phase])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  // One membership row per (project, user); a person can hold SEVERAL roles on the same
  // project (e.g. Finance AND Legal). `role` mirrors roles[0] as the primary, exactly as
  // User.role mirrors User.roles[0], so every existing read keeps working unchanged.
  role      String   @default("TEAM_MEMBER")
  roles     String[] @default([])
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@map("project_members")
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  INDUSTRIAL
}

// ---- Buildings & Units ----

model Building {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  // Legal entity that owns this building (e.g. "Prime Leander I LLC"). Free-text by
  // design — Prime tracks the LLC *label* per building, not LLC master data (EIN,
  // registered address, formation docs). If entity-level reporting is ever needed,
  // promote to a LegalEntity relation via SELECT DISTINCT "llcName".
  llcName        String?
  totalSqft      Int?
  // For LOT-type buildings (raw parcels — see BuildingType.LOT), size is expressed
  // in acres rather than square feet. Stored as Decimal(10,3) to support fractional
  // acreage (e.g. 1.27, 8.0, 11.98 from the Rio Ranch lots).
  acreage        Decimal?      @db.Decimal(10, 3)
  stories        Int?
  buildingType   BuildingType?
  // Building-level phase: a project may have Building A in CONSTRUCTION and Building B in LEASE_UP.
  // Project.phase is computed = max(buildings.phase) — see ProjectPhaseService.
  phase          String        @default("PRE_DEVELOPMENT")
  coverPhotoPath String? // optional cover photo (Supabase storage path)
  sortOrder      Int           @default(0) // manual display order within a project (drag-to-reorder)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime? // soft-delete

  units                          Unit[]
  tasks                          Task[]
  taskBuildings                  TaskBuilding[]
  documents                      Document[]
  // Polymorphic back-relations: Sale/Lease/Lead/Loan can attach to a Building directly
  // (e.g. Leander Building 1 leased as one whole asset to "22 Yards Austin") in addition to
  // attaching to a specific Unit. Service-level validation ensures exactly one of
  // (buildingId, unitId) is set per row — see Sprint 1 docs.
  sales                          Sale[]
  leases                         Lease[]
  leads                          Lead[]
  loans                          Loan[]
  budgetLines                    BudgetLine[]
  commitments                    Commitment[]
  actuals                        Actual[]
  interiorProjects               InteriorProject[]
  dailyLogs                      DailyLog[]
  constructionStageTemplateItems ConstructionStageTemplateItem[]
  // Optional tag only — see UpdateBoardPost. Does not scope who can see the board.
  updateBoardPosts               UpdateBoardPost[]

  @@index([projectId])
  @@index([projectId, sortOrder])
  @@index([phase])
  @@index([deletedAt])
  @@map("buildings")
}

/// Lifecycle state of a unit.
///
/// Was a free `String @default("AVAILABLE")`. Nothing constrained it, so a typo in any
/// client wrote a value the UI has no colour, label or ordering for — it would simply
/// vanish from the status mix and every status-filtered query. The values below are the
/// five present in the data plus the two the UI already renders.
enum UnitStatus {
  AVAILABLE
  UNDER_CONTRACT
  LEASE_PENDING
  LEASED
  OCCUPIED
  SOLD
  UNDER_CONSTRUCTION
}

model Unit {
  id             String     @id @default(cuid())
  buildingId     String
  building       Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitNumber     String
  // Free-text type key backed by CustomOption (category="unit_type") — was a hardcoded
  // UnitType enum; converted so orgs can add their own unit types without a schema change.
  // The 8 former enum values are seeded as system defaults in custom-options.service.ts.
  unitType       String
  sqft           Int?
  // Optional split of total sqft into floor + mezzanine. Some lease structures price
  // these separately (e.g. Lewisville P1 mezzanine units). When both are set,
  // `sqft` is the grand total — service code does not auto-derive to keep historical
  // unit sizes immutable.
  floorArea      Decimal?   @db.Decimal(10, 2)
  mezzanineArea  Decimal?   @db.Decimal(10, 2)
  status         UnitStatus @default(AVAILABLE)
  askingRent     Decimal?   @db.Decimal(12, 2) // per sqft/month
  askingPrice    Decimal?   @db.Decimal(14, 2) // for sale units
  primeOwned     Boolean    @default(false)
  notes          String?
  // Time-on-market tracking: set when status flips to AVAILABLE, cleared on any other status.
  // Read-only from app code — UnitsService maintains this in update().
  availableSince DateTime?

  // ── Site Tracker (Phase 1) ────────────────────────────────────────────────
  // Ported from the client's monday board, which tracks these per building-unit and has
  // nowhere to put them here. Three-state on purpose: 'YES' | 'NO' | null. The board
  // itself has 23 NO, 1 YES and 1 genuinely-empty row, and "nobody has assessed this yet"
  // is not the same claim as "not blocked" — a boolean would erase that distinction.
  blockerStatus String?
  // The board has no such field, which makes its own YES flag unactionable: you can see
  // that something is stuck and not why. Required by the service whenever status is YES.
  blockerReason String?
  // Stamped on the flip TO 'YES', cleared on the flip away — the same maintained-in-
  // service pattern as `availableSince` above. Gives blocker AGE, which the board cannot
  // show at all; "blocked" matters much less than "blocked for eleven days".
  blockerSince  DateTime?
  // CustomOption category "site_priority". Deliberately LOW/MEDIUM/HIGH only: the board's
  // PRIORITY column also carries a "DONE" value, which mixes priority with completion and
  // is why its own group battery reports the wrong number. Completion is the checklist %.
  sitePriority  String?
  // ── Checklist template provenance (Phase 2) ───────────────────────────────
  // Which template this unit's checklist was built from, stamped once at apply time.
  // This is the field the source board lacks, and the direct cause of the five divergent
  // step lists found on it. Nullable: units whose checklist predates templating, and
  // units whose stages were built ad-hoc, legitimately have no provenance.
  templateId      String?
  template        ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion Int?

  siteAssignees UnitAssignee[]

  // Unit combine: when adjacent units merge into one legal unit, the source units are
  // soft-deleted and point here at the surviving combined unit (retains their child history).
  mergedIntoId String?
  mergedInto   Unit?     @relation("UnitMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Unit[]    @relation("UnitMerge")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // soft-delete: preserves financial history

  leases             Lease[]
  sales              Sale[]
  statusEvents       UnitStatusEvent[]
  comments           UnitComment[]
  loans              Loan[]
  budgetLines        BudgetLine[]
  commitments        Commitment[]
  actuals            Actual[]
  documents          Document[]
  tasks              Task[]
  taskUnits          TaskUnit[]
  dailyLogs          DailyLog[]
  clients            Client[]
  leads              Lead[]
  interiorProjects   InteriorProject[]
  interestedLeads    LeadUnitInterest[]
  constructionStages UnitConstructionStage[]
  // S3 — unit swap mid-contract. Both sides, so a unit's page can show "a buyer moved
  // off this unit" and "this unit was taken over by an existing sale" alike.
  saleTransfersOut   SaleUnitTransfer[]      @relation("SaleUnitTransferFrom")
  saleTransfersIn    SaleUnitTransfer[]      @relation("SaleUnitTransferTo")
  // Optional tag only — see UpdateBoardPost. Does not scope who can see the board.
  updateBoardPosts   UpdateBoardPost[]

  // Uniqueness of (buildingId, unitNumber) is enforced by a partial unique index
  // (WHERE "deletedAt" IS NULL) added in migration 20260703000000_units_partial_unique_active —
  // Prisma's schema language can't express partial indexes, so it isn't declared here.
  // This plain index exists for query performance only.
  @@index([buildingId, unitNumber])
  @@index([buildingId])
  @@index([status, deletedAt])
  @@index([status, availableSince])
  @@index([deletedAt])
  @@index([mergedIntoId])
  // The Site Tracker's default sort is "blocked first"; the partial-ish shape of this
  // index also serves the "how many are blocked right now" rail count.
  @@index([blockerStatus, deletedAt])
  @@index([templateId])
  @@map("units")
}

// ============================================================================
// Unit occupancy log — append-only.
//
// `Unit.availableSince` is a single mutable column: it is stamped with now() on a
// flip TO AVAILABLE and NULLED on a flip away from it. That makes it a "current
// state" field masquerading as history — once a unit leases, how long it sat
// vacant is gone. (Measured 2026-08-12: 208 units are AVAILABLE and exactly 2 of
// them carry an availableSince, so the Vacancy Report was reading createdAt for
// the other 206.)
//
// This table is the durable record instead. One row per transition, written in
// the SAME transaction as the unit update by every service that flips a unit.
// Never updated, never deleted — a correction is a new row, not an edit.
//
// Two timestamps, deliberately:
//   effectiveAt — when it happened in the real world. Backdatable, and the only
//                 field vacancy/time-on-market maths should ever read.
//   recordedAt  — when the row was written. Equal to effectiveAt for live events;
//                 far apart for backfilled history.
//
// `availableSince` is kept in sync as a denormalised convenience (the stale-unit
// cron and existing reports read it) but is no longer the source of truth.
// ============================================================================

/// Who owns this unit's site work. Multi-assign: the board routinely carries two avatars
/// on a row, and 24 of its 25 rows are assigned. Distinct from ProjectMember (an access
/// boundary) and from TaskAssignment (per task) — this is "whose unit is this".
model UnitAssignee {
  unitId       String
  userId       String
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user         User     @relation("UnitAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now())
  assignedById String?
  assignedBy   User?    @relation("UnitAssigneeAssigner", fields: [assignedById], references: [id])

  @@id([unitId, userId])
  @@index([userId])
  @@map("unit_assignees")
}

model UnitStatusEvent {
  id           String      @id @default(cuid())
  unitId       String
  unit         Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  /// Null only for the unit's first event (creation, or the bootstrap backfill row).
  fromStatus   UnitStatus?
  toStatus     UnitStatus
  /// When the transition happened in the real world. Backdatable for historical entry.
  effectiveAt  DateTime
  /// When the row was written. Differs from effectiveAt for backfilled history.
  recordedAt   DateTime    @default(now())
  /// MANUAL | LEASE_ACTIVATED | LEASE_ENDED | SALE_CLOSED | SALE_CANCELLED
  /// | SALE_TRANSFERRED_OUT | SALE_TRANSFERRED_IN | UNIT_CREATED | UNIT_COMBINED
  /// | BACKFILL | SYSTEM
  source       String
  /// Provenance — which lease/sale drove this, when one did.
  leaseId      String?
  saleId       String?
  reason       String?
  /// True for rows created by historical backfill rather than observed live.
  isHistorical Boolean     @default(false)
  recordedById String?
  recordedBy   User?       @relation("UnitStatusEventRecorder", fields: [recordedById], references: [id])

  @@index([unitId, effectiveAt])
  @@index([toStatus, effectiveAt])
  @@map("unit_status_events")
}

enum BuildingType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  INDUSTRIAL
  PARKING
  AMENITY
  RETAIL
  OFFICE
  // Raw-land / undeveloped parcel — e.g. Rio Ranch lots (sold by acreage, no units inside).
  // Buildings of type LOT typically have no Unit children; sale/lease attaches to the Building directly.
  LOT
}

// ---- Comments ----

enum CommentType {
  MARKETING
  SALES
  FINANCIAL
}

model ProjectComment {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  content     String
  commentType CommentType @default(MARKETING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("project_comments")
}

model UnitComment {
  id          String      @id @default(cuid())
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  content     String
  commentType CommentType @default(MARKETING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([unitId])
  @@index([userId])
  @@index([createdAt])
  @@map("unit_comments")
}

// ---- Milestones ----

model Milestone {
  id                    String                      @id @default(cuid())
  projectId             String
  project               Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  phase                 String
  dueDate               DateTime
  completedAt           DateTime?
  status                String                      @default("NOT_STARTED")
  // C6 — completion forced past the photo sign-off gate. Sits next to completedAt on
  // purpose: anyone reading "this phase is complete" reads the caveat in the same breath,
  // instead of it being buried in an audit table nobody opens.
  signoffOverrideById   String?
  signoffOverrideBy     User?                       @relation("MilestoneSignoffOverrider", fields: [signoffOverrideById], references: [id], onDelete: SetNull)
  signoffOverrideAt     DateTime?
  signoffOverrideReason String?
  ownerId               String?
  owner                 User?                       @relation("MilestoneOwner", fields: [ownerId], references: [id])
  sortOrder             Int                         @default(0)
  // Dependency: this milestone cannot start until dependsOn is COMPLETED.
  // Cycle prevention is enforced in MilestonesService.setDependency().
  dependsOnId           String?
  dependsOn             Milestone?                  @relation("MilestoneDeps", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents            Milestone[]                 @relation("MilestoneDeps")
  // Link to a draw schedule entry — completing this milestone auto-drafts a DrawRequest.
  linkedDrawScheduleId  String?
  linkedDrawSchedule    DrawSchedule?               @relation(fields: [linkedDrawScheduleId], references: [id])
  photos                MilestonePhoto[]
  // Interior / Fit-Out + Sale Payments
  salePayments          SalePayment[]
  snags                 SnagItem[]
  // C3 — slip review gate. `slipProposals` are the ones THIS milestone's own date move
  // triggered; `slipProposalItems` are every proposal that would move THIS milestone.
  slipProposals         MilestoneSlipProposal[]     @relation("SlipProposalTrigger")
  slipProposalItems     MilestoneSlipProposalItem[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([projectId, phase])
  @@index([dependsOnId])
  @@index([linkedDrawScheduleId])
  @@map("milestones")
}

// Photo evidence for a milestone — attached by PM on-site, surfaced to lender via draw package.
//
// C6 (client decision 2026-08-14): "milestone photos require a sign-off before that phase
// counts as complete". Uploading is evidence; the review is the judgement. A reviewer can
// approve OR reject — a one-way "approve" button would only be a slower upload.
model MilestonePhoto {
  id           String                     @id @default(cuid())
  milestoneId  String
  milestone    Milestone                  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  storagePath  String // Supabase Storage key
  caption      String?
  uploadedById String
  uploadedBy   User                       @relation("MilestonePhotoUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime                   @default(now())
  // ---- Sign-off (C6) ----
  reviewStatus MilestonePhotoReviewStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?                      @relation("MilestonePhotoReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  // Mandatory on REJECTED (DB CHECK + service): a rejection the uploader cannot read is
  // an instruction to re-shoot with no idea what was wrong.
  reviewNote   String?

  @@index([milestoneId])
  // The completion gate's only question: "any photo on this milestone not APPROVED?"
  @@index([milestoneId, reviewStatus])
  @@map("milestone_photos")
}

enum MilestonePhotoReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================================
// C3 / C4 — the PM review gate on a slip cascade.
//
// Client decision 2026-08-14: "PM review the cascade first — when a milestone's due date
// slips, should every dependent milestone's date shift automatically[?] send notification
// to PM and admins also" and "yes — draw date move along with it[,] slipped milestone is
// linked to a lender's draw schedule".
//
// Before this, MilestoneDepsService.propagateSlippage() wrote every dependent's new date
// transitively, immediately, with nobody told and nobody asked. Moving one date silently
// rewrote a whole phase of the schedule — and, once C4 is in, would have moved a date the
// LENDER holds.
//
// Modelled on HistoricalRecordDeletion, the established request/approve shape in this
// codebase: who proposed it, when, what was decided, by whom, and the DB CHECK that a
// decided row must name a decider.
//
// The trigger milestone's OWN due date is written immediately and is not up for review —
// that was the PM's direct edit. What is held is (a) the cascade onto its dependents and
// (b) any linked DrawSchedule.plannedDate, including the trigger's own.
// ============================================================================

model MilestoneSlipProposal {
  id             String                 @id @default(cuid())
  projectId      String
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The milestone whose due date actually moved.
  milestoneId    String
  milestone      Milestone              @relation("SlipProposalTrigger", fields: [milestoneId], references: [id], onDelete: Cascade)
  /// The trigger's own move, recorded so the reviewer sees the cause, not just the effect.
  oldDueDate     DateTime
  newDueDate     DateTime
  /// Whole days. Every shift in `items` is exactly this delta — a cascade is a translation
  /// of the sub-tree, not a re-plan.
  daysSlipped    Int
  /// PENDING | APPROVED | REJECTED | SUPERSEDED | STALE
  ///
  /// SUPERSEDED — the same milestone slipped again while this was pending. Two applyable
  ///              proposals over one sub-tree would double-shift it.
  /// STALE      — approval found the schedule had moved under the proposal. Terminal on
  ///              purpose: see MilestoneDepsService.decideProposal.
  status         String                 @default("PENDING")
  /// Nullable: the gate matters more than the attribution. A date moved by an import or a
  /// future automated path must still raise a reviewable proposal rather than silently
  /// applying, or failing to record itself at all.
  requestedById  String?
  requestedBy    User?                  @relation("SlipProposalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt    DateTime               @default(now())
  /// Null for SUPERSEDED / STALE — those are closed by the system, not by a person. The
  /// CHECK constraint requires a decider only for APPROVED / REJECTED.
  decidedById    String?
  decidedBy      User?                  @relation("SlipProposalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  /// Set for EVERY terminal status, human or system: when it closed is always knowable.
  /// For APPROVED this is also the moment the dates were written — approval applies.
  decidedAt      DateTime?
  decisionNote   String?
  /// The proposal that replaced this one (SUPERSEDED / STALE only).
  supersededById String?                @unique
  supersededBy   MilestoneSlipProposal? @relation("SlipProposalSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     MilestoneSlipProposal? @relation("SlipProposalSupersession")

  items     MilestoneSlipProposalItem[]
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  // Serves "is there already one pending for this milestone?" — the supersession lookup.
  @@index([milestoneId, status])
  // Serves the PM's review queue.
  @@index([projectId, status, requestedAt])
  @@map("milestone_slip_proposals")
}

model MilestoneSlipProposalItem {
  id          String                @id @default(cuid())
  proposalId  String
  proposal    MilestoneSlipProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone   Milestone             @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  /// True for the milestone that was edited. Its due date is already written, so
  /// currentDueDate == proposedDueDate; it appears here only because its linked draw
  /// schedule still has to move, and because the reviewer needs the cause in the list.
  isTrigger   Boolean               @default(false)
  /// Hops from the trigger — 0 for the trigger, 1 for its direct dependents, and so on.
  /// Purely presentational: it lets the UI show the cascade as a tree.
  depth       Int                   @default(0)

  /// The dates AS OBSERVED WHEN THE PROPOSAL WAS COMPUTED. This is the staleness baseline:
  /// approval re-reads the live rows and refuses if either has moved since. Without it,
  /// approving a week-old proposal would silently overwrite whatever happened in between.
  currentDueDate  DateTime
  proposedDueDate DateTime

  /// C4 — the lender's date. Null when this milestone funds no draw.
  drawScheduleId   String?
  drawSchedule     DrawSchedule? @relation(fields: [drawScheduleId], references: [id], onDelete: SetNull)
  currentDrawDate  DateTime?
  proposedDrawDate DateTime?

  // One row per milestone per proposal. A diamond in the dependency graph reaches the
  // same milestone twice; shifting it twice would double the delta.
  @@unique([proposalId, milestoneId])
  @@index([milestoneId])
  @@index([drawScheduleId])
  @@map("milestone_slip_proposal_items")
}

// ---- Financial: Budget, Commitments, Actuals, Forecast ----

model BudgetLine {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Optional building/unit scoping so a project's budget can carry dedicated lines per
  // building or unit (e.g. Building 1 sitework vs Building 2 sitework), not just one
  // project-wide bucket. Mirrors the Loan polymorphic pattern. A line with neither set
  // is a project-level line — the existing/default case. projectId is always populated
  // regardless of scope so project-level rollups (findByProject, getFinancialSummary)
  // keep working unchanged.
  buildingId  String?
  building    Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Free-text category key backed by CustomOption (category="budget_category") — the same
  // system-defaults-plus-org-custom-values pattern already used for project/unit/sale/lead
  // status and phase. Was a hardcoded BudgetCategory enum; converted so orgs can add their
  // own categories (e.g. "TENANT_IMPROVEMENTS") without a schema change. The 10 former enum
  // values are seeded as system defaults in custom-options.service.ts so existing data and
  // QuickBooks sync (which hardcodes category: 'OTHER') keep working unchanged.
  category    String
  description String
  // baselineAmt is the original (revision 1) amount, kept here for fast reads.
  // revisedAmt mirrors the *latest* BudgetRevision.amount for fast reads.
  // Source of truth for history is the BudgetRevision table.
  baselineAmt Decimal   @db.Decimal(14, 2)
  revisedAmt  Decimal?  @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft-delete

  revisions BudgetRevision[]

  @@index([projectId, category])
  @@index([buildingId])
  @@index([unitId])
  @@index([deletedAt])
  @@map("budget_lines")
}

// Each edit to a budget line creates a BudgetRevision. revision #1 is the baseline.
// BudgetLine.revisedAmt always equals the latest revision's amount.
// Append-only: revisions are never updated or deleted.
model BudgetRevision {
  id             String             @id @default(cuid())
  budgetLineId   String
  budgetLine     BudgetLine         @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  revisionNumber Int // 1 = baseline, 2+ = subsequent revisions
  amount         Decimal            @db.Decimal(14, 2)
  reason         String // required free-text justification
  changeReason   BudgetChangeReason
  createdById    String
  createdBy      User               @relation("BudgetRevCreator", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?              @relation("BudgetRevApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())

  @@unique([budgetLineId, revisionNumber])
  @@index([budgetLineId])
  @@map("budget_revisions")
}

enum BudgetChangeReason {
  SCOPE_ADD // we're adding scope
  COST_INCREASE // same scope, vendor raised price
  REALLOCATION // shifted from another category
  ESTIMATE_REFINED // better information now
  CHANGE_ORDER // formal CO from vendor
  OTHER
}

model Commitment {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Optional building/unit scoping — same pattern as BudgetLine/Loan. Neither set = a
  // project-level commitment (existing/default case).
  buildingId   String?
  building     Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId       String?
  unit         Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  vendor       String
  description  String
  contractAmt  Decimal   @db.Decimal(14, 2)
  paidToDate   Decimal   @default(0) @db.Decimal(14, 2)
  retainage    Decimal   @default(0) @db.Decimal(14, 2)
  category     String
  contractDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
  @@index([buildingId])
  @@index([unitId])
  @@map("commitments")
}

model Actual {
  id                String           @id @default(cuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Optional building/unit scoping — same pattern as BudgetLine/Loan/Commitment. Neither
  // set = a project-level actual (existing/default case, including all QuickBooks-synced
  // rows, which have no building/unit concept upstream).
  buildingId        String?
  building          Building?        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId            String?
  unit              Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Interior/TI spend is recorded as an Actual but reported inside the interior module —
  // this tags those rows so the main project's budget/variance/KPI views can exclude them.
  interiorProjectId String?
  interiorProject   InteriorProject? @relation(fields: [interiorProjectId], references: [id], onDelete: SetNull)
  category          String
  description       String
  amount            Decimal          @db.Decimal(14, 2)
  txnDate           DateTime
  vendor            String?
  qbTxnId           String?          @unique // QuickBooks transaction ID
  qbSyncStatus      QBSyncStatus     @default(PENDING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([projectId, category])
  @@index([interiorProjectId])
  @@index([qbTxnId])
  @@index([buildingId])
  @@index([unitId])
  @@map("actuals")
}

enum QBSyncStatus {
  PENDING
  SYNCED
  ERROR
  UNMAPPED
}

// ---- Loans ----

model Loan {
  id              String    @id @default(cuid())
  // Loans attach at either the Project level (portfolio loan covering multiple buildings)
  // or the Building level (per-tower construction loan — see Centro Plaza Bldgs 1 & 2,
  // each with its own closing date, rate, and outstanding balance).
  // Service layer requires at least one of (projectId, buildingId) to be set.
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId      String?
  building        Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId          String?
  unit            Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Free-text key backed by CustomOption (category="loan_type") — same pattern as
  // BudgetLine.category. Was a hardcoded LoanType enum; converted so orgs can add their
  // own types (e.g. "SBA 504") without a schema change. The 5 former enum values are
  // seeded as system defaults in custom-options.service.ts.
  loanType        String
  // lender/principalAmt/interestRate/currentBalance are AES-256-GCM encrypted into
  // `encryptedFields` and the columns are left NULL. They are nullable for exactly
  // that reason — the value lives in the blob, not here. Any read path that surfaces
  // them must call EncryptionService.decryptLoan first.
  lender          String?
  principalAmt    Decimal?  @db.Decimal(14, 2)
  interestRate    Decimal?  @db.Decimal(6, 4)
  termMonths      Int
  maturityDate    DateTime?
  currentBalance  Decimal?  @db.Decimal(14, 2) // encrypted at app level
  monthlyPayment  Decimal?  @db.Decimal(12, 2)
  notes           String?
  encryptedFields String? // JSON blob of encrypted sensitive data
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // soft-delete: required for compliance/audit

  drawRequests  DrawRequest[]
  drawSchedules DrawSchedule[]

  @@index([projectId])
  @@index([buildingId])
  @@index([unitId])
  @@index([deletedAt])
  @@index([maturityDate])
  @@map("loans")
}

model DrawRequest {
  id                  String         @id @default(cuid())
  loanId              String
  loan                Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?       @relation(fields: [projectId], references: [id])
  drawNumber          Int
  amount              Decimal        @db.Decimal(14, 2)
  requestedAmount     Decimal?       @db.Decimal(14, 2)
  approvedAmount      Decimal?       @db.Decimal(14, 2)
  requestDate         DateTime
  approvedAt          DateTime?
  approvedDate        DateTime?
  fundedAt            DateTime?
  status              DrawStatus     @default(DRAFT)
  notes               String?
  rejectionReason     String?
  createdById         String?
  createdBy           User?          @relation("DrawCreator", fields: [createdById], references: [id])
  approvedById        String?
  approvedBy          User?          @relation("DrawApprover", fields: [approvedById], references: [id])
  // Slice 8 additions
  expectedFundingDate DateTime? // PM's best estimate; cron escalates if overshot
  submittedToLenderAt DateTime? // when finance forwarded to construction lender
  approvals           DrawApproval[]
  documents           DrawDocument[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([loanId, drawNumber])
  @@index([projectId])
  @@index([status, expectedFundingDate])
  @@map("draw_requests")
}

enum DrawStatus {
  DRAFT
  SUBMITTED
  APPROVED
  FUNDED
  REJECTED
  CANCELLED
}

// One row per workflow action (approve/reject/return) on a draw.
// Append-only audit trail of the multi-party approval chain.
model DrawApproval {
  id            String             @id @default(cuid())
  drawRequestId String
  drawRequest   DrawRequest        @relation(fields: [drawRequestId], references: [id], onDelete: Cascade)
  step          DrawApprovalStep
  action        DrawApprovalAction
  actorId       String
  actor         User               @relation("DrawApprovalActor", fields: [actorId], references: [id])
  comment       String?
  createdAt     DateTime           @default(now())

  @@index([drawRequestId, step])
  @@map("draw_approvals")
}

enum DrawApprovalStep {
  INTERNAL_FOUNDER // founder sign-off
  INTERNAL_FINANCE // finance review
  LENDER_SUBMITTED // sent to construction lender
  LENDER_FUNDED // lender wired funds
}

enum DrawApprovalAction {
  APPROVED
  REJECTED
  RETURNED_FOR_INFO
}

// Files attached to a draw — lien waivers, inspection reports, etc.
// Drives the "missing documents" red-flag UI.
model DrawDocument {
  id            String      @id @default(cuid())
  drawRequestId String
  drawRequest   DrawRequest @relation(fields: [drawRequestId], references: [id], onDelete: Cascade)
  documentType  DrawDocType
  storagePath   String // Supabase Storage key
  filename      String
  uploadedById  String
  uploadedBy    User        @relation("DrawDocUploader", fields: [uploadedById], references: [id])
  uploadedAt    DateTime    @default(now())

  @@index([drawRequestId, documentType])
  @@map("draw_documents")
}

enum DrawDocType {
  LIEN_WAIVER
  INSPECTION_REPORT
  SWORN_STATEMENT
  VENDOR_INVOICE
  CHANGE_ORDER
  OTHER
}

model DrawSchedule {
  id            String   @id @default(cuid())
  loanId        String
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  drawNumber    Int
  plannedAmount Decimal  @db.Decimal(14, 2)
  plannedDate   DateTime
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  linkedMilestones  Milestone[]
  // C4 — proposed shifts of plannedDate awaiting PM approval. A lender-facing date is
  // never moved outside an approved proposal.
  slipProposalItems MilestoneSlipProposalItem[]

  @@unique([loanId, drawNumber])
  @@index([loanId])
  @@map("draw_schedules")
}

// ---- Sales ----

model Sale {
  id                     String        @id @default(cuid())
  projectId              String
  project                Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Polymorphic asset link — exactly one of (unitId, buildingId) is set.
  // Enforced at the service layer (SalesService.create/update). DB lets both be null
  // to support data migration; queries should always include the populated side.
  unitId                 String?
  unit                   Unit?         @relation(fields: [unitId], references: [id])
  buildingId             String?
  building               Building?     @relation(fields: [buildingId], references: [id])
  buyer                  String?
  // WHO the buyer is relative to the sitting tenancy — the fact from which the close's
  // effect on that tenancy is DERIVED (S4/T1). A boolean `endsLease` was rejected: six
  // months on nobody remembers what `false` meant.
  //
  // Only consequential when the unit has a tenancy in occupation at completion; on a
  // vacant unit both values close identically. Defaults to SITTING_TENANT so every sale
  // written before this field existed keeps exactly the behaviour it had.
  buyerType              SaleBuyerType @default(SITTING_TENANT)
  salePrice              Decimal?      @db.Decimal(14, 2)
  depositAmt             Decimal?      @db.Decimal(14, 2)
  status                 String        @default("PROSPECT")
  loiDate                DateTime?
  contractDate           DateTime?
  closingDate            DateTime?
  notes                  String?
  // Slice 6: Pipeline upgrade
  lastActivityAt         DateTime? // bump on update or comment; powers activity-drought alerts
  expectedCloseDate      DateTime? // for weighted forecast time-bucketing
  lostReason             LostReason? // required when status -> CANCELLED
  lostReasonNote         String?
  // Discount-approval gate: a sale priced below the unit's asking price by more than the
  // org threshold needs Founder/Co-Founder sign-off before it can be committed
  // (UNDER_CONTRACT/CLOSED). Single approval — no dual-approval (client decision).
  discountApprovedById   String?
  discountApprovedBy     User?         @relation("SaleDiscountApprover", fields: [discountApprovedById], references: [id])
  discountApprovedAt     DateTime?
  // Broker attribution + commission (internal-only; brokers have no login).
  // Commission is earned/stamped when the sale CLOSES.
  brokerId               String?
  broker                 Broker?       @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  brokerCommissionPct    Decimal?      @db.Decimal(5, 2) // per-sale override of Broker.commissionRate
  brokerCommissionAmt    Decimal?      @db.Decimal(14, 2) // computed + stored on close
  brokerCommissionPaidAt DateTime? // set when commission is remitted to broker
  // ---- Historical backfill (R4, 2026-08-22) ----
  // Entered by hand after the fact, mirroring Lease.isHistorical. A sale that already
  // closed years ago, typed in from records the system never witnessed — same reasoning,
  // same eventual approval-gate on deletion (R6, not yet built) that Lease already has.
  isHistorical           Boolean       @default(false)
  // Free text — Prime Tracker has no structured owning-entity/LLC model for either side
  // of a deal (buyer already exists; the historical sales sheet also names a seller).
  // Not worth a real relation for v1 — see the import spec's Non-Goals.
  seller                 String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  deletedAt              DateTime? // soft-delete

  convertedLead Lead?

  documents              Document[]
  client                 Client?
  // Sale Payment Schedule (milestone-linked installments) + interior fit-out context
  payments               SalePayment[]
  interiorProjects       InteriorProject[]
  // What became of the money already collected when this sale was cancelled (S1).
  cancellation           SaleCancellation?
  // Every unit this sale has moved between (S3), oldest first.
  unitTransfers          SaleUnitTransfer[]
  commissionInstallments CommissionInstallment[]
  deletionRequests       HistoricalRecordDeletion[]

  @@index([projectId])
  @@index([unitId])
  @@index([buildingId])
  @@index([status, deletedAt])
  @@index([status, lastActivityAt])
  @@index([deletedAt])
  @@index([brokerId])
  @@map("sales")
}

/// Who bought, relative to the tenant sitting in the unit. Decides what closing the sale
/// does to that tenancy (SalesService.update):
///   SITTING_TENANT — the tenancy ENDS at completion, reason TENANT_BOUGHT. The schedule
///                    is capped and future invoices are voided, because there is no longer
///                    anyone to bill: the tenant now owns the place.
///   THIRD_PARTY    — the tenancy SURVIVES. Prime hands it over to the buyer entirely
///                    (client-locked 2026-08-14): billing stops, but the rent schedule and
///                    the invoices are left exactly as they are, because they are now the
///                    new owner's record of a tenant still in occupation.
enum SaleBuyerType {
  SITTING_TENANT
  THIRD_PARTY
}

enum LostReason {
  PRICE_TOO_HIGH
  FINANCING_FELL_THROUGH
  CHOSE_COMPETITOR
  TIMING_OFF
  NO_RESPONSE
  OTHER
}

/// What Prime does with the money already collected on a cancelled sale.
/// DECIDE_LATER is the default and is deliberate — it lets Sales cancel at 6pm without
/// Finance in the room. Without it you get zeros typed in to clear the dialog, which is
/// worse than no data because it looks like a record.
enum SaleCancellationDisposition {
  REFUND // the whole collected amount goes back to the buyer
  FORFEIT // Prime keeps the whole collected amount as a penalty
  NET // split — part refunded, part retained
  DECIDE_LATER // cancelled now, Finance settles the money later
}

/// The outcome of a cancellation — one row per Sale.
///
/// Deliberately a transition record, not columns on Sale. Two loose numbers on the sale
/// have no relationship to the money actually collected and no record of when it moved.
/// Mirrors LeasesService.settleDeposit: this records a DECISION, it does not move money.
/// SalePayment.paidAmount keeps meaning "what was collected" and is never rewritten.
///
/// Deliberately NOT per-installment: Prime refunds a buyer, not an installment. The
/// totalCollected snapshot is what preserves accuracy instead.
model SaleCancellation {
  id              String                      @id @default(cuid())
  saleId          String                      @unique
  sale            Sale                        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cancelledAt     DateTime                    @default(now())
  cancelledById   String?
  cancelledBy     User?                       @relation("SaleCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  /// SNAPSHOT of sum(SalePayment.paidAmount) taken inside the cancelling transaction, so
  /// the ledger cannot drift when someone later edits or re-logs an installment.
  totalCollected  Decimal                     @db.Decimal(14, 2)
  disposition     SaleCancellationDisposition @default(DECIDE_LATER)
  refundAmount    Decimal                     @default(0) @db.Decimal(14, 2)
  penaltyAmount   Decimal                     @default(0) @db.Decimal(14, 2)
  /// When the money ACTUALLY moved — deliberately distinct from cancelledAt, which is
  /// when the decision was made. A decision recorded is not a cheque written.
  refundPaidAt    DateTime?
  refundReference String?
  note            String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([disposition])
  @@index([cancelledAt])
  @@map("sale_cancellations")
}

/// S3 — a buyer switching units mid-contract, after the LOI or the contract is signed.
///
/// Immutable transition row, same shape as LeaseTenantAssignment: the Sale only ever
/// holds the CURRENT unit and the CURRENT price, so without a copy here the fact that
/// the deal started somewhere else is gone. Rewriting `sale.unitId` in place was
/// rejected — it strands the old unit in UNDER_CONTRACT, silently restates every
/// percentOfPrice installment, and launders a discount approval granted against a
/// different asset at a different price.
model SaleUnitTransfer {
  id                 String   @id @default(cuid())
  saleId             String
  sale               Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  fromUnitId         String
  fromUnit           Unit     @relation("SaleUnitTransferFrom", fields: [fromUnitId], references: [id])
  toUnitId           String
  toUnit             Unit     @relation("SaleUnitTransferTo", fields: [toUnitId], references: [id])
  /// When the switch takes effect in the real world — not when it was typed in. Both
  /// occupancy events are dated to this.
  effectiveDate      DateTime
  /// The agreed price on either side of the switch. Snapshotted because the sale row
  /// carries only the current one, and every installment rebase below is derived from
  /// the difference between these two figures.
  priceBefore        Decimal? @db.Decimal(14, 2)
  priceAfter         Decimal? @db.Decimal(14, 2)
  /// The discount off each unit's asking price, as a %. Recorded so the carry-or-clear
  /// decision below is auditable without re-deriving it from asking prices that may
  /// have moved since. Null when a unit carries no asking price.
  discountPctBefore  Decimal? @db.Decimal(6, 2)
  discountPctAfter   Decimal? @db.Decimal(6, 2)
  /// True when this transfer left the sale needing a Founder discount approval it does
  /// not have. A Founder approving 12% off an $800k unit has not approved 12% off a
  /// $1.1M one — the absolute concession is larger — so an INCREASED discount % clears
  /// the approval and re-gates (client-confirmed 2026-08-14).
  approvalReRequired Boolean  @default(false)
  reason             String?
  note               String?
  recordedById       String?
  recordedBy         User?    @relation("SaleUnitTransferRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt         DateTime @default(now())

  @@index([saleId, effectiveDate])
  @@index([fromUnitId])
  @@index([toUnitId])
  @@map("sale_unit_transfers")
}

// ---- Leases ----

model Lease {
  id                     String    @id @default(cuid())
  // Polymorphic asset link — exactly one of (unitId, buildingId) is set.
  // Service-layer enforcement; DB allows both null only during migration.
  unitId                 String?
  unit                   Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  buildingId             String?
  building               Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  // tenantName: legacy field — kept populated for backwards compatibility with existing
  // queries and reporting. New rows should also populate `tenantLegalName` (the LLC /
  // legal entity that signs the lease) and `tenantBrand` (the doing-business-as / brand
  // name that customers see, e.g. "ABC LLC dba Cream Stone").
  tenantName             String
  tenantLegalName        String?
  tenantBrand            String?
  // tenantContact is the contact PERSON's name; email/phone are separate so they can be
  // validated and displayed as links. Note: tenants are never notified by the platform —
  // notifications are strictly internal (they only ever address User rows).
  tenantContact          String?
  tenantEmail            String?
  tenantPhone            String?
  // The CONTRACTED headline rent — deliberately NOT mirrored from the active rent
  // period. Mirroring was the original plan but is wrong: a lease inside a free-rent
  // period has an effective rent of 0, so mirroring would zero this field and the next
  // schedule regeneration would derive a zero schedule from it. What a tenant actually
  // owes in a given month comes from LeaseRentPeriod (see LeasesService.getRentRoll,
  // which returns both the effective and the contracted totals).
  monthlyRent            Decimal   @db.Decimal(12, 2)
  rentPerSqft            Decimal?  @db.Decimal(8, 2)
  // NNN quoted the way it is actually negotiated — a rate per sqft, charged ONCE at
  // lease signing (client-confirmed 2026-08-12). `nnnTotalAmount` is derived from the
  // rate against the unit's area and is overridable for leases quoted as a flat sum.
  //
  // These are the lease's headline TERMS, exactly like `securityDeposit`. The money is
  // tracked as a LeaseObligation of kind NNN, which is what records what was actually
  // collected. NNN was previously a monthly component of rent; see the migration note
  // on 20260812160000_nnn_one_time for why it moved.
  nnnPerSqft             Decimal?  @db.Decimal(8, 2)
  nnnTotalAmount         Decimal?  @db.Decimal(12, 2)
  // Legal commencement — when the lease binds.
  leaseStart             DateTime
  // Rent commencement. Null = rent starts at leaseStart (every lease before this column
  // existed). Distinct because a tenant fitting out for three months owes nothing during
  // it: the schedule and the invoice ledger both begin HERE, not at leaseStart.
  rentStartDate          DateTime?
  // Term expiry — the rent end date.
  leaseEnd               DateTime
  // Derived from (rentStartDate ?? leaseStart) → leaseEnd on write. Was hand-entered and
  // unvalidated, so it could silently disagree with the dates while still driving the
  // effective-rent KPI (summariseEffectiveRent prefers it over what the periods cover).
  termMonths             Int
  escalationPct          Decimal?  @db.Decimal(5, 2)
  escalationFreq         Int? // months between escalations
  securityDeposit        Decimal?  @db.Decimal(12, 2)
  // Agreed tenant-improvement allowance — money Prime owes the TENANT, the one headline
  // term that points outward. Like securityDeposit and nnnTotalAmount this is the TERM;
  // what was actually disbursed lives on the matching LeaseObligation, which is where
  // the phased draw-downs are recorded.
  tiAllowance            Decimal?  @db.Decimal(14, 2)
  // Rent abatement. Free months sit INSIDE the term — leaseEnd is unchanged and the
  // escalation clock still runs from leaseStart, so derived dates never contradict the
  // signed contract. The generator emits these months as isFreeRent periods at rent 0.
  freeRentMonths         Int?
  freeRentStartDate      DateTime?
  // Day of month rent falls due (1-31). Null = the 1st. Per-lease because Prime's
  // leases genuinely differ (5th, 10th); the invoice generator clamps to the last
  // day of short months so a "31st" lease still bills correctly in February.
  rentDueDay             Int?
  status                 String    @default("DRAFT")
  notes                  String?
  // ---- Tenancy transition (T1) ----
  // When occupancy ACTUALLY ended. Null = the lease is running, or ran, to leaseEnd.
  //
  // Deliberately distinct from leaseEnd, which stays the CONTRACTED expiry. The gap
  // between them IS the early-termination exposure, and it is read by things that must
  // not be told a different story: effective-rent straight-lining and
  // brokerCommissionBasis = TOTAL_TERM_RENT are both computed from the signed term.
  // Truncating leaseEnd on an early exit would silently restate a commission someone
  // may already have been paid.
  //
  // The `lease_unit_no_overlap` exclusion constraint ranges over
  // COALESCE(terminationDate, leaseEnd) for the same reason: the unit is free from the
  // move-out date, but the contract still says what it said.
  // Holdover rate as a PERCENTAGE of the last paying rent, for months occupied after
  // leaseEnd. 100 = the same rent, which is the client's answer (2026-08-13).
  //
  // NULL = do not bill holdover on this lease, and it is the default DELIBERATELY. The
  // system cannot tell a genuine holdover from a lease nobody closed — both are ACTIVE,
  // past leaseEnd, with no terminationDate — and invoices are permanent once generated.
  // So the notification fires for every holdover, and billing waits for a person to say
  // so. See migration 20260813190000_holdover_opt_in.
  //
  // A rate rather than a boolean so 125-150% (the commoner commercial practice, charged
  // to discourage overstaying) is later data entry rather than a code change.
  holdoverRatePct        Decimal?  @db.Decimal(6, 2)
  // Entered by hand after the fact (H2 backfill) rather than recorded as it happened.
  // Deleting one of these needs Founder approval — see HistoricalRecordDeletion — because
  // it takes a whole settled ledger with it, and nothing in the system witnessed the
  // tenancy to reconstruct it from.
  isHistorical           Boolean   @default(false)
  // R8 (2026-08-22): a historical deal that spanned more than one physical unit (e.g.
  // "700 and 701" in Prime's own rent-roll sheet — a third of its real historical leases).
  // Deliberately NOT a relation / not full Unit Groups (a separate, heavier roadmap item)
  // — each unit still gets its OWN Lease row with its own correct rent/sqft share; this
  // is purely a free-text link so Unit History can say "leased together with unit X".
  // Never participates in the overlap constraint, rent math, or reporting aggregation.
  combinedDealRef        String?
  // Free text — Prime Tracker has no structured owning-entity/LLC model (mirrors
  // Sale.seller for the same reason: the historical rent-roll sheet names a different
  // landlord LLC per property, e.g. "Texas Hazelwood OP 2 LLC"). Not worth a real
  // relation for v1 — see the import spec's Non-Goals.
  landlordEntity         String?
  terminationDate        DateTime?
  // EXPIRED | NON_RENEWAL | EARLY_TERMINATION | EVICTION | MUTUAL |
  // LANDLORD_TERMINATED | RENEWED | RELOCATED | ASSIGNED | TENANT_BOUGHT
  terminationReason      String?
  terminationNote        String?
  // The lease that CONTINUES this tenancy. Set for a renewal (successor on the same
  // unit) or a relocation (successor on a different unit); null for a genuine turnover
  // where an unrelated tenant follows.
  //
  // Continuity is DERIVED from this plus unitId rather than stored as its own flag —
  // one less pair of fields that can disagree. UnitHistoryService reads it to suppress
  // the phantom vacancy entry between two linked leases.
  //
  // @unique so two leases cannot both claim the same successor. Cycles are rejected in
  // the service, the same way Milestone.dependsOnId is.
  successorLeaseId       String?   @unique
  successorLease         Lease?    @relation("LeaseSuccession", fields: [successorLeaseId], references: [id], onDelete: SetNull)
  predecessorLease       Lease?    @relation("LeaseSuccession")
  // ---- Leasing commission (R23) ----
  // Mirrors the Sale shape rather than inventing a second pattern: same field names,
  // same "stamped when the deal completes" rule (activation here, close there).
  //
  // `brokerCommissionBasis` has no equivalent on Sale because a sale has one obvious
  // base — the price. A lease does not: the fee can be the first month's rent, a
  // percentage of the whole term, or flat, and Prime has not yet said which (Q12). It
  // is therefore recorded PER LEASE rather than assumed, so the answer is data entry
  // and not a code change — and when it is absent nothing is computed, rather than a
  // guess being silently stamped.
  brokerId               String?
  broker                 Broker?   @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  brokerCommissionPct    Decimal?  @db.Decimal(5, 2) // per-lease override of Broker.commissionRate
  brokerCommissionAmt    Decimal?  @db.Decimal(14, 2) // computed + stored on activation
  brokerCommissionBasis  String? // FIRST_MONTH_RENT | TOTAL_TERM_RENT | FLAT
  brokerCommissionPaidAt DateTime? // set when the broker is actually paid
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime? // soft-delete

  interiorProjects       InteriorProject[]
  rentPeriods            LeaseRentPeriod[]
  rentCorrections        LeaseRentPeriodCorrection[]
  obligations            LeaseObligation[]
  rentInvoices           LeaseRentInvoice[]
  tenantAssignments      LeaseTenantAssignment[]
  deletionRequests       HistoricalRecordDeletion[]
  commissionInstallments CommissionInstallment[]

  @@index([unitId])
  @@index([buildingId])
  @@index([status, leaseEnd])
  @@index([deletedAt])
  @@index([terminationDate])
  @@index([combinedDealRef])
  @@index([brokerId])
  @@map("leases")
}

// ============================================================================
// Deletion approval for backfilled history (R27).
//
// Client decision 2026-08-12 (Q2, option b): Sales may create and edit historical
// records; only a Founder may delete one. Modelled on Sale.discountApprovedBy — the
// existing precedent for "this action needs someone senior to agree" — rather than
// inventing a second approval shape.
//
// Why deletion specifically: a backfilled tenancy carries a complete rent ledger that a
// person typed in from records the system never saw. Deleting it destroys data that
// cannot be regenerated, unlike a live lease whose schedule can always be rebuilt from
// its terms.
// ============================================================================

model HistoricalRecordDeletion {
  id            String    @id @default(cuid())
  // Polymorphic (R6, 2026-08-22) — exactly one of (leaseId, saleId), enforced by a DB
  // CHECK. Was lease-only; a backfilled Sale (R4) carries the same "typed in from
  // records nothing can regenerate" risk and needs the same Founder gate.
  leaseId       String?
  lease         Lease?    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  saleId        String?
  sale          Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// PENDING | APPROVED | REJECTED | CANCELLED | COMPLETED
  status        String    @default("PENDING")
  /// Mandatory. Same rule as BudgetRevision: a destructive act with no stated reason is
  /// not auditable.
  reason        String
  requestedById String
  requestedBy   User      @relation("HistoricalDeletionRequester", fields: [requestedById], references: [id])
  requestedAt   DateTime  @default(now())
  decidedById   String?
  decidedBy     User?     @relation("HistoricalDeletionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?

  @@index([leaseId, status])
  @@index([saleId, status])
  @@index([status, requestedAt])
  @@map("historical_record_deletions")
}

// ============================================================================
// Tenant assignment / novation (T1).
//
// The fourth kind of "the unit changed hands", and the only one where the LEASE
// DOCUMENT SURVIVES. The business is sold, or the tenant restructures its entity, and
// a new party steps into the existing contract. The rent periods, the invoice ledger
// and the obligations continue untouched — that is the definition of an assignment,
// and it is why this is not modelled as terminate-and-recreate like the other three.
//
// It needs its own table because otherwise the only record of the change is the audit
// interceptor's `newValues`, which is the WHOLE submitted form body and therefore
// cannot say what changed — the same limitation that forced LeasesService
// .recordLeaseChanges to diff against the stored row.
//
// Without this, editing Lease.tenantName in place silently rewrites history: last
// year's invoices would appear to have been billed to a tenant that did not yet exist.
// This table is what answers "who was the tenant on date X".
// ============================================================================

model LeaseTenantAssignment {
  id                  String    @id @default(cuid())
  leaseId             String
  lease               Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  /// When the assignment takes legal effect — not when it was typed in.
  effectiveDate       DateTime
  /// The outgoing party, snapshotted. Denormalised on purpose: the lease row only ever
  /// holds the CURRENT tenant, so without a copy here the previous name is gone.
  fromTenantName      String
  fromTenantLegalName String?
  toTenantName        String
  toTenantLegalName   String?
  toTenantContact     String?
  toTenantEmail       String?
  toTenantPhone       String?
  /// BUSINESS_SALE | NOVATION | ENTITY_RESTRUCTURE | OTHER
  reason              String?
  note                String?
  /// The executed assignment agreement, if it has been uploaded.
  documentId          String?
  document            Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  recordedById        String?
  recordedBy          User?     @relation("LeaseAssignmentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())

  @@index([leaseId, effectiveDate])
  @@map("lease_tenant_assignments")
}

// ============================================================================
// Lease rent timeline.
//
// One table for what would naively be three: the escalation SCHEDULE, the rent
// HISTORY, and free-rent months. They are the same timeline — an escalation is
// known the day the lease is signed, so "schedule" is just the part after today
// and "history" the part before. Splitting them means storing each rent twice
// and reconciling forever.
//
// Rules (client-confirmed 2026-07-29):
//   - escalation COMPOUNDS: baseRent = previous period's baseRent x (1 + pct)
//   - escalation applies to baseRent ONLY; nnnAmount carries forward untouched
//     and is edited by hand each year
//   - past periods are immutable; edits regenerate FUTURE periods only
//     (append-only, same rule as BudgetRevision)
// ============================================================================

model LeaseRentPeriod {
  id            String    @id @default(cuid())
  leaseId       String
  lease         Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  sequence      Int // 1 = initial term
  startDate     DateTime
  endDate       DateTime? // null = runs to lease end
  baseRent      Decimal   @db.Decimal(12, 2) // the rent portion — this is what escalates
  // NNN portion. Carried forward unchanged across every escalation (client rule,
  // 2026-07-29: "escalation compounds, base rent only — NNN edited manually yearly").
  // Removed 2026-08-12 in favor of a one-time LeaseObligation, then restored 2026-08-21
  // when the client reversed that decision back to a monthly charge. Defaults from
  // lease.nnnTotalAmount / 12 (the quoted $/sqft/yr rate against the unit's area,
  // amortized monthly) when a schedule is generated without an explicit override — see
  // LeaseRentPeriodService.toScheduleInput.
  nnnAmount     Decimal   @default(0) @db.Decimal(12, 2)
  // Invariant enforced in LeaseRentPeriodService: monthlyRent == baseRent + nnnAmount.
  monthlyRent   Decimal   @db.Decimal(12, 2)
  isFreeRent    Boolean   @default(false) // abatement month -> monthlyRent 0
  escalationPct Decimal?  @db.Decimal(5, 2) // pct applied vs the PREVIOUS period
  source        String // INITIAL | AUTO_ESCALATION | MANUAL | FREE_RENT
  reason        String? // required when source = MANUAL
  createdById   String?
  createdBy     User?     @relation("LeaseRentPeriodCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  invoices    LeaseRentInvoice[]
  corrections LeaseRentPeriodCorrection[]

  @@unique([leaseId, sequence])
  @@index([leaseId, startDate])
  @@map("lease_rent_periods")
}

// ============================================================================
// R22 — correcting a rent period that has already been billed.
//
// Past periods are immutable by default (client instruction 2026-07-29): invoices are
// generated against them, so silently editing one changes what a tenant was billed with
// no trace. But "immutable" and "we typed 1,500 when the lease says 1,550" cannot both
// be final, so a correction is a RECORDED ACT rather than an edit — the period moves and
// this row preserves what it moved from, who moved it, and why.
//
// Deliberately not a generic audit row: the audit log records the raw request, while this
// carries the two numbers side by side, which is the only shape Finance can reconcile a
// ledger against.
// ============================================================================
model LeaseRentPeriodCorrection {
  id                 String          @id @default(cuid())
  periodId           String
  period             LeaseRentPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  /// Denormalised so a lease's whole correction history is one query, and so it survives
  /// as context if the period is ever regenerated away.
  leaseId            String
  lease              Lease           @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  /// What it was, and what it became. Both kept — the original value is never lost, which
  /// is the entire justification for allowing the change at all.
  previousRent       Decimal         @db.Decimal(12, 2)
  correctedRent      Decimal         @db.Decimal(12, 2)
  /// Optional: a correction may move the dates rather than the money.
  previousStartDate  DateTime?
  correctedStartDate DateTime?
  previousEndDate    DateTime?
  correctedEndDate   DateTime?
  /// Mandatory. Same rule as BudgetRevision — a change to a billed figure with no stated
  /// reason cannot be reconciled by anyone who was not in the room.
  reason             String
  /// How many already-generated invoices this correction put out of step with the
  /// schedule. Stored rather than recomputed: it is the number that was true at the
  /// moment of the correction, and re-deriving it later gives a different answer.
  invoicesFlagged    Int             @default(0)
  correctedById      String
  correctedBy        User            @relation("LeaseRentPeriodCorrector", fields: [correctedById], references: [id])
  createdAt          DateTime        @default(now())

  @@index([leaseId, createdAt])
  @@index([periodId])
  @@map("lease_rent_period_corrections")
}

// ============================================================================
// Lease obligations — an agreed total paid down by discrete payments.
//
// Security deposit (tenant -> Prime) and TI allowance (Prime -> tenant) are the
// same shape, so they share one model rather than two near-identical services
// and two near-identical UI panels. Mirrors SalePayment on the sales side.
//
//   - deposit: ONE obligation at whatever level the lease sits at (unit or
//     building). Never split across units — roll up for display only.
//   - TI allowance: a fixed agreed amount (NOT a percentage), disbursed in
//     phases as multiple LeaseObligationPayment rows.
// ============================================================================

model LeaseObligation {
  id          String    @id @default(cuid())
  leaseId     String
  lease       Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  kind        String // SECURITY_DEPOSIT | TI_ALLOWANCE | OTHER
  direction   String // FROM_TENANT | TO_TENANT
  totalAmount Decimal   @db.Decimal(14, 2)
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING | PARTIAL | SETTLED | WAIVED
  // Mirror of sum(payments.amount), maintained by the service so list queries
  // don't need an aggregate. pending = totalAmount - paidAmount.
  paidAmount  Decimal   @default(0) @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments LeaseObligationPayment[]

  @@index([leaseId, kind])
  @@index([status, dueDate])
  @@map("lease_obligations")
}

model LeaseObligationPayment {
  id           String          @id @default(cuid())
  obligationId String
  obligation   LeaseObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  amount       Decimal         @db.Decimal(14, 2)
  paidAt       DateTime
  method       String? // WIRE | CHECK | ACH | CASH | ADJUSTMENT
  reference    String? // check no / wire ref
  documentId   String? // receipt in the doc vault
  notes        String?
  recordedById String?
  recordedBy   User?           @relation("LeaseObligationPaymentRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([obligationId])
  @@map("lease_obligation_payments")
}

// ============================================================================
// Monthly rent collection ledger.
//
// LeaseRentPeriod says what a tenant OWES; this says what they PAID. One row per
// month per lease, GENERATED from the covering period — never hand-created, so a
// unit's payment history can have no unexplained gaps. Free-rent months generate
// rows too (amountDue 0, status FREE) for exactly that reason.
//
// The @@unique([leaseId, periodMonth]) makes generation idempotent: the monthly
// cron can re-run safely.
// ============================================================================

model LeaseRentInvoice {
  id           String           @id @default(cuid())
  leaseId      String
  lease        Lease            @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  periodId     String?
  period       LeaseRentPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  /// First day of the billed month (UTC), the natural key alongside leaseId.
  periodMonth  DateTime
  dueDate      DateTime
  amountDue    Decimal          @db.Decimal(12, 2)
  amountPaid   Decimal          @default(0) @db.Decimal(12, 2)
  /// True when the month was billed pro-rata (partial first/last month).
  isProrated   Boolean          @default(false)
  /// Days billed vs days in month — kept so a prorated figure can be explained.
  billedDays   Int?
  monthDays    Int?
  paidAt       DateTime?
  /// DUE | PARTIAL | PAID | FREE | WAIVED | VOID
  ///
  /// VOID is NOT the same as WAIVED and must not be folded into it. WAIVED is a Finance
  /// decision — money that WAS owed and was forgiven, which belongs in concession
  /// reporting. VOID means the tenancy had already ended and the month was never owed
  /// at all. Collapsing the two puts phantom concessions in the numbers.
  status       String           @default("DUE")
  voidReason   String?
  voidedAt     DateTime?
  /// Set when the period this was billed from was corrected AFTER the invoice existed.
  /// Not auto-corrected: the invoice records what was actually billed, and only Finance
  /// can decide whether to re-issue, credit, or leave it. Cleared when they decide.
  needsReview  Boolean          @default(false)
  reviewReason String?
  method       String?
  reference    String?
  notes        String?
  recordedById String?
  recordedBy   User?            @relation("LeaseRentInvoiceRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([leaseId, periodMonth])
  @@index([leaseId, periodMonth])
  @@index([status, dueDate])
  @@map("lease_rent_invoices")
}

// ---- Rent Roll Snapshot ----

model RentRollSnapshot {
  id            String   @id @default(cuid())
  projectId     String
  snapshotDate  DateTime
  totalUnits    Int
  leasedUnits   Int
  occupancyPct  Decimal  @db.Decimal(5, 2)
  grossRent     Decimal  @db.Decimal(14, 2)
  effectiveRent Decimal  @db.Decimal(14, 2)
  data          Json // detailed unit-level breakdown
  createdAt     DateTime @default(now())

  @@unique([projectId, snapshotDate])
  @@map("rent_roll_snapshots")
}

// ---- KPI Snapshot ----

model KpiSnapshot {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshotDate   DateTime
  budgetTotal    Decimal  @db.Decimal(14, 2)
  actualTotal    Decimal  @db.Decimal(14, 2)
  committedTotal Decimal  @db.Decimal(14, 2)
  forecastTotal  Decimal  @db.Decimal(14, 2)
  variance       Decimal  @db.Decimal(14, 2)
  occupancyPct   Decimal? @db.Decimal(5, 2)
  leasedSqft     Int?
  soldUnits      Int?
  data           Json? // extensible KPI data
  createdAt      DateTime @default(now())

  @@unique([projectId, snapshotDate])
  @@index([projectId])
  @@map("kpi_snapshots")
}

// ---- QuickBooks Integration ----

model QBConnection {
  id             String    @id @default(cuid())
  realmId        String    @unique
  accessToken    String // encrypted
  refreshToken   String // encrypted
  tokenExpiresAt DateTime
  companyName    String?
  lastSyncAt     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("qb_connections")
}

model QBProjectMapping {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  qbClassId      String?
  qbClassName    String?
  qbLocationId   String?
  qbLocationName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId])
  @@map("qb_project_mappings")
}

model QBSyncLog {
  id            String    @id @default(cuid())
  syncType      String // VENDORS, ACCOUNTS, BILLS, PAYMENTS, EXPENSES
  status        String // STARTED, COMPLETED, FAILED
  recordsFound  Int       @default(0)
  recordsSynced Int       @default(0)
  errors        Json?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  @@map("qb_sync_logs")
}

// ---- Marketing Leads ----

enum LeadSource {
  WEBSITE
  SOCIAL_MEDIA
  REFERRAL
  COLD_CALL
  WALK_IN
  SIGNAGE
  EMAIL_CAMPAIGN
  BROKER
  LOOPNET
  CREXI
  OTHER
}

enum LeadActivityType {
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  FOLLOW_UP
  NOTE
  STATUS_CHANGE
}

model Lead {
  id                String     @id @default(cuid())
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source            LeadSource
  name              String?
  email             String?
  phone             String?
  notes             String?
  status            String     @default("NEW")
  // Polymorphic asset link — a lead can be interested in a specific Unit OR a
  // whole Building (e.g. an enterprise tenant inquiring about Leander Bldg 1).
  // Service layer enforces "at most one of (unitId, buildingId)" — both can be
  // null for project-level leads with no specific asset yet.
  unitId            String?
  unit              Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  buildingId        String?
  building          Building?  @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unitInterest      String?
  budget            Decimal?   @db.Decimal(14, 2)
  assignedTo        String?
  assignedUser      User?      @relation("LeadAssignee", fields: [assignedTo], references: [id])
  convertedToSaleId String?    @unique
  convertedToSale   Sale?      @relation(fields: [convertedToSaleId], references: [id])
  // Sprint 2 — Campaign attribution:
  //   campaignId — explicit named-campaign tag (e.g. "Spur Plaza Diwali Launch 2026")
  //   utm*       — raw passthrough from the web form / landing-page URL; preserved
  //                even when the campaign cannot be resolved server-side, so the
  //                attribution can be reconstructed later if a Campaign is created
  //                retroactively to match the utmCampaign value.
  campaignId        String?
  campaign          Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  // Broker attribution — which broker brought this lead (internal-only).
  brokerId          String?
  broker            Broker?    @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  createdBy         String
  createdByUser     User       @relation("LeadCreator", fields: [createdBy], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  activities    LeadActivity[]
  documents     Document[]
  // Multi-unit interest: a lead can express interest in several units (and a unit can have
  // a waitlist of interested leads) — in addition to the single primary unit link above.
  unitInterests LeadUnitInterest[]

  @@index([projectId])
  @@index([status])
  @@index([assignedTo])
  @@index([unitId])
  @@index([buildingId])
  @@index([campaignId])
  @@index([brokerId])
  @@map("leads")
}

model LeadUnitInterest {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())

  @@unique([leadId, unitId])
  @@index([unitId])
  @@map("lead_unit_interests")
}

model LeadActivity {
  id            String           @id @default(cuid())
  leadId        String
  lead          Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type          LeadActivityType
  note          String
  createdBy     String
  createdByUser User             @relation("ActivityCreator", fields: [createdBy], references: [id])
  createdAt     DateTime         @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

// ---- Campaigns (Sprint 2: marketing-spend attribution) ----
//
// A Campaign is a named marketing effort (e.g. "Spur Plaza Diwali Launch 2026")
// that runs through one channel (Meta, Google Ads, Newspaper, Broker, …) and may
// or may not be tied to a single project. Spend is tracked through CampaignSpend
// ledger entries — append-only, never overwritten — so reconciliation between
// manual entries, agency reports, and platform APIs stays auditable.

enum CampaignChannel {
  META
  GOOGLE_ADS
  NEWSPAPER
  BROKER
  EMAIL
  SIGNAGE
  EVENT
  OTHER
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignSpendSource {
  MANUAL // entered by Marketing/Founder
  META_API // future Meta Marketing API sync
  GOOGLE_API // future Google Ads API sync
  AGENCY_REPORT // bulk import from agency monthly statement
}

model Campaign {
  id            String          @id @default(cuid())
  name          String
  channel       CampaignChannel
  // External platform ID (Meta Ad Set ID, Google Campaign ID) — used by future
  // API sync to match incoming spend entries back to this campaign.
  externalId    String?
  // Optional pre-allocated planned budget. Real spend lives in CampaignSpend.
  plannedBudget Decimal?        @db.Decimal(14, 2)
  status        CampaignStatus  @default(PLANNED)
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  createdBy     String
  createdByUser User            @relation("CampaignCreator", fields: [createdBy], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime? // soft-delete preserves attribution history

  spend    CampaignSpend[]
  leads    Lead[]
  // Cross-project campaigns (Prime Developers brand campaign) leave this empty;
  // project-specific campaigns populate one row per linked project — a campaign
  // can span 0 (portfolio-wide), 1, or several projects.
  projects CampaignProject[]

  @@index([channel])
  @@index([status])
  @@index([externalId])
  @@index([deletedAt])
  @@map("campaigns")
}

model CampaignProject {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, projectId])
  @@index([campaignId])
  @@index([projectId])
  @@map("campaign_projects")
}

model CampaignSpend {
  id             String              @id @default(cuid())
  campaignId     String
  campaign       Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amount         Decimal             @db.Decimal(14, 2)
  currency       String              @default("USD")
  spentOn        DateTime
  source         CampaignSpendSource
  // Vendor reference — Meta invoice ID, Google line-item ID, agency report row.
  // Used to deduplicate spend entries when the same period is re-imported.
  externalRef    String?
  recordedBy     String
  recordedByUser User                @relation("CampaignSpender", fields: [recordedBy], references: [id])
  createdAt      DateTime            @default(now())

  // Same campaign+source+externalRef must be unique to prevent double-import.
  // External APIs sending the same row twice will hit this constraint.
  @@unique([campaignId, source, externalRef], map: "campaign_spend_dedupe")
  @@index([campaignId])
  @@index([spentOn])
  @@index([source])
  @@map("campaign_spend")
}

// ---- Notifications ----

enum NotificationType {
  MILESTONE_OVERDUE
  LEASE_EXPIRING_30
  LEASE_EXPIRING_7
  LOAN_MATURITY_60
  COMMENT_FINANCIAL
  COMMENT_SALES
  COMMENT_MARKETING
  DRAW_REQUEST_SUBMITTED
  DRAW_REQUEST_APPROVED
  DRAW_REQUEST_FUNDED
  BUDGET_VARIANCE
  LEAD_ASSIGNED
  LEAD_STATUS_CHANGED
  // Interior fit-out + sale-payment schedule triggers
  INTERIOR_PHASE_CHANGED
  INTERIOR_HANDOVER_DUE
  SNAG_OVERDUE
  PAYMENT_DUE_7
  PAYMENT_OVERDUE
  // Draw past its expectedFundingDate. Previously these alerts were filed under
  // BUDGET_VARIANCE, which meant muting budget alerts also muted funding alerts.
  DRAW_FUNDING_OVERDUE
  // Leasing depth triggers. These must stay in sync with
  // migrations/20260729120000_add_notification_types_l3 — a value present in the DB
  // but missing here is invisible to Object.values(NotificationType), which means it
  // never appears in getPreferences() and users cannot mute it.
  UNIT_SOLD
  LEASE_ADDED
  LEASE_ACTIVATED
  LEASE_TERMINATED
  LEASE_RENT_CHANGED
  FREE_RENT_ENDING_30
  DEPOSIT_OUTSTANDING
  TI_DISBURSED
  RENT_OVERDUE
  // Someone was @mentioned by name in a comment. Distinct from COMMENT_* (which routes
  // by department) because it is addressed at one person, so it is ACTION-tier and
  // reaches them whether or not they follow that comment's department.
  COMMENT_MENTION
  /// A work item was assigned to you. ACTION-tier like COMMENT_MENTION: it names one
  /// person and asks them to do something, so it is not filed under a department feed.
  /// Assigning work told nobody at all before this existed.
  TASK_ASSIGNED
  /// Somebody asked to delete a backfilled tenancy (R27). Leadership-routed: the whole
  /// point of the gate is that a second person looks before history is erased.
  HISTORY_DELETION_REQUESTED
  /// The decision came back. Addressed at the person who raised the request — a request
  /// that is silently approved or rejected is the same as no answer at all.
  HISTORY_DELETION_DECIDED
  /// A tenant is occupying past their contracted end with no move-out recorded.
  /// Leadership-routed at the client's request (2026-08-13) because it is a commercial
  /// decision — renew, end it, or let it run — not a task for whoever is on the unit.
  LEASE_HOLDOVER
  /// D2 — a document with an expiry date is approaching it (60 / 30 / 7 day horizons).
  /// FYI-tier: in-app on every horizon, but it does not email three times per permit
  /// across a whole portfolio. Escalates into DOCUMENT_EXPIRED, which does email.
  DOCUMENT_EXPIRING
  /// D2 — the date has PASSED and the document is still on file. A separate type, not the
  /// same one escalating, so that muting the early warnings can never mute the lapse.
  DOCUMENT_EXPIRED
  /// C3/C4 — a milestone slipped and the cascade onto its dependents (plus any lender
  /// draw dates) is waiting for a PM to approve or reject. Routed to the project's PM
  /// plus leadership; ACTION-tier because the schedule is frozen mid-move until somebody
  /// decides.
  MILESTONE_SLIP_PENDING_REVIEW
  /// Global Update Board (Phase 2). A new post went up. FYI-tier by design — it is a
  /// broadcast to every internal user, not a request addressed at one person, and
  /// emailing the whole company on every post is the "filter the sender to a folder"
  /// failure the tier system exists to prevent.
  UPDATE_BOARD_POSTED
  /// Someone was @mentioned in an Update Board chat reply. Distinct from COMMENT_MENTION
  /// (which is Task/Unit/Project comments) so muting one board's mentions does not mute
  /// the other's — but reuses the same resolveMentions() parser, not a second one.
  UPDATE_BOARD_COMMENT_MENTION
  /// Someone was tagged on an Update Board post. ACTION-tier like TASK_ASSIGNED: it names
  /// one person and asks them to look at something.
  UPDATE_BOARD_ASSIGNED
  /// An Update Board post's due date is approaching or has passed. RECURRING — the daily
  /// cron re-raises it for as long as the post stays open and undone.
  UPDATE_BOARD_DUE_SOON
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  /// Stable identity of the CONDITION this alert is about, e.g. "invoice:<id>".
  ///
  /// Recurring alerts are re-raised by the daily cron for as long as the condition
  /// holds, and are suppressed while the recipient already has that alert pending. The
  /// suppression originally keyed on `title`, which silently did nothing for the seven
  /// types whose title carries a live day counter ("Rent overdue (29d): …" becomes
  /// "(30d)" tomorrow) — that is 2,150 of the 2,288 rows in the first backlog. The key
  /// has to be something that does NOT change as the condition ages.
  ///
  /// Null for one-off events, which are never deduplicated.
  dedupeKey String?

  @@index([userId, readAt])
  @@index([createdAt])
  // Serves the suppression lookup: userId IN (…) AND type = … AND dedupeKey = …
  @@index([userId, type, dedupeKey])
  @@map("notifications")
}

model NotificationPreference {
  id           String           @id @default(cuid())
  // emailEnabled is NULLABLE on purpose: null means "use this notification type's
  // tier default" (action-needed types email, FYI types are in-app only). An
  // explicit true/false is a deliberate per-user override in either direction.
  emailEnabled Boolean?
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  enabled      Boolean          @default(true)

  @@unique([userId, type])
  @@map("notification_preferences")
}

