// =============================================
// Prime Tracker — Prisma Schema
// Single-tenant now, multi-tenant ready (tenantId fields commented)
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth & RBAC ----

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  avatarUrl     String?
  googleId      String?   @unique
  role          UserRole  @default(VIEWER)
  isActive      Boolean   @default(true)
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?   // encrypted TOTP secret
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // tenantId   String?   // future multi-tenant

  milestones              Milestone[]        @relation("MilestoneOwner")
  auditEvents             AuditEvent[]
  sessions                RefreshToken[]
  unitComments            UnitComment[]
  projectComments         ProjectComment[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  assignedLeads           Lead[]             @relation("LeadAssignee")
  createdLeads            Lead[]             @relation("LeadCreator")
  leadActivities          LeadActivity[]     @relation("ActivityCreator")
  drawRequests            DrawRequest[]      @relation("DrawCreator")
  approvedDraws           DrawRequest[]      @relation("DrawApprover")
  uploadedDocuments       Document[]         @relation("DocumentUploader")
  assignedTasks           Task[]             @relation("TaskAssignee")
  createdTasks            Task[]             @relation("TaskCreator")
  taskComments            TaskComment[]
  taskAttachments         TaskAttachment[]   @relation("TaskAttachmentUploader")
  orgMemberships          OrgMembership[]    @relation("OrgMember")
  managedMembers          OrgMembership[]    @relation("ManagedBy")
  projectMemberships      ProjectMember[]

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

enum UserRole {
  SUPER_ADMIN
  FOUNDER
  EXECUTIVE
  FINANCE
  ACCOUNTING
  AR_AP
  PROJECT_MANAGER
  CONSTRUCTION
  SALES
  MARKETING
  LEGAL
  VIEWER
}

enum OrgRole {
  LEAD
  EMPLOYEE
}

// ---- Organizations ----

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  entityType  String?  // LLC, LP, Corp
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships OrgMembership[]
  projects    Project[]

  @@map("organizations")
}

model OrgMembership {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("OrgMember", fields: [userId], references: [id], onDelete: Cascade)
  orgRole   OrgRole  @default(EMPLOYEE)
  reportsTo String?
  manager   User?    @relation("ManagedBy", fields: [reportsTo], references: [id])
  joinedAt  DateTime @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
  @@map("org_memberships")
}

// ---- Projects ----

model Project {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  location     String
  address      String?
  acreage      Decimal?      @db.Decimal(10, 3)
  status       ProjectStatus @default(ACTIVE)
  phase        ProjectPhase  @default(PRE_DEVELOPMENT)
  projectType  ProjectType?
  description  String?
  startDate    DateTime?
  targetEnd    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  // tenantId  String?
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id])

  buildings      Building[]
  milestones     Milestone[]
  budgetLines    BudgetLine[]
  commitments    Commitment[]
  actuals        Actual[]
  loans          Loan[]
  sales          Sale[]
  kpiSnapshots   KpiSnapshot[]
  qbMappings     QBProjectMapping[]
  comments       ProjectComment[]
  leads          Lead[]
  drawRequests   DrawRequest[]
  cashFlowEntries CashFlowEntry[]
  contracts      Contract[]
  documents      Document[]
  equityPositions EquityPosition[]
  capitalCalls   CapitalCall[]
  distributions  Distribution[]
  tasks          Task[]
  members        ProjectMember[]

  @@index([orgId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("TEAM_MEMBER")
  addedAt   DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@map("project_members")
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPhase {
  PRE_DEVELOPMENT
  PERMITTING
  CONSTRUCTION
  LEASE_UP
  STABILIZED
  SOLD_REFI
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  INDUSTRIAL
}

// ---- Buildings & Units ----

model Building {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  totalSqft    Int?
  stories      Int?
  buildingType BuildingType?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  units       Unit[]
  tasks       Task[]

  @@index([projectId])
  @@map("buildings")
}

model Unit {
  id          String     @id @default(cuid())
  buildingId  String
  building    Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitNumber  String
  unitType    UnitType
  sqft        Int?
  status      UnitStatus @default(AVAILABLE)
  askingRent  Decimal?   @db.Decimal(12, 2) // per sqft/month
  askingPrice Decimal?   @db.Decimal(14, 2) // for sale units
  primeOwned  Boolean    @default(false)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  leases      Lease[]
  sales       Sale[]
  comments    UnitComment[]
  loans       Loan[]
  documents   Document[]
  tasks       Task[]

  @@unique([buildingId, unitNumber])
  @@index([buildingId])
  @@map("units")
}

enum BuildingType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  INDUSTRIAL
  PARKING
  AMENITY
  RETAIL
  OFFICE
}

enum UnitType {
  RETAIL
  MEDICAL
  FLEX
  RESIDENTIAL_LOT
  OFFICE
  RESTAURANT
  EVENT_CENTER
}

enum UnitStatus {
  AVAILABLE
  UNDER_CONTRACT
  LEASED
  SOLD
  OCCUPIED
  UNDER_CONSTRUCTION
}

// ---- Comments ----

enum CommentType {
  MARKETING
  SALES
  FINANCIAL
}

model ProjectComment {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  content     String
  commentType CommentType @default(MARKETING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("project_comments")
}

model UnitComment {
  id          String      @id @default(cuid())
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  content     String
  commentType CommentType @default(MARKETING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([unitId])
  @@index([userId])
  @@index([createdAt])
  @@map("unit_comments")
}

// ---- Milestones ----

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  phase       ProjectPhase
  dueDate     DateTime
  completedAt DateTime?
  status      MilestoneStatus @default(NOT_STARTED)
  ownerId     String?
  owner       User?           @relation("MilestoneOwner", fields: [ownerId], references: [id])
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, phase])
  @@map("milestones")
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  BLOCKED
}

// ---- Financial: Budget, Commitments, Actuals, Forecast ----

model BudgetLine {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    BudgetCategory
  description String
  baselineAmt Decimal        @db.Decimal(14, 2)
  revisedAmt  Decimal?       @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId, category])
  @@map("budget_lines")
}

enum BudgetCategory {
  LAND_ACQUISITION
  SITE_WORK
  HARD_COSTS
  SOFT_COSTS
  FINANCING
  PERMITS_FEES
  CONTINGENCY
  MARKETING
  LEGAL
  OTHER
}

model Commitment {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor       String
  description  String
  contractAmt  Decimal  @db.Decimal(14, 2)
  paidToDate   Decimal  @default(0) @db.Decimal(14, 2)
  retainage    Decimal  @default(0) @db.Decimal(14, 2)
  category     BudgetCategory
  contractDate DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
  @@map("commitments")
}

model Actual {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      BudgetCategory
  description   String
  amount        Decimal      @db.Decimal(14, 2)
  txnDate       DateTime
  vendor        String?
  qbTxnId       String?      @unique // QuickBooks transaction ID
  qbSyncStatus  QBSyncStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId, category])
  @@index([qbTxnId])
  @@map("actuals")
}

enum QBSyncStatus {
  PENDING
  SYNCED
  ERROR
  UNMAPPED
}

// ---- Loans ----

model Loan {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId          String?
  unit            Unit?     @relation(fields: [unitId], references: [id])
  loanType        LoanType
  lender          String    // encrypted
  principalAmt    Decimal   @db.Decimal(14, 2) // encrypted at app level
  interestRate    Decimal   @db.Decimal(6, 4)  // encrypted at app level
  termMonths      Int
  maturityDate    DateTime?
  currentBalance  Decimal?  @db.Decimal(14, 2) // encrypted at app level
  monthlyPayment  Decimal?  @db.Decimal(12, 2)
  notes           String?
  encryptedFields String?   // JSON blob of encrypted sensitive data
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  drawRequests    DrawRequest[]
  drawSchedules   DrawSchedule[]

  @@index([projectId])
  @@index([unitId])
  @@map("loans")
}

enum LoanType {
  CONSTRUCTION
  PERMANENT
  BRIDGE
  MEZZANINE
  SBA
}

model DrawRequest {
  id              String     @id @default(cuid())
  loanId          String
  loan            Loan       @relation(fields: [loanId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?   @relation(fields: [projectId], references: [id])
  drawNumber      Int
  amount          Decimal    @db.Decimal(14, 2)
  requestedAmount Decimal?   @db.Decimal(14, 2)
  approvedAmount  Decimal?   @db.Decimal(14, 2)
  requestDate     DateTime
  approvedAt      DateTime?
  approvedDate    DateTime?
  fundedAt        DateTime?
  status          DrawStatus @default(DRAFT)
  notes           String?
  rejectionReason String?
  createdById     String?
  createdBy       User?      @relation("DrawCreator", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?      @relation("DrawApprover", fields: [approvedById], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([loanId, drawNumber])
  @@index([projectId])
  @@map("draw_requests")
}

enum DrawStatus {
  DRAFT
  SUBMITTED
  APPROVED
  FUNDED
  REJECTED
}

model DrawSchedule {
  id            String   @id @default(cuid())
  loanId        String
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  drawNumber    Int
  plannedAmount Decimal  @db.Decimal(14, 2)
  plannedDate   DateTime
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([loanId, drawNumber])
  @@index([loanId])
  @@map("draw_schedules")
}

// ---- Sales ----

model Sale {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit       @relation(fields: [unitId], references: [id])
  buyer        String?
  salePrice    Decimal?   @db.Decimal(14, 2)
  depositAmt   Decimal?   @db.Decimal(14, 2)
  status       SaleStatus @default(PROSPECT)
  loiDate      DateTime?
  contractDate DateTime?
  closingDate  DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  convertedLead Lead?

  @@index([projectId])
  @@index([unitId])
  @@map("sales")
}

enum SaleStatus {
  PROSPECT
  LOI_SIGNED
  UNDER_CONTRACT
  CLOSED
  CANCELLED
}

// ---- Leases ----

model Lease {
  id             String      @id @default(cuid())
  unitId         String
  unit           Unit        @relation(fields: [unitId], references: [id])
  tenantName     String
  tenantContact  String?
  monthlyRent    Decimal     @db.Decimal(12, 2)
  rentPerSqft    Decimal?    @db.Decimal(8, 2)
  leaseStart     DateTime
  leaseEnd       DateTime
  termMonths     Int
  escalationPct  Decimal?    @db.Decimal(5, 2)
  escalationFreq Int?        // months between escalations
  securityDeposit Decimal?   @db.Decimal(12, 2)
  status         LeaseStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([unitId])
  @@map("leases")
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

// ---- Rent Roll Snapshot ----

model RentRollSnapshot {
  id           String   @id @default(cuid())
  projectId    String
  snapshotDate DateTime
  totalUnits   Int
  leasedUnits  Int
  occupancyPct Decimal  @db.Decimal(5, 2)
  grossRent    Decimal  @db.Decimal(14, 2)
  effectiveRent Decimal @db.Decimal(14, 2)
  data         Json     // detailed unit-level breakdown
  createdAt    DateTime @default(now())

  @@unique([projectId, snapshotDate])
  @@map("rent_roll_snapshots")
}

// ---- KPI Snapshot ----

model KpiSnapshot {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshotDate    DateTime
  budgetTotal     Decimal  @db.Decimal(14, 2)
  actualTotal     Decimal  @db.Decimal(14, 2)
  committedTotal  Decimal  @db.Decimal(14, 2)
  forecastTotal   Decimal  @db.Decimal(14, 2)
  variance        Decimal  @db.Decimal(14, 2)
  occupancyPct    Decimal? @db.Decimal(5, 2)
  leasedSqft      Int?
  soldUnits       Int?
  data            Json?    // extensible KPI data
  createdAt       DateTime @default(now())

  @@unique([projectId, snapshotDate])
  @@index([projectId])
  @@map("kpi_snapshots")
}

// ---- QuickBooks Integration ----

model QBConnection {
  id              String   @id @default(cuid())
  realmId         String   @unique
  accessToken     String   // encrypted
  refreshToken    String   // encrypted
  tokenExpiresAt  DateTime
  companyName     String?
  lastSyncAt      DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("qb_connections")
}

model QBProjectMapping {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  qbClassId   String?
  qbClassName String?
  qbLocationId String?
  qbLocationName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId])
  @@map("qb_project_mappings")
}

model QBSyncLog {
  id           String   @id @default(cuid())
  syncType     String   // VENDORS, ACCOUNTS, BILLS, PAYMENTS, EXPENSES
  status       String   // STARTED, COMPLETED, FAILED
  recordsFound Int      @default(0)
  recordsSynced Int     @default(0)
  errors       Json?
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  @@map("qb_sync_logs")
}

// ---- Marketing Leads ----

enum LeadSource {
  WEBSITE
  SOCIAL_MEDIA
  REFERRAL
  COLD_CALL
  WALK_IN
  SIGNAGE
  EMAIL_CAMPAIGN
  BROKER
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATING
  CONVERTED
  LOST
  DEAD
}

enum LeadActivityType {
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  FOLLOW_UP
  NOTE
  STATUS_CHANGE
}

model Lead {
  id                String      @id @default(cuid())
  projectId         String
  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source            LeadSource
  name              String?
  email             String?
  phone             String?
  notes             String?
  status            LeadStatus  @default(NEW)
  unitInterest      String?
  budget            Decimal?    @db.Decimal(14, 2)
  assignedTo        String?
  assignedUser      User?       @relation("LeadAssignee", fields: [assignedTo], references: [id])
  convertedToSaleId String?     @unique
  convertedToSale   Sale?       @relation(fields: [convertedToSaleId], references: [id])
  createdBy         String
  createdByUser     User        @relation("LeadCreator", fields: [createdBy], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  activities        LeadActivity[]

  @@index([projectId])
  @@index([status])
  @@index([assignedTo])
  @@map("leads")
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadActivityType
  note      String
  createdBy String
  createdByUser User         @relation("ActivityCreator", fields: [createdBy], references: [id])
  createdAt DateTime         @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

// ---- Notifications ----

enum NotificationType {
  MILESTONE_OVERDUE
  LEASE_EXPIRING_30
  LEASE_EXPIRING_7
  LOAN_MATURITY_60
  COMMENT_FINANCIAL
  COMMENT_SALES
  COMMENT_MARKETING
  DRAW_REQUEST_APPROVED
  DRAW_REQUEST_FUNDED
  BUDGET_VARIANCE
  LEAD_ASSIGNED
  LEAD_STATUS_CHANGED
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  link       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  enabled Boolean          @default(true)

  @@unique([userId, type])
  @@map("notification_preferences")
}

// ---- Cash Flow ----

enum CashFlowType {
  INFLOW
  OUTFLOW
}

model CashFlowEntry {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  month     DateTime
  entryType CashFlowType
  category  String
  amount    Float
  isActual  Boolean      @default(true)
  notes     String?
  createdAt DateTime     @default(now())

  @@index([projectId, month])
  @@map("cash_flow_entries")
}

// ---- Vendors & Contracts ----

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  TERMINATED
}

enum ChangeOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

model Vendor {
  id          String     @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  trade       String?
  contracts   Contract[]
  createdAt   DateTime   @default(now())

  @@map("vendors")
}

model Contract {
  id             String         @id @default(cuid())
  projectId      String
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor         @relation(fields: [vendorId], references: [id])
  description    String
  originalAmount Float
  currentAmount  Float
  status         ContractStatus @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  changeOrders   ChangeOrder[]
  payments       ContractPayment[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([projectId])
  @@map("contracts")
}

model ChangeOrder {
  id          String            @id @default(cuid())
  contractId  String
  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number      Int
  description String
  amount      Float
  status      ChangeOrderStatus @default(PENDING)
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@map("change_orders")
}

model ContractPayment {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  amount     Float
  paidDate   DateTime
  notes      String?
  createdAt  DateTime @default(now())

  @@map("contract_payments")
}

// ---- Documents ----

enum DocCategory {
  GENERAL
  PERMIT
  CONTRACT
  FINANCIAL
  DRAWING
  PHOTO
  LEGAL
}

model Document {
  id           String      @id @default(cuid())
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId       String?
  unit         Unit?       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  category     DocCategory @default(GENERAL)
  uploadedById String
  uploadedBy   User        @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([projectId])
  @@index([unitId])
  @@map("documents")
}

// ---- Investors ----

enum CapitalCallStatus {
  PENDING
  PAID
  OVERDUE
}

model Investor {
  id           String           @id @default(cuid())
  name         String
  email        String?          @unique
  phone        String?
  entityName   String?
  positions    EquityPosition[]
  capitalCalls CapitalCall[]
  distributions Distribution[]
  createdAt    DateTime         @default(now())

  @@map("investors")
}

model EquityPosition {
  id           String   @id @default(cuid())
  investorId   String
  investor     Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pctOwnership Float
  committedAmt Float
  calledAmt    Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([investorId])
  @@index([projectId])
  @@map("equity_positions")
}

model CapitalCall {
  id         String            @id @default(cuid())
  investorId String
  investor   Investor          @relation(fields: [investorId], references: [id])
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id])
  amount     Float
  dueDate    DateTime
  paidDate   DateTime?
  status     CapitalCallStatus @default(PENDING)
  notes      String?
  createdAt  DateTime          @default(now())

  @@index([investorId])
  @@index([projectId])
  @@map("capital_calls")
}

model Distribution {
  id         String   @id @default(cuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id])
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  amount     Float
  distDate   DateTime
  distType   String
  notes      String?
  createdAt  DateTime @default(now())

  @@index([investorId])
  @@index([projectId])
  @@map("distributions")
}

// ---- Audit Log (Immutable) ----

model AuditEvent {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity      String   // table/model name
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  // No updatedAt — immutable by design
  // No delete cascade — audit events are never deleted

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

// ---- Tasks ----

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId   String?
  building     Building?    @relation(fields: [buildingId], references: [id])
  unitId       String?
  unit         Unit?        @relation(fields: [unitId], references: [id])
  title        String
  description  String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  assignedTo   String?
  assignedUser User?        @relation("TaskAssignee", fields: [assignedTo], references: [id])
  createdBy    String
  createdByUser User        @relation("TaskCreator", fields: [createdBy], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  comments     TaskComment[]
  attachments  TaskAttachment[]

  @@index([projectId])
  @@index([assignedTo])
  @@index([status])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  uploadedById String
  uploadedBy   User     @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

