// =============================================
// Prime Tracker — Prisma Schema
// Single-tenant now, multi-tenant ready (tenantId fields commented)
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- Auth & RBAC ----

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  avatarUrl    String?
  googleId     String?   @unique
  role         UserRole  @default(VIEWER)
  roles        UserRole[]
  isActive     Boolean   @default(true)
  passwordHash String?
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String? // encrypted TOTP secret
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // tenantId   String?   // future multi-tenant

  milestones              Milestone[]              @relation("MilestoneOwner")
  auditEvents             AuditEvent[]
  sessions                RefreshToken[]
  unitComments            UnitComment[]
  projectComments         ProjectComment[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  assignedLeads           Lead[]                   @relation("LeadAssignee")
  createdLeads            Lead[]                   @relation("LeadCreator")
  leadActivities          LeadActivity[]           @relation("ActivityCreator")
  drawRequests            DrawRequest[]            @relation("DrawCreator")
  approvedDraws           DrawRequest[]            @relation("DrawApprover")
  uploadedDocuments       Document[]               @relation("DocumentUploader")
  assignedTasks           Task[]                   @relation("TaskAssignee")
  createdTasks            Task[]                   @relation("TaskCreator")
  taskComments            TaskComment[]
  taskAttachments         TaskAttachment[]         @relation("TaskAttachmentUploader")
  orgMemberships          OrgMembership[]          @relation("OrgMember")
  managedMembers          OrgMembership[]          @relation("ManagedBy")
  projectMemberships      ProjectMember[]
  // New relations from Slices 1, 5, 7, 8
  milestonePhotos         MilestonePhoto[]         @relation("MilestonePhotoUploader")
  budgetRevisionsCreated  BudgetRevision[]         @relation("BudgetRevCreator")
  budgetRevisionsApproved BudgetRevision[]         @relation("BudgetRevApprover")
  drawApprovals           DrawApproval[]           @relation("DrawApprovalActor")
  drawDocuments           DrawDocument[]           @relation("DrawDocUploader")
  // Document Vault Phase 1
  uploadedDocVersions     DocumentVersion[]        @relation("VersionUploader")
  // Document Vault Phase 2 — buyer portal
  clientProfile           Client?                  @relation("ClientUser")
  // Sprint 2 — Campaign attribution
  campaignsCreated        Campaign[]               @relation("CampaignCreator")
  campaignSpendRecorded   CampaignSpend[]          @relation("CampaignSpender")
  // Interior / Fit-Out + Sale Payments
  interiorProjects        InteriorProject[]        @relation("InteriorPM")
  snagItems               SnagItem[]               @relation("SnagAssignee")
  discountApprovedSales   Sale[]                   @relation("SaleDiscountApprover")
  dailyLogs               DailyLog[]               @relation("DailyLogAuthor")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

enum UserRole {
  SUPER_ADMIN
  FOUNDER
  EXECUTIVE
  FINANCE
  ACCOUNTING
  AR_AP
  PROJECT_MANAGER
  CONSTRUCTION
  SALES
  MARKETING
  LEGAL
  VIEWER
  // Buyer portal role (Phase 2 of Document Vault rollout) — sees only their own unit
  CLIENT
}

enum OrgRole {
  LEAD
  EMPLOYEE
}

// ---- Organizations ----

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  entityType  String? // LLC, LP, Corp
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships OrgMembership[]
  projects    Project[]
  settings    OrgSettings?

  @@map("organizations")
}

model OrgMembership {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("OrgMember", fields: [userId], references: [id], onDelete: Cascade)
  orgRole   OrgRole      @default(EMPLOYEE)
  reportsTo String?
  manager   User?        @relation("ManagedBy", fields: [reportsTo], references: [id])
  joinedAt  DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
  @@map("org_memberships")
}

// ---- Projects ----

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  location    String
  address     String?
  acreage     Decimal?      @db.Decimal(10, 3)
  // Top-down "control total" approved by Finance/Founder. Detailed budget lines are
  // tracked bottom-up against this; the Approved-vs-Planned gap is a key signal.
  approvedBudget Decimal?   @db.Decimal(14, 2)
  status      String  @default("ACTIVE")
  phase       String  @default("PRE_DEVELOPMENT")
  projectType ProjectType?
  description String?
  startDate   DateTime?
  targetEnd   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime? // soft-delete: archived rows excluded from default reads
  // tenantId  String?
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id])

  buildings       Building[]
  milestones      Milestone[]
  budgetLines     BudgetLine[]
  commitments     Commitment[]
  actuals         Actual[]
  loans           Loan[]
  sales           Sale[]
  kpiSnapshots    KpiSnapshot[]
  qbMappings      QBProjectMapping[]
  comments        ProjectComment[]
  leads           Lead[]
  drawRequests    DrawRequest[]
  cashFlowEntries CashFlowEntry[]
  contracts       Contract[]
  documents       Document[]
  equityPositions EquityPosition[]
  capitalCalls    CapitalCall[]
  distributions   Distribution[]
  tasks           Task[]
  members         ProjectMember[]
  clients         Client[]
  campaignProjects CampaignProject[]
  dailyLogs       DailyLog[]

  @@index([orgId])
  @@index([status, phase])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("TEAM_MEMBER")
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@map("project_members")
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  INDUSTRIAL
}

// ---- Buildings & Units ----

model Building {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  totalSqft      Int?
  // For LOT-type buildings (raw parcels — see BuildingType.LOT), size is expressed
  // in acres rather than square feet. Stored as Decimal(10,3) to support fractional
  // acreage (e.g. 1.27, 8.0, 11.98 from the Rio Ranch lots).
  acreage        Decimal?      @db.Decimal(10, 3)
  stories        Int?
  buildingType   BuildingType?
  // Building-level phase: a project may have Building A in CONSTRUCTION and Building B in LEASE_UP.
  // Project.phase is computed = max(buildings.phase) — see ProjectPhaseService.
  phase          String  @default("PRE_DEVELOPMENT")
  coverPhotoPath String? // optional cover photo (Supabase storage path)
  sortOrder      Int           @default(0) // manual display order within a project (drag-to-reorder)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime? // soft-delete

  units            Unit[]
  tasks            Task[]
  documents        Document[]
  // Polymorphic back-relations: Sale/Lease/Lead/Loan can attach to a Building directly
  // (e.g. Leander Building 1 leased as one whole asset to "22 Yards Austin") in addition to
  // attaching to a specific Unit. Service-level validation ensures exactly one of
  // (buildingId, unitId) is set per row — see Sprint 1 docs.
  sales            Sale[]
  leases           Lease[]
  leads            Lead[]
  loans            Loan[]
  budgetLines      BudgetLine[]
  commitments      Commitment[]
  actuals          Actual[]
  interiorProjects InteriorProject[]
  dailyLogs        DailyLog[]

  @@index([projectId])
  @@index([projectId, sortOrder])
  @@index([phase])
  @@index([deletedAt])
  @@map("buildings")
}

model Unit {
  id             String     @id @default(cuid())
  buildingId     String
  building       Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitNumber     String
  // Free-text type key backed by CustomOption (category="unit_type") — was a hardcoded
  // UnitType enum; converted so orgs can add their own unit types without a schema change.
  // The 8 former enum values are seeded as system defaults in custom-options.service.ts.
  unitType       String
  sqft           Int?
  // Optional split of total sqft into floor + mezzanine. Some lease structures price
  // these separately (e.g. Lewisville P1 mezzanine units). When both are set,
  // `sqft` is the grand total — service code does not auto-derive to keep historical
  // unit sizes immutable.
  floorArea      Decimal?   @db.Decimal(10, 2)
  mezzanineArea  Decimal?   @db.Decimal(10, 2)
  status         String @default("AVAILABLE")
  askingRent     Decimal?   @db.Decimal(12, 2) // per sqft/month
  askingPrice    Decimal?   @db.Decimal(14, 2) // for sale units
  primeOwned     Boolean    @default(false)
  notes          String?
  // Time-on-market tracking: set when status flips to AVAILABLE, cleared on any other status.
  // Read-only from app code — UnitsService maintains this in update().
  availableSince DateTime?
  // Unit combine: when adjacent units merge into one legal unit, the source units are
  // soft-deleted and point here at the surviving combined unit (retains their child history).
  mergedIntoId   String?
  mergedInto     Unit?      @relation("UnitMerge", fields: [mergedIntoId], references: [id])
  mergedFrom     Unit[]     @relation("UnitMerge")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime? // soft-delete: preserves financial history

  leases           Lease[]
  sales            Sale[]
  comments         UnitComment[]
  loans            Loan[]
  budgetLines      BudgetLine[]
  commitments      Commitment[]
  actuals          Actual[]
  documents        Document[]
  tasks            Task[]
  clients          Client[]
  leads            Lead[]
  interiorProjects InteriorProject[]
  interestedLeads  LeadUnitInterest[]

  // Uniqueness of (buildingId, unitNumber) is enforced by a partial unique index
  // (WHERE "deletedAt" IS NULL) added in migration 20260703000000_units_partial_unique_active —
  // Prisma's schema language can't express partial indexes, so it isn't declared here.
  // This plain index exists for query performance only.
  @@index([buildingId, unitNumber])
  @@index([buildingId])
  @@index([status, deletedAt])
  @@index([status, availableSince])
  @@index([deletedAt])
  @@index([mergedIntoId])
  @@map("units")
}

enum BuildingType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  INDUSTRIAL
  PARKING
  AMENITY
  RETAIL
  OFFICE
  // Raw-land / undeveloped parcel — e.g. Rio Ranch lots (sold by acreage, no units inside).
  // Buildings of type LOT typically have no Unit children; sale/lease attaches to the Building directly.
  LOT
}



// ---- Comments ----

enum CommentType {
  MARKETING
  SALES
  FINANCIAL
}

model ProjectComment {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  content     String
  commentType CommentType @default(MARKETING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("project_comments")
}

model UnitComment {
  id          String      @id @default(cuid())
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  content     String
  commentType CommentType @default(MARKETING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([unitId])
  @@index([userId])
  @@index([createdAt])
  @@map("unit_comments")
}

// ---- Milestones ----

model Milestone {
  id                   String           @id @default(cuid())
  projectId            String
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  description          String?
  phase                String
  dueDate              DateTime
  completedAt          DateTime?
  status               String  @default("NOT_STARTED")
  ownerId              String?
  owner                User?            @relation("MilestoneOwner", fields: [ownerId], references: [id])
  sortOrder            Int              @default(0)
  // Dependency: this milestone cannot start until dependsOn is COMPLETED.
  // Cycle prevention is enforced in MilestonesService.setDependency().
  dependsOnId          String?
  dependsOn            Milestone?       @relation("MilestoneDeps", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents           Milestone[]      @relation("MilestoneDeps")
  // Link to a draw schedule entry — completing this milestone auto-drafts a DrawRequest.
  linkedDrawScheduleId String?
  linkedDrawSchedule   DrawSchedule?    @relation(fields: [linkedDrawScheduleId], references: [id])
  photos               MilestonePhoto[]
  // Interior / Fit-Out + Sale Payments
  salePayments         SalePayment[]
  snags                SnagItem[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([projectId, phase])
  @@index([dependsOnId])
  @@index([linkedDrawScheduleId])
  @@map("milestones")
}

// Photo evidence for a milestone — attached by PM on-site, surfaced to lender via draw package.
model MilestonePhoto {
  id           String    @id @default(cuid())
  milestoneId  String
  milestone    Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  storagePath  String // Supabase Storage key
  caption      String?
  uploadedById String
  uploadedBy   User      @relation("MilestonePhotoUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())

  @@index([milestoneId])
  @@map("milestone_photos")
}


// ---- Financial: Budget, Commitments, Actuals, Forecast ----

model BudgetLine {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Optional building/unit scoping so a project's budget can carry dedicated lines per
  // building or unit (e.g. Building 1 sitework vs Building 2 sitework), not just one
  // project-wide bucket. Mirrors the Loan polymorphic pattern. A line with neither set
  // is a project-level line — the existing/default case. projectId is always populated
  // regardless of scope so project-level rollups (findByProject, getFinancialSummary)
  // keep working unchanged.
  buildingId  String?
  building    Building?      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Free-text category key backed by CustomOption (category="budget_category") — the same
  // system-defaults-plus-org-custom-values pattern already used for project/unit/sale/lead
  // status and phase. Was a hardcoded BudgetCategory enum; converted so orgs can add their
  // own categories (e.g. "TENANT_IMPROVEMENTS") without a schema change. The 10 former enum
  // values are seeded as system defaults in custom-options.service.ts so existing data and
  // QuickBooks sync (which hardcodes category: 'OTHER') keep working unchanged.
  category    String
  description String
  // baselineAmt is the original (revision 1) amount, kept here for fast reads.
  // revisedAmt mirrors the *latest* BudgetRevision.amount for fast reads.
  // Source of truth for history is the BudgetRevision table.
  baselineAmt Decimal        @db.Decimal(14, 2)
  revisedAmt  Decimal?       @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime? // soft-delete

  revisions BudgetRevision[]

  @@index([projectId, category])
  @@index([buildingId])
  @@index([unitId])
  @@index([deletedAt])
  @@map("budget_lines")
}

// Each edit to a budget line creates a BudgetRevision. revision #1 is the baseline.
// BudgetLine.revisedAmt always equals the latest revision's amount.
// Append-only: revisions are never updated or deleted.
model BudgetRevision {
  id             String             @id @default(cuid())
  budgetLineId   String
  budgetLine     BudgetLine         @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  revisionNumber Int // 1 = baseline, 2+ = subsequent revisions
  amount         Decimal            @db.Decimal(14, 2)
  reason         String // required free-text justification
  changeReason   BudgetChangeReason
  createdById    String
  createdBy      User               @relation("BudgetRevCreator", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?              @relation("BudgetRevApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())

  @@unique([budgetLineId, revisionNumber])
  @@index([budgetLineId])
  @@map("budget_revisions")
}

enum BudgetChangeReason {
  SCOPE_ADD // we're adding scope
  COST_INCREASE // same scope, vendor raised price
  REALLOCATION // shifted from another category
  ESTIMATE_REFINED // better information now
  CHANGE_ORDER // formal CO from vendor
  OTHER
}

model Commitment {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Optional building/unit scoping — same pattern as BudgetLine/Loan. Neither set = a
  // project-level commitment (existing/default case).
  buildingId   String?
  building     Building?      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId       String?
  unit         Unit?          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  vendor       String
  description  String
  contractAmt  Decimal        @db.Decimal(14, 2)
  paidToDate   Decimal        @default(0) @db.Decimal(14, 2)
  retainage    Decimal        @default(0) @db.Decimal(14, 2)
  category     String
  contractDate DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([projectId])
  @@index([buildingId])
  @@index([unitId])
  @@map("commitments")
}

model Actual {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Optional building/unit scoping — same pattern as BudgetLine/Loan/Commitment. Neither
  // set = a project-level actual (existing/default case, including all QuickBooks-synced
  // rows, which have no building/unit concept upstream).
  buildingId   String?
  building     Building?      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId       String?
  unit         Unit?          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Interior/TI spend is recorded as an Actual but reported inside the interior module —
  // this tags those rows so the main project's budget/variance/KPI views can exclude them.
  interiorProjectId String?
  interiorProject   InteriorProject? @relation(fields: [interiorProjectId], references: [id], onDelete: SetNull)
  category     String
  description  String
  amount       Decimal        @db.Decimal(14, 2)
  txnDate      DateTime
  vendor       String?
  qbTxnId      String?        @unique // QuickBooks transaction ID
  qbSyncStatus QBSyncStatus   @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([projectId, category])
  @@index([interiorProjectId])
  @@index([qbTxnId])
  @@index([buildingId])
  @@index([unitId])
  @@map("actuals")
}

enum QBSyncStatus {
  PENDING
  SYNCED
  ERROR
  UNMAPPED
}

// ---- Loans ----

model Loan {
  id              String    @id @default(cuid())
  // Loans attach at either the Project level (portfolio loan covering multiple buildings)
  // or the Building level (per-tower construction loan — see Centro Plaza Bldgs 1 & 2,
  // each with its own closing date, rate, and outstanding balance).
  // Service layer requires at least one of (projectId, buildingId) to be set.
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId      String?
  building        Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId          String?
  unit            Unit?     @relation(fields: [unitId], references: [id])
  // Free-text key backed by CustomOption (category="loan_type") — same pattern as
  // BudgetLine.category. Was a hardcoded LoanType enum; converted so orgs can add their
  // own types (e.g. "SBA 504") without a schema change. The 5 former enum values are
  // seeded as system defaults in custom-options.service.ts.
  loanType        String
  lender          String // encrypted
  principalAmt    Decimal   @db.Decimal(14, 2) // encrypted at app level
  interestRate    Decimal   @db.Decimal(6, 4) // encrypted at app level
  termMonths      Int
  maturityDate    DateTime?
  currentBalance  Decimal?  @db.Decimal(14, 2) // encrypted at app level
  monthlyPayment  Decimal?  @db.Decimal(12, 2)
  notes           String?
  encryptedFields String? // JSON blob of encrypted sensitive data
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // soft-delete: required for compliance/audit

  drawRequests  DrawRequest[]
  drawSchedules DrawSchedule[]

  @@index([projectId])
  @@index([buildingId])
  @@index([unitId])
  @@index([deletedAt])
  @@index([maturityDate])
  @@map("loans")
}

model DrawRequest {
  id                  String         @id @default(cuid())
  loanId              String
  loan                Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?       @relation(fields: [projectId], references: [id])
  drawNumber          Int
  amount              Decimal        @db.Decimal(14, 2)
  requestedAmount     Decimal?       @db.Decimal(14, 2)
  approvedAmount      Decimal?       @db.Decimal(14, 2)
  requestDate         DateTime
  approvedAt          DateTime?
  approvedDate        DateTime?
  fundedAt            DateTime?
  status              DrawStatus     @default(DRAFT)
  notes               String?
  rejectionReason     String?
  createdById         String?
  createdBy           User?          @relation("DrawCreator", fields: [createdById], references: [id])
  approvedById        String?
  approvedBy          User?          @relation("DrawApprover", fields: [approvedById], references: [id])
  // Slice 8 additions
  expectedFundingDate DateTime? // PM's best estimate; cron escalates if overshot
  submittedToLenderAt DateTime? // when finance forwarded to construction lender
  approvals           DrawApproval[]
  documents           DrawDocument[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([loanId, drawNumber])
  @@index([projectId])
  @@index([status, expectedFundingDate])
  @@map("draw_requests")
}

enum DrawStatus {
  DRAFT
  SUBMITTED
  APPROVED
  FUNDED
  REJECTED
  CANCELLED
}

// One row per workflow action (approve/reject/return) on a draw.
// Append-only audit trail of the multi-party approval chain.
model DrawApproval {
  id            String             @id @default(cuid())
  drawRequestId String
  drawRequest   DrawRequest        @relation(fields: [drawRequestId], references: [id], onDelete: Cascade)
  step          DrawApprovalStep
  action        DrawApprovalAction
  actorId       String
  actor         User               @relation("DrawApprovalActor", fields: [actorId], references: [id])
  comment       String?
  createdAt     DateTime           @default(now())

  @@index([drawRequestId, step])
  @@map("draw_approvals")
}

enum DrawApprovalStep {
  INTERNAL_FOUNDER // founder sign-off
  INTERNAL_FINANCE // finance review
  LENDER_SUBMITTED // sent to construction lender
  LENDER_FUNDED // lender wired funds
}

enum DrawApprovalAction {
  APPROVED
  REJECTED
  RETURNED_FOR_INFO
}

// Files attached to a draw — lien waivers, inspection reports, etc.
// Drives the "missing documents" red-flag UI.
model DrawDocument {
  id            String      @id @default(cuid())
  drawRequestId String
  drawRequest   DrawRequest @relation(fields: [drawRequestId], references: [id], onDelete: Cascade)
  documentType  DrawDocType
  storagePath   String // Supabase Storage key
  filename      String
  uploadedById  String
  uploadedBy    User        @relation("DrawDocUploader", fields: [uploadedById], references: [id])
  uploadedAt    DateTime    @default(now())

  @@index([drawRequestId, documentType])
  @@map("draw_documents")
}

enum DrawDocType {
  LIEN_WAIVER
  INSPECTION_REPORT
  SWORN_STATEMENT
  VENDOR_INVOICE
  CHANGE_ORDER
  OTHER
}

model DrawSchedule {
  id            String   @id @default(cuid())
  loanId        String
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  drawNumber    Int
  plannedAmount Decimal  @db.Decimal(14, 2)
  plannedDate   DateTime
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  linkedMilestones Milestone[]

  @@unique([loanId, drawNumber])
  @@index([loanId])
  @@map("draw_schedules")
}

// ---- Sales ----

model Sale {
  id                   String      @id @default(cuid())
  projectId            String
  project              Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Polymorphic asset link — exactly one of (unitId, buildingId) is set.
  // Enforced at the service layer (SalesService.create/update). DB lets both be null
  // to support data migration; queries should always include the populated side.
  unitId               String?
  unit                 Unit?       @relation(fields: [unitId], references: [id])
  buildingId           String?
  building             Building?   @relation(fields: [buildingId], references: [id])
  buyer                String?
  salePrice            Decimal?    @db.Decimal(14, 2)
  depositAmt           Decimal?    @db.Decimal(14, 2)
  status               String  @default("PROSPECT")
  loiDate              DateTime?
  contractDate         DateTime?
  closingDate          DateTime?
  notes                String?
  // Slice 6: Pipeline upgrade
  lastActivityAt       DateTime? // bump on update or comment; powers activity-drought alerts
  expectedCloseDate    DateTime? // for weighted forecast time-bucketing
  lostReason           LostReason? // required when status -> CANCELLED
  lostReasonNote       String?
  // Discount-approval gate: a sale priced below the unit's asking price by more than the
  // org threshold needs Founder/Co-Founder sign-off before it can be committed
  // (UNDER_CONTRACT/CLOSED). Single approval — no dual-approval (client decision).
  discountApprovedById String?
  discountApprovedBy   User?       @relation("SaleDiscountApprover", fields: [discountApprovedById], references: [id])
  discountApprovedAt   DateTime?
  // Broker attribution + commission (internal-only; brokers have no login).
  // Commission is earned/stamped when the sale CLOSES.
  brokerId             String?
  broker               Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  brokerCommissionPct       Decimal?    @db.Decimal(5, 2) // per-sale override of Broker.commissionRate
  brokerCommissionAmt       Decimal?    @db.Decimal(14, 2) // computed + stored on close
  brokerCommissionPaidAt    DateTime?   // set when commission is remitted to broker
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime? // soft-delete

  convertedLead Lead?

  documents        Document[]
  client           Client?
  // Sale Payment Schedule (milestone-linked installments) + interior fit-out context
  payments         SalePayment[]
  interiorProjects InteriorProject[]

  @@index([projectId])
  @@index([unitId])
  @@index([buildingId])
  @@index([status, deletedAt])
  @@index([status, lastActivityAt])
  @@index([deletedAt])
  @@index([brokerId])
  @@map("sales")
}

enum LostReason {
  PRICE_TOO_HIGH
  FINANCING_FELL_THROUGH
  CHOSE_COMPETITOR
  TIMING_OFF
  NO_RESPONSE
  OTHER
}


// ---- Leases ----

model Lease {
  id              String      @id @default(cuid())
  // Polymorphic asset link — exactly one of (unitId, buildingId) is set.
  // Service-layer enforcement; DB allows both null only during migration.
  unitId          String?
  unit            Unit?       @relation(fields: [unitId], references: [id])
  buildingId      String?
  building        Building?   @relation(fields: [buildingId], references: [id])
  // tenantName: legacy field — kept populated for backwards compatibility with existing
  // queries and reporting. New rows should also populate `tenantLegalName` (the LLC /
  // legal entity that signs the lease) and `tenantBrand` (the doing-business-as / brand
  // name that customers see, e.g. "ABC LLC dba Cream Stone").
  tenantName      String
  tenantLegalName String?
  tenantBrand     String?
  tenantContact   String?
  monthlyRent     Decimal     @db.Decimal(12, 2)
  rentPerSqft     Decimal?    @db.Decimal(8, 2)
  leaseStart      DateTime
  leaseEnd        DateTime
  termMonths      Int
  escalationPct   Decimal?    @db.Decimal(5, 2)
  escalationFreq  Int? // months between escalations
  securityDeposit Decimal?    @db.Decimal(12, 2)
  status          String @default("DRAFT")
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime? // soft-delete

  interiorProjects InteriorProject[]

  @@index([unitId])
  @@index([buildingId])
  @@index([status, leaseEnd])
  @@index([deletedAt])
  @@map("leases")
}


// ---- Rent Roll Snapshot ----

model RentRollSnapshot {
  id            String   @id @default(cuid())
  projectId     String
  snapshotDate  DateTime
  totalUnits    Int
  leasedUnits   Int
  occupancyPct  Decimal  @db.Decimal(5, 2)
  grossRent     Decimal  @db.Decimal(14, 2)
  effectiveRent Decimal  @db.Decimal(14, 2)
  data          Json // detailed unit-level breakdown
  createdAt     DateTime @default(now())

  @@unique([projectId, snapshotDate])
  @@map("rent_roll_snapshots")
}

// ---- KPI Snapshot ----

model KpiSnapshot {
