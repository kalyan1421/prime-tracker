// =============================================
// Prime Tracker — Prisma Schema
// Single-tenant now, multi-tenant ready (tenantId fields commented)
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- Auth & RBAC ----

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  avatarUrl    String?
  googleId     String?    @unique
  // Directory fields — self-editable, and editable by an admin on someone else.
  // Never authorization-relevant, unlike role/roles/isActive.
  phone        String?
  jobTitle     String?
  role         UserRole   @default(VIEWER)
  roles        UserRole[]
  isActive     Boolean    @default(true)
  passwordHash String?
  mfaEnabled   Boolean    @default(false)
  mfaSecret    String? // encrypted TOTP secret
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  // tenantId   String?   // future multi-tenant

  milestones                   Milestone[]                 @relation("MilestoneOwner")
  auditEvents                  AuditEvent[]
  sessions                     RefreshToken[]
  unitComments                 UnitComment[]
  projectComments              ProjectComment[]
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  assignedLeads                Lead[]                      @relation("LeadAssignee")
  createdLeads                 Lead[]                      @relation("LeadCreator")
  leadActivities               LeadActivity[]              @relation("ActivityCreator")
  drawRequests                 DrawRequest[]               @relation("DrawCreator")
  approvedDraws                DrawRequest[]               @relation("DrawApprover")
  uploadedDocuments            Document[]                  @relation("DocumentUploader")
  assignedTasks                Task[]                      @relation("TaskAssignee")
  createdTasks                 Task[]                      @relation("TaskCreator")
  taskComments                 TaskComment[]
  taskAttachments              TaskAttachment[]            @relation("TaskAttachmentUploader")
  orgMemberships               OrgMembership[]             @relation("OrgMember")
  managedMembers               OrgMembership[]             @relation("ManagedBy")
  projectMemberships           ProjectMember[]
  // New relations from Slices 1, 5, 7, 8
  milestonePhotos              MilestonePhoto[]            @relation("MilestonePhotoUploader")
  budgetRevisionsCreated       BudgetRevision[]            @relation("BudgetRevCreator")
  budgetRevisionsApproved      BudgetRevision[]            @relation("BudgetRevApprover")
  drawApprovals                DrawApproval[]              @relation("DrawApprovalActor")
  drawDocuments                DrawDocument[]              @relation("DrawDocUploader")
  // Document Vault Phase 1
  uploadedDocVersions          DocumentVersion[]           @relation("VersionUploader")
  // Document Vault Phase 2 — buyer portal
  clientProfile                Client?                     @relation("ClientUser")
  // Sprint 2 — Campaign attribution
  campaignsCreated             Campaign[]                  @relation("CampaignCreator")
  campaignSpendRecorded        CampaignSpend[]             @relation("CampaignSpender")
  // Interior / Fit-Out + Sale Payments
  interiorProjects             InteriorProject[]           @relation("InteriorPM")
  snagItems                    SnagItem[]                  @relation("SnagAssignee")
  discountApprovedSales        Sale[]                      @relation("SaleDiscountApprover")
  dailyLogs                    DailyLog[]                  @relation("DailyLogAuthor")
  // Leasing depth — rent timeline + deposit/TI ledger
  leaseRentPeriods             LeaseRentPeriod[]           @relation("LeaseRentPeriodCreator")
  leaseRentCorrections         LeaseRentPeriodCorrection[] @relation("LeaseRentPeriodCorrector")
  leaseObligationPayments      LeaseObligationPayment[]    @relation("LeaseObligationPaymentRecorder")
  leaseRentInvoices            LeaseRentInvoice[]          @relation("LeaseRentInvoiceRecorder")
  leaseAssignmentsRecorded     LeaseTenantAssignment[]     @relation("LeaseAssignmentRecorder")
  historicalDeletionsRequested HistoricalRecordDeletion[]  @relation("HistoricalDeletionRequester")
  historicalDeletionsDecided   HistoricalRecordDeletion[]  @relation("HistoricalDeletionDecider")
  taskUpdates                  TaskUpdate[]                @relation("TaskUpdateAuthor")
  taskAssignments              TaskAssignment[]            @relation("TaskAssignmentUser")
  // Unit occupancy log
  unitStatusEvents             UnitStatusEvent[]           @relation("UnitStatusEventRecorder")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("refresh_tokens")
}

enum UserRole {
  SUPER_ADMIN
  FOUNDER
  EXECUTIVE
  FINANCE
  ACCOUNTING
  AR_AP
  PROJECT_MANAGER
  CONSTRUCTION
  SALES
  MARKETING
  LEGAL
  VIEWER
  // Buyer portal role (Phase 2 of Document Vault rollout) — sees only their own unit
  CLIENT
}

enum OrgRole {
  LEAD
  EMPLOYEE
}

// ---- Organizations ----

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  entityType  String? // LLC, LP, Corp
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships OrgMembership[]
  projects    Project[]
  settings    OrgSettings?

  @@map("organizations")
}

model OrgMembership {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("OrgMember", fields: [userId], references: [id], onDelete: Cascade)
  orgRole   OrgRole      @default(EMPLOYEE)
  reportsTo String?
  manager   User?        @relation("ManagedBy", fields: [reportsTo], references: [id])
  joinedAt  DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
  @@map("org_memberships")
}

// ---- Projects ----

model Project {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  location       String
  address        String?
  acreage        Decimal?      @db.Decimal(10, 3)
  // Top-down "control total" approved by Finance/Founder. Detailed budget lines are
  // tracked bottom-up against this; the Approved-vs-Planned gap is a key signal.
  approvedBudget Decimal?      @db.Decimal(14, 2)
  status         String        @default("ACTIVE")
  phase          String        @default("PRE_DEVELOPMENT")
  projectType    ProjectType?
  description    String?
  startDate      DateTime?
  targetEnd      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime? // soft-delete: archived rows excluded from default reads
  // tenantId  String?
  orgId          String?
  org            Organization? @relation(fields: [orgId], references: [id])

  buildings        Building[]
  milestones       Milestone[]
  budgetLines      BudgetLine[]
  commitments      Commitment[]
  actuals          Actual[]
  loans            Loan[]
  sales            Sale[]
  kpiSnapshots     KpiSnapshot[]
  qbMappings       QBProjectMapping[]
  comments         ProjectComment[]
  leads            Lead[]
  drawRequests     DrawRequest[]
  cashFlowEntries  CashFlowEntry[]
  contracts        Contract[]
  documents        Document[]
  equityPositions  EquityPosition[]
  capitalCalls     CapitalCall[]
  distributions    Distribution[]
  tasks            Task[]
  members          ProjectMember[]
  clients          Client[]
  campaignProjects CampaignProject[]
  dailyLogs        DailyLog[]

  @@index([orgId])
  @@index([status, phase])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  // One membership row per (project, user); a person can hold SEVERAL roles on the same
  // project (e.g. Finance AND Legal). `role` mirrors roles[0] as the primary, exactly as
  // User.role mirrors User.roles[0], so every existing read keeps working unchanged.
  role      String   @default("TEAM_MEMBER")
  roles     String[]
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@map("project_members")
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  INDUSTRIAL
}

// ---- Buildings & Units ----

model Building {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  // Legal entity that owns this building (e.g. "Prime Leander I LLC"). Free-text by
  // design — Prime tracks the LLC *label* per building, not LLC master data (EIN,
  // registered address, formation docs). If entity-level reporting is ever needed,
  // promote to a LegalEntity relation via SELECT DISTINCT "llcName".
  llcName        String?
  totalSqft      Int?
  // For LOT-type buildings (raw parcels — see BuildingType.LOT), size is expressed
  // in acres rather than square feet. Stored as Decimal(10,3) to support fractional
  // acreage (e.g. 1.27, 8.0, 11.98 from the Rio Ranch lots).
  acreage        Decimal?      @db.Decimal(10, 3)
  stories        Int?
  buildingType   BuildingType?
  // Building-level phase: a project may have Building A in CONSTRUCTION and Building B in LEASE_UP.
  // Project.phase is computed = max(buildings.phase) — see ProjectPhaseService.
  phase          String        @default("PRE_DEVELOPMENT")
  coverPhotoPath String? // optional cover photo (Supabase storage path)
  sortOrder      Int           @default(0) // manual display order within a project (drag-to-reorder)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime? // soft-delete

  units            Unit[]
  tasks            Task[]
  taskBuildings    TaskBuilding[]
  documents        Document[]
  // Polymorphic back-relations: Sale/Lease/Lead/Loan can attach to a Building directly
  // (e.g. Leander Building 1 leased as one whole asset to "22 Yards Austin") in addition to
  // attaching to a specific Unit. Service-level validation ensures exactly one of
  // (buildingId, unitId) is set per row — see Sprint 1 docs.
  sales            Sale[]
  leases           Lease[]
  leads            Lead[]
  loans            Loan[]
  budgetLines      BudgetLine[]
  commitments      Commitment[]
  actuals          Actual[]
  interiorProjects InteriorProject[]
  dailyLogs        DailyLog[]

  @@index([projectId])
  @@index([projectId, sortOrder])
  @@index([phase])
  @@index([deletedAt])
  @@map("buildings")
}

/// Lifecycle state of a unit.
///
/// Was a free `String @default("AVAILABLE")`. Nothing constrained it, so a typo in any
/// client wrote a value the UI has no colour, label or ordering for — it would simply
/// vanish from the status mix and every status-filtered query. The values below are the
/// five present in the data plus the two the UI already renders.
enum UnitStatus {
  AVAILABLE
  UNDER_CONTRACT
  LEASE_PENDING
  LEASED
  OCCUPIED
  SOLD
  UNDER_CONSTRUCTION
}

model Unit {
  id             String     @id @default(cuid())
  buildingId     String
  building       Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitNumber     String
  // Free-text type key backed by CustomOption (category="unit_type") — was a hardcoded
  // UnitType enum; converted so orgs can add their own unit types without a schema change.
  // The 8 former enum values are seeded as system defaults in custom-options.service.ts.
  unitType       String
  sqft           Int?
  // Optional split of total sqft into floor + mezzanine. Some lease structures price
  // these separately (e.g. Lewisville P1 mezzanine units). When both are set,
  // `sqft` is the grand total — service code does not auto-derive to keep historical
  // unit sizes immutable.
  floorArea      Decimal?   @db.Decimal(10, 2)
  mezzanineArea  Decimal?   @db.Decimal(10, 2)
  status         UnitStatus @default(AVAILABLE)
  askingRent     Decimal?   @db.Decimal(12, 2) // per sqft/month
  askingPrice    Decimal?   @db.Decimal(14, 2) // for sale units
  primeOwned     Boolean    @default(false)
  notes          String?
  // Time-on-market tracking: set when status flips to AVAILABLE, cleared on any other status.
  // Read-only from app code — UnitsService maintains this in update().
  availableSince DateTime?
  // Unit combine: when adjacent units merge into one legal unit, the source units are
  // soft-deleted and point here at the surviving combined unit (retains their child history).
  mergedIntoId   String?
  mergedInto     Unit?      @relation("UnitMerge", fields: [mergedIntoId], references: [id])
  mergedFrom     Unit[]     @relation("UnitMerge")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime? // soft-delete: preserves financial history

  leases           Lease[]
  sales            Sale[]
  statusEvents     UnitStatusEvent[]
  comments         UnitComment[]
  loans            Loan[]
  budgetLines      BudgetLine[]
  commitments      Commitment[]
  actuals          Actual[]
  documents        Document[]
  tasks            Task[]
  taskUnits        TaskUnit[]
  dailyLogs        DailyLog[]
  clients          Client[]
  leads            Lead[]
  interiorProjects InteriorProject[]
  interestedLeads  LeadUnitInterest[]

  // Uniqueness of (buildingId, unitNumber) is enforced by a partial unique index
  // (WHERE "deletedAt" IS NULL) added in migration 20260703000000_units_partial_unique_active —
  // Prisma's schema language can't express partial indexes, so it isn't declared here.
  // This plain index exists for query performance only.
  @@index([buildingId, unitNumber])
  @@index([buildingId])
  @@index([status, deletedAt])
  @@index([status, availableSince])
  @@index([deletedAt])
  @@index([mergedIntoId])
  @@map("units")
}

// ============================================================================
// Unit occupancy log — append-only.
//
// `Unit.availableSince` is a single mutable column: it is stamped with now() on a
// flip TO AVAILABLE and NULLED on a flip away from it. That makes it a "current
// state" field masquerading as history — once a unit leases, how long it sat
// vacant is gone. (Measured 2026-08-12: 208 units are AVAILABLE and exactly 2 of
// them carry an availableSince, so the Vacancy Report was reading createdAt for
// the other 206.)
//
// This table is the durable record instead. One row per transition, written in
// the SAME transaction as the unit update by every service that flips a unit.
// Never updated, never deleted — a correction is a new row, not an edit.
//
// Two timestamps, deliberately:
//   effectiveAt — when it happened in the real world. Backdatable, and the only
//                 field vacancy/time-on-market maths should ever read.
//   recordedAt  — when the row was written. Equal to effectiveAt for live events;
//                 far apart for backfilled history.
//
// `availableSince` is kept in sync as a denormalised convenience (the stale-unit
// cron and existing reports read it) but is no longer the source of truth.
// ============================================================================

model UnitStatusEvent {
  id           String      @id @default(cuid())
  unitId       String
  unit         Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  /// Null only for the unit's first event (creation, or the bootstrap backfill row).
  fromStatus   UnitStatus?
  toStatus     UnitStatus
  /// When the transition happened in the real world. Backdatable for historical entry.
  effectiveAt  DateTime
  /// When the row was written. Differs from effectiveAt for backfilled history.
  recordedAt   DateTime    @default(now())
  /// MANUAL | LEASE_ACTIVATED | LEASE_ENDED | SALE_CLOSED | SALE_CANCELLED
  /// | UNIT_CREATED | UNIT_COMBINED | BACKFILL | SYSTEM
  source       String
  /// Provenance — which lease/sale drove this, when one did.
  leaseId      String?
  saleId       String?
  reason       String?
  /// True for rows created by historical backfill rather than observed live.
  isHistorical Boolean     @default(false)
  recordedById String?
  recordedBy   User?       @relation("UnitStatusEventRecorder", fields: [recordedById], references: [id])

  @@index([unitId, effectiveAt])
  @@index([toStatus, effectiveAt])
  @@map("unit_status_events")
}

enum BuildingType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
  INDUSTRIAL
  PARKING
  AMENITY
  RETAIL
  OFFICE
  // Raw-land / undeveloped parcel — e.g. Rio Ranch lots (sold by acreage, no units inside).
  // Buildings of type LOT typically have no Unit children; sale/lease attaches to the Building directly.
  LOT
}

// ---- Comments ----

enum CommentType {
  MARKETING
  SALES
  FINANCIAL
}

model ProjectComment {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  content     String
  commentType CommentType @default(MARKETING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("project_comments")
}

model UnitComment {
  id          String      @id @default(cuid())
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  content     String
  commentType CommentType @default(MARKETING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([unitId])
  @@index([userId])
  @@index([createdAt])
  @@map("unit_comments")
}

// ---- Milestones ----

model Milestone {
  id                   String           @id @default(cuid())
  projectId            String
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  description          String?
  phase                String
  dueDate              DateTime
  completedAt          DateTime?
  status               String           @default("NOT_STARTED")
  ownerId              String?
  owner                User?            @relation("MilestoneOwner", fields: [ownerId], references: [id])
  sortOrder            Int              @default(0)
  // Dependency: this milestone cannot start until dependsOn is COMPLETED.
  // Cycle prevention is enforced in MilestonesService.setDependency().
  dependsOnId          String?
  dependsOn            Milestone?       @relation("MilestoneDeps", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents           Milestone[]      @relation("MilestoneDeps")
  // Link to a draw schedule entry — completing this milestone auto-drafts a DrawRequest.
  linkedDrawScheduleId String?
  linkedDrawSchedule   DrawSchedule?    @relation(fields: [linkedDrawScheduleId], references: [id])
  photos               MilestonePhoto[]
  // Interior / Fit-Out + Sale Payments
  salePayments         SalePayment[]
  snags                SnagItem[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([projectId, phase])
  @@index([dependsOnId])
  @@index([linkedDrawScheduleId])
  @@map("milestones")
}

// Photo evidence for a milestone — attached by PM on-site, surfaced to lender via draw package.
model MilestonePhoto {
  id           String    @id @default(cuid())
  milestoneId  String
  milestone    Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  storagePath  String // Supabase Storage key
  caption      String?
  uploadedById String
  uploadedBy   User      @relation("MilestonePhotoUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())

  @@index([milestoneId])
  @@map("milestone_photos")
}

// ---- Financial: Budget, Commitments, Actuals, Forecast ----

model BudgetLine {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Optional building/unit scoping so a project's budget can carry dedicated lines per
  // building or unit (e.g. Building 1 sitework vs Building 2 sitework), not just one
  // project-wide bucket. Mirrors the Loan polymorphic pattern. A line with neither set
  // is a project-level line — the existing/default case. projectId is always populated
  // regardless of scope so project-level rollups (findByProject, getFinancialSummary)
  // keep working unchanged.
  buildingId  String?
  building    Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Free-text category key backed by CustomOption (category="budget_category") — the same
  // system-defaults-plus-org-custom-values pattern already used for project/unit/sale/lead
  // status and phase. Was a hardcoded BudgetCategory enum; converted so orgs can add their
  // own categories (e.g. "TENANT_IMPROVEMENTS") without a schema change. The 10 former enum
  // values are seeded as system defaults in custom-options.service.ts so existing data and
  // QuickBooks sync (which hardcodes category: 'OTHER') keep working unchanged.
  category    String
  description String
  // baselineAmt is the original (revision 1) amount, kept here for fast reads.
  // revisedAmt mirrors the *latest* BudgetRevision.amount for fast reads.
  // Source of truth for history is the BudgetRevision table.
  baselineAmt Decimal   @db.Decimal(14, 2)
  revisedAmt  Decimal?  @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft-delete

  revisions BudgetRevision[]

  @@index([projectId, category])
  @@index([buildingId])
  @@index([unitId])
  @@index([deletedAt])
  @@map("budget_lines")
}

// Each edit to a budget line creates a BudgetRevision. revision #1 is the baseline.
// BudgetLine.revisedAmt always equals the latest revision's amount.
// Append-only: revisions are never updated or deleted.
model BudgetRevision {
  id             String             @id @default(cuid())
  budgetLineId   String
  budgetLine     BudgetLine         @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  revisionNumber Int // 1 = baseline, 2+ = subsequent revisions
  amount         Decimal            @db.Decimal(14, 2)
  reason         String // required free-text justification
  changeReason   BudgetChangeReason
  createdById    String
  createdBy      User               @relation("BudgetRevCreator", fields: [createdById], references: [id])
  approvedById   String?
  approvedBy     User?              @relation("BudgetRevApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime           @default(now())

  @@unique([budgetLineId, revisionNumber])
  @@index([budgetLineId])
  @@map("budget_revisions")
}

enum BudgetChangeReason {
  SCOPE_ADD // we're adding scope
  COST_INCREASE // same scope, vendor raised price
  REALLOCATION // shifted from another category
  ESTIMATE_REFINED // better information now
  CHANGE_ORDER // formal CO from vendor
  OTHER
}

model Commitment {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Optional building/unit scoping — same pattern as BudgetLine/Loan. Neither set = a
  // project-level commitment (existing/default case).
  buildingId   String?
  building     Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId       String?
  unit         Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  vendor       String
  description  String
  contractAmt  Decimal   @db.Decimal(14, 2)
  paidToDate   Decimal   @default(0) @db.Decimal(14, 2)
  retainage    Decimal   @default(0) @db.Decimal(14, 2)
  category     String
  contractDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
  @@index([buildingId])
  @@index([unitId])
  @@map("commitments")
}

model Actual {
  id                String           @id @default(cuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Optional building/unit scoping — same pattern as BudgetLine/Loan/Commitment. Neither
  // set = a project-level actual (existing/default case, including all QuickBooks-synced
  // rows, which have no building/unit concept upstream).
  buildingId        String?
  building          Building?        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId            String?
  unit              Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Interior/TI spend is recorded as an Actual but reported inside the interior module —
  // this tags those rows so the main project's budget/variance/KPI views can exclude them.
  interiorProjectId String?
  interiorProject   InteriorProject? @relation(fields: [interiorProjectId], references: [id], onDelete: SetNull)
  category          String
  description       String
  amount            Decimal          @db.Decimal(14, 2)
  txnDate           DateTime
  vendor            String?
  qbTxnId           String?          @unique // QuickBooks transaction ID
  qbSyncStatus      QBSyncStatus     @default(PENDING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([projectId, category])
  @@index([interiorProjectId])
  @@index([qbTxnId])
  @@index([buildingId])
  @@index([unitId])
  @@map("actuals")
}

enum QBSyncStatus {
  PENDING
  SYNCED
  ERROR
  UNMAPPED
}

// ---- Loans ----

model Loan {
  id              String    @id @default(cuid())
  // Loans attach at either the Project level (portfolio loan covering multiple buildings)
  // or the Building level (per-tower construction loan — see Centro Plaza Bldgs 1 & 2,
  // each with its own closing date, rate, and outstanding balance).
  // Service layer requires at least one of (projectId, buildingId) to be set.
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId      String?
  building        Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId          String?
  unit            Unit?     @relation(fields: [unitId], references: [id])
  // Free-text key backed by CustomOption (category="loan_type") — same pattern as
  // BudgetLine.category. Was a hardcoded LoanType enum; converted so orgs can add their
  // own types (e.g. "SBA 504") without a schema change. The 5 former enum values are
  // seeded as system defaults in custom-options.service.ts.
  loanType        String
  // lender/principalAmt/interestRate/currentBalance are AES-256-GCM encrypted into
  // `encryptedFields` and the columns are left NULL. They are nullable for exactly
  // that reason — the value lives in the blob, not here. Any read path that surfaces
  // them must call EncryptionService.decryptLoan first.
  lender          String?
  principalAmt    Decimal?  @db.Decimal(14, 2)
  interestRate    Decimal?  @db.Decimal(6, 4)
  termMonths      Int
  maturityDate    DateTime?
  currentBalance  Decimal?  @db.Decimal(14, 2) // encrypted at app level
  monthlyPayment  Decimal?  @db.Decimal(12, 2)
  notes           String?
  encryptedFields String? // JSON blob of encrypted sensitive data
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // soft-delete: required for compliance/audit

  drawRequests  DrawRequest[]
  drawSchedules DrawSchedule[]

  @@index([projectId])
  @@index([buildingId])
  @@index([unitId])
  @@index([deletedAt])
  @@index([maturityDate])
  @@map("loans")
}

model DrawRequest {
  id                  String         @id @default(cuid())
  loanId              String
  loan                Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  projectId           String?
  project             Project?       @relation(fields: [projectId], references: [id])
  drawNumber          Int
  amount              Decimal        @db.Decimal(14, 2)
  requestedAmount     Decimal?       @db.Decimal(14, 2)
  approvedAmount      Decimal?       @db.Decimal(14, 2)
  requestDate         DateTime
  approvedAt          DateTime?
  approvedDate        DateTime?
  fundedAt            DateTime?
  status              DrawStatus     @default(DRAFT)
  notes               String?
  rejectionReason     String?
  createdById         String?
  createdBy           User?          @relation("DrawCreator", fields: [createdById], references: [id])
  approvedById        String?
  approvedBy          User?          @relation("DrawApprover", fields: [approvedById], references: [id])
  // Slice 8 additions
  expectedFundingDate DateTime? // PM's best estimate; cron escalates if overshot
  submittedToLenderAt DateTime? // when finance forwarded to construction lender
  approvals           DrawApproval[]
  documents           DrawDocument[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([loanId, drawNumber])
  @@index([projectId])
  @@index([status, expectedFundingDate])
  @@map("draw_requests")
}

enum DrawStatus {
  DRAFT
  SUBMITTED
  APPROVED
  FUNDED
  REJECTED
  CANCELLED
}

// One row per workflow action (approve/reject/return) on a draw.
// Append-only audit trail of the multi-party approval chain.
model DrawApproval {
  id            String             @id @default(cuid())
  drawRequestId String
  drawRequest   DrawRequest        @relation(fields: [drawRequestId], references: [id], onDelete: Cascade)
  step          DrawApprovalStep
  action        DrawApprovalAction
  actorId       String
  actor         User               @relation("DrawApprovalActor", fields: [actorId], references: [id])
  comment       String?
  createdAt     DateTime           @default(now())

  @@index([drawRequestId, step])
  @@map("draw_approvals")
}

enum DrawApprovalStep {
  INTERNAL_FOUNDER // founder sign-off
  INTERNAL_FINANCE // finance review
  LENDER_SUBMITTED // sent to construction lender
  LENDER_FUNDED // lender wired funds
}

enum DrawApprovalAction {
  APPROVED
  REJECTED
  RETURNED_FOR_INFO
}

// Files attached to a draw — lien waivers, inspection reports, etc.
// Drives the "missing documents" red-flag UI.
model DrawDocument {
  id            String      @id @default(cuid())
  drawRequestId String
  drawRequest   DrawRequest @relation(fields: [drawRequestId], references: [id], onDelete: Cascade)
  documentType  DrawDocType
  storagePath   String // Supabase Storage key
  filename      String
  uploadedById  String
  uploadedBy    User        @relation("DrawDocUploader", fields: [uploadedById], references: [id])
  uploadedAt    DateTime    @default(now())

  @@index([drawRequestId, documentType])
  @@map("draw_documents")
}

enum DrawDocType {
  LIEN_WAIVER
  INSPECTION_REPORT
  SWORN_STATEMENT
  VENDOR_INVOICE
  CHANGE_ORDER
  OTHER
}

model DrawSchedule {
  id            String   @id @default(cuid())
  loanId        String
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  drawNumber    Int
  plannedAmount Decimal  @db.Decimal(14, 2)
  plannedDate   DateTime
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  linkedMilestones Milestone[]

  @@unique([loanId, drawNumber])
  @@index([loanId])
  @@map("draw_schedules")
}

// ---- Sales ----

model Sale {
  id                     String      @id @default(cuid())
  projectId              String
  project                Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Polymorphic asset link — exactly one of (unitId, buildingId) is set.
  // Enforced at the service layer (SalesService.create/update). DB lets both be null
  // to support data migration; queries should always include the populated side.
  unitId                 String?
  unit                   Unit?       @relation(fields: [unitId], references: [id])
  buildingId             String?
  building               Building?   @relation(fields: [buildingId], references: [id])
  buyer                  String?
  salePrice              Decimal?    @db.Decimal(14, 2)
  depositAmt             Decimal?    @db.Decimal(14, 2)
  status                 String      @default("PROSPECT")
  loiDate                DateTime?
  contractDate           DateTime?
  closingDate            DateTime?
  notes                  String?
  // Slice 6: Pipeline upgrade
  lastActivityAt         DateTime? // bump on update or comment; powers activity-drought alerts
  expectedCloseDate      DateTime? // for weighted forecast time-bucketing
  lostReason             LostReason? // required when status -> CANCELLED
  lostReasonNote         String?
  // Discount-approval gate: a sale priced below the unit's asking price by more than the
  // org threshold needs Founder/Co-Founder sign-off before it can be committed
  // (UNDER_CONTRACT/CLOSED). Single approval — no dual-approval (client decision).
  discountApprovedById   String?
  discountApprovedBy     User?       @relation("SaleDiscountApprover", fields: [discountApprovedById], references: [id])
  discountApprovedAt     DateTime?
  // Broker attribution + commission (internal-only; brokers have no login).
  // Commission is earned/stamped when the sale CLOSES.
  brokerId               String?
  broker                 Broker?     @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  brokerCommissionPct    Decimal?    @db.Decimal(5, 2) // per-sale override of Broker.commissionRate
  brokerCommissionAmt    Decimal?    @db.Decimal(14, 2) // computed + stored on close
  brokerCommissionPaidAt DateTime? // set when commission is remitted to broker
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  deletedAt              DateTime? // soft-delete

  convertedLead Lead?

  documents        Document[]
  client           Client?
  // Sale Payment Schedule (milestone-linked installments) + interior fit-out context
  payments         SalePayment[]
  interiorProjects InteriorProject[]

  @@index([projectId])
  @@index([unitId])
  @@index([buildingId])
  @@index([status, deletedAt])
  @@index([status, lastActivityAt])
  @@index([deletedAt])
  @@index([brokerId])
  @@map("sales")
}

enum LostReason {
  PRICE_TOO_HIGH
  FINANCING_FELL_THROUGH
  CHOSE_COMPETITOR
  TIMING_OFF
  NO_RESPONSE
  OTHER
}

// ---- Leases ----

model Lease {
  id                     String    @id @default(cuid())
  // Polymorphic asset link — exactly one of (unitId, buildingId) is set.
  // Service-layer enforcement; DB allows both null only during migration.
  unitId                 String?
  unit                   Unit?     @relation(fields: [unitId], references: [id])
  buildingId             String?
  building               Building? @relation(fields: [buildingId], references: [id])
  // tenantName: legacy field — kept populated for backwards compatibility with existing
  // queries and reporting. New rows should also populate `tenantLegalName` (the LLC /
  // legal entity that signs the lease) and `tenantBrand` (the doing-business-as / brand
  // name that customers see, e.g. "ABC LLC dba Cream Stone").
  tenantName             String
  tenantLegalName        String?
  tenantBrand            String?
  // tenantContact is the contact PERSON's name; email/phone are separate so they can be
  // validated and displayed as links. Note: tenants are never notified by the platform —
  // notifications are strictly internal (they only ever address User rows).
  tenantContact          String?
  tenantEmail            String?
  tenantPhone            String?
  // The CONTRACTED headline rent — deliberately NOT mirrored from the active rent
  // period. Mirroring was the original plan but is wrong: a lease inside a free-rent
  // period has an effective rent of 0, so mirroring would zero this field and the next
  // schedule regeneration would derive a zero schedule from it. What a tenant actually
  // owes in a given month comes from LeaseRentPeriod (see LeasesService.getRentRoll,
  // which returns both the effective and the contracted totals).
  monthlyRent            Decimal   @db.Decimal(12, 2)
  rentPerSqft            Decimal?  @db.Decimal(8, 2)
  // NNN quoted the way it is actually negotiated — a rate per sqft, charged ONCE at
  // lease signing (client-confirmed 2026-08-12). `nnnTotalAmount` is derived from the
  // rate against the unit's area and is overridable for leases quoted as a flat sum.
  //
  // These are the lease's headline TERMS, exactly like `securityDeposit`. The money is
  // tracked as a LeaseObligation of kind NNN, which is what records what was actually
  // collected. NNN was previously a monthly component of rent; see the migration note
  // on 20260812160000_nnn_one_time for why it moved.
  nnnPerSqft             Decimal?  @db.Decimal(8, 2)
  nnnTotalAmount         Decimal?  @db.Decimal(12, 2)
  // Legal commencement — when the lease binds.
  leaseStart             DateTime
  // Rent commencement. Null = rent starts at leaseStart (every lease before this column
  // existed). Distinct because a tenant fitting out for three months owes nothing during
  // it: the schedule and the invoice ledger both begin HERE, not at leaseStart.
  rentStartDate          DateTime?
  // Term expiry — the rent end date.
  leaseEnd               DateTime
  // Derived from (rentStartDate ?? leaseStart) → leaseEnd on write. Was hand-entered and
  // unvalidated, so it could silently disagree with the dates while still driving the
  // effective-rent KPI (summariseEffectiveRent prefers it over what the periods cover).
  termMonths             Int
  escalationPct          Decimal?  @db.Decimal(5, 2)
  escalationFreq         Int? // months between escalations
  securityDeposit        Decimal?  @db.Decimal(12, 2)
  // Agreed tenant-improvement allowance — money Prime owes the TENANT, the one headline
  // term that points outward. Like securityDeposit and nnnTotalAmount this is the TERM;
  // what was actually disbursed lives on the matching LeaseObligation, which is where
  // the phased draw-downs are recorded.
  tiAllowance            Decimal?  @db.Decimal(14, 2)
  // Rent abatement. Free months sit INSIDE the term — leaseEnd is unchanged and the
  // escalation clock still runs from leaseStart, so derived dates never contradict the
  // signed contract. The generator emits these months as isFreeRent periods at rent 0.
  freeRentMonths         Int?
  freeRentStartDate      DateTime?
  // Day of month rent falls due (1-31). Null = the 1st. Per-lease because Prime's
  // leases genuinely differ (5th, 10th); the invoice generator clamps to the last
  // day of short months so a "31st" lease still bills correctly in February.
  rentDueDay             Int?
  status                 String    @default("DRAFT")
  notes                  String?
  // ---- Tenancy transition (T1) ----
  // When occupancy ACTUALLY ended. Null = the lease is running, or ran, to leaseEnd.
  //
  // Deliberately distinct from leaseEnd, which stays the CONTRACTED expiry. The gap
  // between them IS the early-termination exposure, and it is read by things that must
  // not be told a different story: effective-rent straight-lining and
  // brokerCommissionBasis = TOTAL_TERM_RENT are both computed from the signed term.
  // Truncating leaseEnd on an early exit would silently restate a commission someone
  // may already have been paid.
  //
  // The `lease_unit_no_overlap` exclusion constraint ranges over
  // COALESCE(terminationDate, leaseEnd) for the same reason: the unit is free from the
  // move-out date, but the contract still says what it said.
  // Holdover rate as a PERCENTAGE of the last paying rent, for months occupied after
  // leaseEnd. 100 = the same rent, which is the client's answer (2026-08-13).
  //
  // NULL = do not bill holdover on this lease, and it is the default DELIBERATELY. The
  // system cannot tell a genuine holdover from a lease nobody closed — both are ACTIVE,
  // past leaseEnd, with no terminationDate — and invoices are permanent once generated.
  // So the notification fires for every holdover, and billing waits for a person to say
  // so. See migration 20260813190000_holdover_opt_in.
  //
  // A rate rather than a boolean so 125-150% (the commoner commercial practice, charged
  // to discourage overstaying) is later data entry rather than a code change.
  holdoverRatePct        Decimal?  @db.Decimal(6, 2)
  // Entered by hand after the fact (H2 backfill) rather than recorded as it happened.
  // Deleting one of these needs Founder approval — see HistoricalRecordDeletion — because
  // it takes a whole settled ledger with it, and nothing in the system witnessed the
  // tenancy to reconstruct it from.
  isHistorical           Boolean   @default(false)
  terminationDate        DateTime?
  // EXPIRED | NON_RENEWAL | EARLY_TERMINATION | EVICTION | MUTUAL |
  // LANDLORD_TERMINATED | RENEWED | RELOCATED | ASSIGNED | TENANT_BOUGHT
  terminationReason      String?
  terminationNote        String?
  // The lease that CONTINUES this tenancy. Set for a renewal (successor on the same
  // unit) or a relocation (successor on a different unit); null for a genuine turnover
  // where an unrelated tenant follows.
  //
  // Continuity is DERIVED from this plus unitId rather than stored as its own flag —
  // one less pair of fields that can disagree. UnitHistoryService reads it to suppress
  // the phantom vacancy entry between two linked leases.
  //
  // @unique so two leases cannot both claim the same successor. Cycles are rejected in
  // the service, the same way Milestone.dependsOnId is.
  successorLeaseId       String?   @unique
  successorLease         Lease?    @relation("LeaseSuccession", fields: [successorLeaseId], references: [id], onDelete: SetNull)
  predecessorLease       Lease?    @relation("LeaseSuccession")
  // ---- Leasing commission (R23) ----
  // Mirrors the Sale shape rather than inventing a second pattern: same field names,
  // same "stamped when the deal completes" rule (activation here, close there).
  //
  // `brokerCommissionBasis` has no equivalent on Sale because a sale has one obvious
  // base — the price. A lease does not: the fee can be the first month's rent, a
  // percentage of the whole term, or flat, and Prime has not yet said which (Q12). It
  // is therefore recorded PER LEASE rather than assumed, so the answer is data entry
  // and not a code change — and when it is absent nothing is computed, rather than a
  // guess being silently stamped.
  brokerId               String?
  broker                 Broker?   @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  brokerCommissionPct    Decimal?  @db.Decimal(5, 2) // per-lease override of Broker.commissionRate
  brokerCommissionAmt    Decimal?  @db.Decimal(14, 2) // computed + stored on activation
  brokerCommissionBasis  String? // FIRST_MONTH_RENT | TOTAL_TERM_RENT | FLAT
  brokerCommissionPaidAt DateTime? // set when the broker is actually paid
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime? // soft-delete

  interiorProjects  InteriorProject[]
  rentPeriods       LeaseRentPeriod[]
  rentCorrections   LeaseRentPeriodCorrection[]
  obligations       LeaseObligation[]
  rentInvoices      LeaseRentInvoice[]
  tenantAssignments LeaseTenantAssignment[]
  deletionRequests  HistoricalRecordDeletion[]

  @@index([unitId])
  @@index([buildingId])
  @@index([status, leaseEnd])
  @@index([deletedAt])
  @@index([terminationDate])
  @@map("leases")
}

// ============================================================================
// Deletion approval for backfilled history (R27).
//
// Client decision 2026-08-12 (Q2, option b): Sales may create and edit historical
// records; only a Founder may delete one. Modelled on Sale.discountApprovedBy — the
// existing precedent for "this action needs someone senior to agree" — rather than
// inventing a second approval shape.
//
// Why deletion specifically: a backfilled tenancy carries a complete rent ledger that a
// person typed in from records the system never saw. Deleting it destroys data that
// cannot be regenerated, unlike a live lease whose schedule can always be rebuilt from
// its terms.
// ============================================================================

model HistoricalRecordDeletion {
  id            String    @id @default(cuid())
  leaseId       String
  lease         Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  /// PENDING | APPROVED | REJECTED | CANCELLED | COMPLETED
  status        String    @default("PENDING")
  /// Mandatory. Same rule as BudgetRevision: a destructive act with no stated reason is
  /// not auditable.
  reason        String
  requestedById String
  requestedBy   User      @relation("HistoricalDeletionRequester", fields: [requestedById], references: [id])
  requestedAt   DateTime  @default(now())
  decidedById   String?
  decidedBy     User?     @relation("HistoricalDeletionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?

  @@index([leaseId, status])
  @@index([status, requestedAt])
  @@map("historical_record_deletions")
}

// ============================================================================
// Tenant assignment / novation (T1).
//
// The fourth kind of "the unit changed hands", and the only one where the LEASE
// DOCUMENT SURVIVES. The business is sold, or the tenant restructures its entity, and
// a new party steps into the existing contract. The rent periods, the invoice ledger
// and the obligations continue untouched — that is the definition of an assignment,
// and it is why this is not modelled as terminate-and-recreate like the other three.
//
// It needs its own table because otherwise the only record of the change is the audit
// interceptor's `newValues`, which is the WHOLE submitted form body and therefore
// cannot say what changed — the same limitation that forced LeasesService
// .recordLeaseChanges to diff against the stored row.
//
// Without this, editing Lease.tenantName in place silently rewrites history: last
// year's invoices would appear to have been billed to a tenant that did not yet exist.
// This table is what answers "who was the tenant on date X".
// ============================================================================

model LeaseTenantAssignment {
  id                  String    @id @default(cuid())
  leaseId             String
  lease               Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  /// When the assignment takes legal effect — not when it was typed in.
  effectiveDate       DateTime
  /// The outgoing party, snapshotted. Denormalised on purpose: the lease row only ever
  /// holds the CURRENT tenant, so without a copy here the previous name is gone.
  fromTenantName      String
  fromTenantLegalName String?
  toTenantName        String
  toTenantLegalName   String?
  toTenantContact     String?
  toTenantEmail       String?
  toTenantPhone       String?
  /// BUSINESS_SALE | NOVATION | ENTITY_RESTRUCTURE | OTHER
  reason              String?
  note                String?
  /// The executed assignment agreement, if it has been uploaded.
  documentId          String?
  document            Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  recordedById        String?
  recordedBy          User?     @relation("LeaseAssignmentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())

  @@index([leaseId, effectiveDate])
  @@map("lease_tenant_assignments")
}

// ============================================================================
// Lease rent timeline.
//
// One table for what would naively be three: the escalation SCHEDULE, the rent
// HISTORY, and free-rent months. They are the same timeline — an escalation is
// known the day the lease is signed, so "schedule" is just the part after today
// and "history" the part before. Splitting them means storing each rent twice
// and reconciling forever.
//
// Rules (client-confirmed 2026-07-29):
//   - escalation COMPOUNDS: baseRent = previous period's baseRent x (1 + pct)
//   - escalation applies to baseRent ONLY; nnnAmount carries forward untouched
//     and is edited by hand each year
//   - past periods are immutable; edits regenerate FUTURE periods only
//     (append-only, same rule as BudgetRevision)
// ============================================================================

model LeaseRentPeriod {
  id            String    @id @default(cuid())
  leaseId       String
  lease         Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  sequence      Int // 1 = initial term
  startDate     DateTime
  endDate       DateTime? // null = runs to lease end
  baseRent      Decimal   @db.Decimal(12, 2) // the rent portion — this is what escalates
  // Invariant enforced in LeaseRentPeriodService: monthlyRent == baseRent.
  //
  // The two were separated by an `nnnAmount` column until 2026-08-12, when the client
  // confirmed NNN is charged once at signing rather than monthly. Rent is now base rent
  // and nothing else; NNN lives on LeaseObligation.
  monthlyRent   Decimal   @db.Decimal(12, 2)
  isFreeRent    Boolean   @default(false) // abatement month -> monthlyRent 0
  escalationPct Decimal?  @db.Decimal(5, 2) // pct applied vs the PREVIOUS period
  source        String // INITIAL | AUTO_ESCALATION | MANUAL | FREE_RENT
  reason        String? // required when source = MANUAL
  createdById   String?
  createdBy     User?     @relation("LeaseRentPeriodCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  invoices    LeaseRentInvoice[]
  corrections LeaseRentPeriodCorrection[]

  @@unique([leaseId, sequence])
  @@index([leaseId, startDate])
  @@map("lease_rent_periods")
}

// ============================================================================
// R22 — correcting a rent period that has already been billed.
//
// Past periods are immutable by default (client instruction 2026-07-29): invoices are
// generated against them, so silently editing one changes what a tenant was billed with
// no trace. But "immutable" and "we typed 1,500 when the lease says 1,550" cannot both
// be final, so a correction is a RECORDED ACT rather than an edit — the period moves and
// this row preserves what it moved from, who moved it, and why.
//
// Deliberately not a generic audit row: the audit log records the raw request, while this
// carries the two numbers side by side, which is the only shape Finance can reconcile a
// ledger against.
// ============================================================================
model LeaseRentPeriodCorrection {
  id                 String          @id @default(cuid())
  periodId           String
  period             LeaseRentPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  /// Denormalised so a lease's whole correction history is one query, and so it survives
  /// as context if the period is ever regenerated away.
  leaseId            String
  lease              Lease           @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  /// What it was, and what it became. Both kept — the original value is never lost, which
  /// is the entire justification for allowing the change at all.
  previousRent       Decimal         @db.Decimal(12, 2)
  correctedRent      Decimal         @db.Decimal(12, 2)
  /// Optional: a correction may move the dates rather than the money.
  previousStartDate  DateTime?
  correctedStartDate DateTime?
  previousEndDate    DateTime?
  correctedEndDate   DateTime?
  /// Mandatory. Same rule as BudgetRevision — a change to a billed figure with no stated
  /// reason cannot be reconciled by anyone who was not in the room.
  reason             String
  /// How many already-generated invoices this correction put out of step with the
  /// schedule. Stored rather than recomputed: it is the number that was true at the
  /// moment of the correction, and re-deriving it later gives a different answer.
  invoicesFlagged    Int             @default(0)
  correctedById      String
  correctedBy        User            @relation("LeaseRentPeriodCorrector", fields: [correctedById], references: [id])
  createdAt          DateTime        @default(now())

  @@index([leaseId, createdAt])
  @@index([periodId])
  @@map("lease_rent_period_corrections")
}

// ============================================================================
// Lease obligations — an agreed total paid down by discrete payments.
//
// Security deposit (tenant -> Prime) and TI allowance (Prime -> tenant) are the
// same shape, so they share one model rather than two near-identical services
// and two near-identical UI panels. Mirrors SalePayment on the sales side.
//
//   - deposit: ONE obligation at whatever level the lease sits at (unit or
//     building). Never split across units — roll up for display only.
//   - TI allowance: a fixed agreed amount (NOT a percentage), disbursed in
//     phases as multiple LeaseObligationPayment rows.
// ============================================================================

model LeaseObligation {
  id          String    @id @default(cuid())
  leaseId     String
  lease       Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  kind        String // SECURITY_DEPOSIT | TI_ALLOWANCE | OTHER
  direction   String // FROM_TENANT | TO_TENANT
  totalAmount Decimal   @db.Decimal(14, 2)
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING | PARTIAL | SETTLED | WAIVED
  // Mirror of sum(payments.amount), maintained by the service so list queries
  // don't need an aggregate. pending = totalAmount - paidAmount.
  paidAmount  Decimal   @default(0) @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments LeaseObligationPayment[]

  @@index([leaseId, kind])
  @@index([status, dueDate])
  @@map("lease_obligations")
}

model LeaseObligationPayment {
  id           String          @id @default(cuid())
  obligationId String
  obligation   LeaseObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  amount       Decimal         @db.Decimal(14, 2)
  paidAt       DateTime
  method       String? // WIRE | CHECK | ACH | CASH | ADJUSTMENT
  reference    String? // check no / wire ref
  documentId   String? // receipt in the doc vault
  notes        String?
  recordedById String?
  recordedBy   User?           @relation("LeaseObligationPaymentRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([obligationId])
  @@map("lease_obligation_payments")
}

// ============================================================================
// Monthly rent collection ledger.
//
// LeaseRentPeriod says what a tenant OWES; this says what they PAID. One row per
// month per lease, GENERATED from the covering period — never hand-created, so a
// unit's payment history can have no unexplained gaps. Free-rent months generate
// rows too (amountDue 0, status FREE) for exactly that reason.
//
// The @@unique([leaseId, periodMonth]) makes generation idempotent: the monthly
// cron can re-run safely.
// ============================================================================

model LeaseRentInvoice {
  id           String           @id @default(cuid())
  leaseId      String
  lease        Lease            @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  periodId     String?
  period       LeaseRentPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  /// First day of the billed month (UTC), the natural key alongside leaseId.
  periodMonth  DateTime
  dueDate      DateTime
  amountDue    Decimal          @db.Decimal(12, 2)
  amountPaid   Decimal          @default(0) @db.Decimal(12, 2)
  /// True when the month was billed pro-rata (partial first/last month).
  isProrated   Boolean          @default(false)
  /// Days billed vs days in month — kept so a prorated figure can be explained.
  billedDays   Int?
  monthDays    Int?
  paidAt       DateTime?
  /// DUE | PARTIAL | PAID | FREE | WAIVED | VOID
  ///
  /// VOID is NOT the same as WAIVED and must not be folded into it. WAIVED is a Finance
  /// decision — money that WAS owed and was forgiven, which belongs in concession
  /// reporting. VOID means the tenancy had already ended and the month was never owed
  /// at all. Collapsing the two puts phantom concessions in the numbers.
  status       String           @default("DUE")
  voidReason   String?
  voidedAt     DateTime?
  /// Set when the period this was billed from was corrected AFTER the invoice existed.
  /// Not auto-corrected: the invoice records what was actually billed, and only Finance
  /// can decide whether to re-issue, credit, or leave it. Cleared when they decide.
  needsReview  Boolean          @default(false)
  reviewReason String?
  method       String?
  reference    String?
  notes        String?
  recordedById String?
  recordedBy   User?            @relation("LeaseRentInvoiceRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([leaseId, periodMonth])
  @@index([leaseId, periodMonth])
  @@index([status, dueDate])
  @@map("lease_rent_invoices")
}

