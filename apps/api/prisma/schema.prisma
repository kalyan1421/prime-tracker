// ---- Marketing Leads ----

enum LeadSource {
  WEBSITE
  SOCIAL_MEDIA
  REFERRAL
  COLD_CALL
  WALK_IN
  SIGNAGE
  EMAIL_CAMPAIGN
  BROKER
  LOOPNET
  CREXI
  OTHER
}

enum LeadActivityType {
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  FOLLOW_UP
  NOTE
  STATUS_CHANGE
}

model Lead {
  id                String     @id @default(cuid())
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source            LeadSource
  name              String?
  email             String?
  phone             String?
  notes             String?
  status            String     @default("NEW")
  // Polymorphic asset link — a lead can be interested in a specific Unit OR a
  // whole Building (e.g. an enterprise tenant inquiring about Leander Bldg 1).
  // Service layer enforces "at most one of (unitId, buildingId)" — both can be
  // null for project-level leads with no specific asset yet.
  unitId            String?
  unit              Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  buildingId        String?
  building          Building?  @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unitInterest      String?
  budget            Decimal?   @db.Decimal(14, 2)
  assignedTo        String?
  assignedUser      User?      @relation("LeadAssignee", fields: [assignedTo], references: [id])
  convertedToSaleId String?    @unique
  convertedToSale   Sale?      @relation(fields: [convertedToSaleId], references: [id])
  // Sprint 2 — Campaign attribution:
  //   campaignId — explicit named-campaign tag (e.g. "Spur Plaza Diwali Launch 2026")
  //   utm*       — raw passthrough from the web form / landing-page URL; preserved
  //                even when the campaign cannot be resolved server-side, so the
  //                attribution can be reconstructed later if a Campaign is created
  //                retroactively to match the utmCampaign value.
  campaignId        String?
  campaign          Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  // Broker attribution — which broker brought this lead (internal-only).
  brokerId          String?
  broker            Broker?    @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  createdBy         String
  createdByUser     User       @relation("LeadCreator", fields: [createdBy], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  activities    LeadActivity[]
  documents     Document[]
  // Multi-unit interest: a lead can express interest in several units (and a unit can have
  // a waitlist of interested leads) — in addition to the single primary unit link above.
  unitInterests LeadUnitInterest[]

  @@index([projectId])
  @@index([status])
  @@index([assignedTo])
  @@index([unitId])
  @@index([buildingId])
  @@index([campaignId])
  @@index([brokerId])
  @@map("leads")
}

model LeadUnitInterest {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())

  @@unique([leadId, unitId])
  @@index([unitId])
  @@map("lead_unit_interests")
}

model LeadActivity {
  id            String           @id @default(cuid())
  leadId        String
  lead          Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type          LeadActivityType
  note          String
  createdBy     String
  createdByUser User             @relation("ActivityCreator", fields: [createdBy], references: [id])
  createdAt     DateTime         @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

// ---- Campaigns (Sprint 2: marketing-spend attribution) ----
//
// A Campaign is a named marketing effort (e.g. "Spur Plaza Diwali Launch 2026")
// that runs through one channel (Meta, Google Ads, Newspaper, Broker, …) and may
// or may not be tied to a single project. Spend is tracked through CampaignSpend
// ledger entries — append-only, never overwritten — so reconciliation between
// manual entries, agency reports, and platform APIs stays auditable.

enum CampaignChannel {
  META
  GOOGLE_ADS
  NEWSPAPER
  BROKER
  EMAIL
  SIGNAGE
  EVENT
  OTHER
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignSpendSource {
  MANUAL // entered by Marketing/Founder
  META_API // future Meta Marketing API sync
  GOOGLE_API // future Google Ads API sync
  AGENCY_REPORT // bulk import from agency monthly statement
}

model Campaign {
  id            String          @id @default(cuid())
  name          String
  channel       CampaignChannel
  // External platform ID (Meta Ad Set ID, Google Campaign ID) — used by future
  // API sync to match incoming spend entries back to this campaign.
  externalId    String?
  // Optional pre-allocated planned budget. Real spend lives in CampaignSpend.
  plannedBudget Decimal?        @db.Decimal(14, 2)
  status        CampaignStatus  @default(PLANNED)
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  createdBy     String
  createdByUser User            @relation("CampaignCreator", fields: [createdBy], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime? // soft-delete preserves attribution history

  spend    CampaignSpend[]
  leads    Lead[]
  // Cross-project campaigns (Prime Developers brand campaign) leave this empty;
  // project-specific campaigns populate one row per linked project — a campaign
  // can span 0 (portfolio-wide), 1, or several projects.
  projects CampaignProject[]

  @@index([channel])
  @@index([status])
  @@index([externalId])
  @@index([deletedAt])
  @@map("campaigns")
}

model CampaignProject {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, projectId])
  @@index([campaignId])
  @@index([projectId])
  @@map("campaign_projects")
}

model CampaignSpend {
  id             String              @id @default(cuid())
  campaignId     String
  campaign       Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amount         Decimal             @db.Decimal(14, 2)
  currency       String              @default("USD")
  spentOn        DateTime
  source         CampaignSpendSource
  // Vendor reference — Meta invoice ID, Google line-item ID, agency report row.
  // Used to deduplicate spend entries when the same period is re-imported.
  externalRef    String?
  recordedBy     String
  recordedByUser User                @relation("CampaignSpender", fields: [recordedBy], references: [id])
  createdAt      DateTime            @default(now())

  // Same campaign+source+externalRef must be unique to prevent double-import.
  // External APIs sending the same row twice will hit this constraint.
  @@unique([campaignId, source, externalRef], map: "campaign_spend_dedupe")
  @@index([campaignId])
  @@index([spentOn])
  @@index([source])
  @@map("campaign_spend")
}

// ---- Notifications ----

enum NotificationType {
  MILESTONE_OVERDUE
  LEASE_EXPIRING_30
  LEASE_EXPIRING_7
  LOAN_MATURITY_60
  COMMENT_FINANCIAL
  COMMENT_SALES
  COMMENT_MARKETING
  DRAW_REQUEST_SUBMITTED
  DRAW_REQUEST_APPROVED
  DRAW_REQUEST_FUNDED
  BUDGET_VARIANCE
  LEAD_ASSIGNED
  LEAD_STATUS_CHANGED
  // Interior fit-out + sale-payment schedule triggers
  INTERIOR_PHASE_CHANGED
  INTERIOR_HANDOVER_DUE
  SNAG_OVERDUE
  PAYMENT_DUE_7
  PAYMENT_OVERDUE
  // Draw past its expectedFundingDate. Previously these alerts were filed under
  // BUDGET_VARIANCE, which meant muting budget alerts also muted funding alerts.
  DRAW_FUNDING_OVERDUE
  // Leasing depth triggers. These must stay in sync with
  // migrations/20260729120000_add_notification_types_l3 — a value present in the DB
  // but missing here is invisible to Object.values(NotificationType), which means it
  // never appears in getPreferences() and users cannot mute it.
  UNIT_SOLD
  LEASE_ADDED
  LEASE_ACTIVATED
  LEASE_TERMINATED
  LEASE_RENT_CHANGED
  FREE_RENT_ENDING_30
  DEPOSIT_OUTSTANDING
  TI_DISBURSED
  RENT_OVERDUE
  // Someone was @mentioned by name in a comment. Distinct from COMMENT_* (which routes
  // by department) because it is addressed at one person, so it is ACTION-tier and
  // reaches them whether or not they follow that comment's department.
  COMMENT_MENTION
  /// A work item was assigned to you. ACTION-tier like COMMENT_MENTION: it names one
  /// person and asks them to do something, so it is not filed under a department feed.
  /// Assigning work told nobody at all before this existed.
  TASK_ASSIGNED
  /// Somebody asked to delete a backfilled tenancy (R27). Leadership-routed: the whole
  /// point of the gate is that a second person looks before history is erased.
  HISTORY_DELETION_REQUESTED
  /// The decision came back. Addressed at the person who raised the request — a request
  /// that is silently approved or rejected is the same as no answer at all.
  HISTORY_DELETION_DECIDED
  /// A tenant is occupying past their contracted end with no move-out recorded.
  /// Leadership-routed at the client's request (2026-08-13) because it is a commercial
  /// decision — renew, end it, or let it run — not a task for whoever is on the unit.
  LEASE_HOLDOVER
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  /// Stable identity of the CONDITION this alert is about, e.g. "invoice:<id>".
  ///
  /// Recurring alerts are re-raised by the daily cron for as long as the condition
  /// holds, and are suppressed while the recipient already has that alert pending. The
  /// suppression originally keyed on `title`, which silently did nothing for the seven
  /// types whose title carries a live day counter ("Rent overdue (29d): …" becomes
  /// "(30d)" tomorrow) — that is 2,150 of the 2,288 rows in the first backlog. The key
  /// has to be something that does NOT change as the condition ages.
  ///
  /// Null for one-off events, which are never deduplicated.
  dedupeKey String?

  @@index([userId, readAt])
  @@index([createdAt])
  // Serves the suppression lookup: userId IN (…) AND type = … AND dedupeKey = …
  @@index([userId, type, dedupeKey])
  @@map("notifications")
}

model NotificationPreference {
  id           String           @id @default(cuid())
  // emailEnabled is NULLABLE on purpose: null means "use this notification type's
  // tier default" (action-needed types email, FYI types are in-app only). An
  // explicit true/false is a deliberate per-user override in either direction.
  emailEnabled Boolean?
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  enabled      Boolean          @default(true)

  @@unique([userId, type])
  @@map("notification_preferences")
}

