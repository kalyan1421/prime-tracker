// ---- Custom Options (admin-configurable dropdown values) ----

model CustomOption {
  id          String   @id @default(cuid())
  category    String // e.g. "project_phase", "unit_status", "sale_status"
  value       String // slug stored in DB, e.g. "INTERIOR_FITOUT"
  label       String // display label, e.g. "Interior Fit-Out"
  color       String? // tailwind color token, e.g. "blue", "amber"
  sortOrder   Int      @default(0)
  isSystem    Boolean  @default(false) // system defaults cannot be deleted
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  // @default(now()) as well as @updatedAt: the database carries the default and dropping it
  // would leave a NOT NULL column with no value for any INSERT that does not go through
  // Prisma (a migration backfill, a psql fix-up).
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([category, value])
  @@index([category, isActive])
  @@map("custom_options")
}

// ---- Unit Construction Checklist ----
//
// A FIXED, ORDERED stage list per unit (e.g. "01 - Contracts" .. "22 - Final Inspection"),
// distinct from the Task/TaskUnit "Construction Updates Board": that board is ad-hoc work
// items with day-wise updates (see model Task below); this is a template-driven progress
// checklist, one row per stage per unit, with its own inspection tracking. Client-confirmed
// 2026-08-21 as a NEW system rather than an extension of Task.
//
// `status` and `inspectionStatus` are CustomOption categories ("construction_stage_status",
// "construction_inspection_status") — same pattern as task_status/task_priority, so orgs can
// relabel or add values without a schema change.

/// ============================================================================
/// Versioned checklist templates, keyed by work type (Phase 2).
///
/// The client's monday board seeds a unit's checklist by copying a list, and records
/// NOTHING about where the copy came from. The result, measured on the live board:
/// five different step lists in circulation — a 22-step interior list, an unnumbered
/// misspelled twin of it, an 18-step shell list, a 16-step dot-numbered variant of THAT,
/// and a fifth 14-step list that its automations actually create for every new unit. No
/// one can tell which units are comparable, because nothing says which list they came from.
///
/// `ConstructionStageTemplateItem` below has the same hole: it is keyed to a Building,
/// is unversioned, and its copy onto a unit is one-way and never reconciled. It survives
/// as a per-building OVERRIDE (a building with genuinely bespoke stages), but the default
/// path is now work type -> active template -> stamped onto the unit.
///
/// Templates are immutable once units point at them. Editing a live template mints a new
/// VERSION and deactivates the old one; existing units keep their stamp and their stages.
/// Same "past is immutable" rule as BudgetRevision and LeaseRentPeriod.
/// ============================================================================
model ChecklistTemplate {
  id       String  @id @default(cuid())
  name     String
  /// CustomOption category "work_type" — 'SHELL' | 'INTERIOR_FINISHOUT' | 'PERMIT'.
  workType String
  version  Int
  /// Exactly one active version per work type is the intended state, enforced in service
  /// (a partial unique index can't be expressed in Prisma's schema language).
  isActive Boolean @default(true)

  createdById String?
  createdBy   User?    @relation("ChecklistTemplateCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps ChecklistTemplateStep[]
  units Unit[]

  @@unique([workType, version])
  @@index([workType, isActive])
  @@map("checklist_templates")
}

model ChecklistTemplateStep {
  templateId         String
  template           ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// 1-based. The board encodes step order in the NAME ("01 - Framing"), which is why its
  /// one unnumbered unit sorts correctly by luck and breaks every name-based join.
  stepNo             Int
  label              String
  /// Drives whether the inspection columns are even offered on this stage. On the board
  /// every stage carries them and 537 of 540 rows leave them empty.
  requiresInspection Boolean           @default(false)

  @@id([templateId, stepNo])
  @@map("checklist_template_steps")
}

model ConstructionStageTemplateItem {
  id          String   @id @default(cuid())
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  sortOrder   Int
  label       String
  // Templates are append-only from the UI's perspective: adding a stage here only affects
  // units CREATED AFTER the change (see UnitsService) — existing units' checklists are
  // copied once and never retroactively resynced, same "past is immutable" rule used for
  // BudgetRevision and LeaseRentPeriod elsewhere in this schema.
  createdById String?
  createdBy   User?    @relation("ConstructionStageTemplateCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([buildingId, sortOrder])
  @@map("construction_stage_template_items")
}

/// Photos attached directly to a checklist stage — "here is the rough electrical, signed
/// off". Distinct from DailyLogPhoto, which belongs to a dated site update: this one is
/// evidence for a step, not a record of a day. Same storage path shape and the same signed
/// URL treatment on read.
model UnitConstructionStagePhoto {
  id           String                @id @default(cuid())
  stageId      String
  stage        UnitConstructionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  storagePath  String
  caption      String?
  uploadedById String?
  uploadedBy   User?                 @relation("StagePhotoUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime              @default(now())

  @@index([stageId])
  @@map("unit_construction_stage_photos")
}

model UnitConstructionStage {
  id               String                       @id @default(cuid())
  unitId           String
  unit             Unit                         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  sortOrder        Int
  label            String
  status           String                       @default("NOT_STARTED")
  ownerId          String?
  owner            User?                        @relation("UnitConstructionStageOwner", fields: [ownerId], references: [id])
  inspectionStatus String?
  inspectionDate   DateTime?
  // Per-stage scheduling. The board's subitem Timeline column is used on 17 of 540 rows —
  // sparse, but real, unlike the parent-level Timeline column which is used on 0 of 25 and
  // is deliberately not ported.
  startsOn         DateTime?
  endsOn           DateTime?
  notes            String?
  dailyLogs        DailyLog[]
  photos           UnitConstructionStagePhoto[]
  createdById      String?
  createdBy        User?                        @relation("UnitConstructionStageCreator", fields: [createdById], references: [id])
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([unitId, sortOrder])
  @@map("unit_construction_stages")
}

// ---- Tasks ----

model Task {
  id            String           @id @default(cuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// LEGACY single-building link, kept for the same reason as `unitId` below: existing
  /// rows, existing queries, and the board's group-by. Mirrored from `buildings` when an
  /// item covers exactly one building.
  buildingId    String?
  building      Building?        @relation(fields: [buildingId], references: [id])
  /// The real building link. Site work routinely spans buildings — one contractor doing
  /// the same job across B1 and B2 is one item, not two.
  buildings     TaskBuilding[]
  /// LEGACY single-unit link. Kept so existing rows and queries keep working, and
  /// maintained as a mirror of `units` when — and only when — an item covers exactly
  /// one unit. New code reads `units`; nothing should write both by hand, because
  /// dual-writing is how the two drift apart.
  unitId        String?
  unit          Unit?            @relation(fields: [unitId], references: [id])
  /// The real unit link. A single work item routinely covers several units at once
  /// ("UNITS 402,403,404" on the client's board), which a scalar unitId cannot say.
  units         TaskUnit[]
  /// TASK        — ordinary work item, what this table has always held
  /// CONSTRUCTION — a site/fit-out item on the construction board
  ///
  /// One table rather than two: Task already carries assignee, status, priority,
  /// comments, attachments and permissions, and a parallel module would duplicate
  /// every one of them. The discriminator exists so the two do not end up in the same
  /// list — a PM's site board and a cross-project admin to-do list are different views
  /// of different work, and mixing them makes both unusable.
  kind          String           @default("TASK")
  title         String
  description   String?
  status        String           @default("TODO")
  priority      String           @default("MEDIUM")
  dueDate       DateTime?
  /// LEGACY single-assignee link. Mirrored from `assignees` when exactly one person
  /// holds the item, so old filters and the `@@index([assignedTo])` keep working.
  assignedTo    String?
  assignedUser  User?            @relation("TaskAssignee", fields: [assignedTo], references: [id])
  /// The real assignee link. Site work is held by a crew, not an individual: the client's
  /// board routinely tags two or three people on one item, and a scalar cannot say that
  /// without someone being silently dropped.
  assignees     TaskAssignment[]
  createdBy     String
  createdByUser User             @relation("TaskCreator", fields: [createdBy], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  comments    TaskComment[]
  attachments TaskAttachment[]
  updates     TaskUpdate[]

  @@index([projectId])
  @@index([assignedTo])
  @@index([status])
  @@index([kind, projectId])
  @@map("tasks")
}

/// Which units a work item covers. Many-to-many because one item routinely spans
/// several units and one unit accumulates many items over a build.
///
/// NOT the same thing as UnitsService.combine(), which MERGES units — creates a new
/// summed-area unit and archives the sources behind mergedIntoId. These units stay
/// separate and keep their own leases, sales and rent history; only the WORK is shared.
/// A task covering several buildings. Same shape and same reasoning as TaskUnit.
model TaskBuilding {
  taskId     String
  buildingId String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@id([taskId, buildingId])
  @@index([buildingId])
  @@map("task_buildings")
}

/// A person holding a task. Carries `notifiedAt` so re-saving an item does not re-notify
/// everybody already on it — only somebody newly added hears about it.
model TaskAssignment {
  taskId     String
  userId     String
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User      @relation("TaskAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  notifiedAt DateTime?

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignments")
}

model TaskUnit {
  taskId String
  unitId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([taskId, unitId])
  @@index([unitId])
  @@map("task_units")
}

/// A dated progress update on a work item — the "Updates" column of the client's board.
///
/// Distinct from TaskComment, which is discussion. An update is a report of what
/// happened on site on a given DAY, and it is what the construction board is for.
model TaskUpdate {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// The day being REPORTED, which is not when it was typed. Site updates are written
  /// up in the evening or the next morning; dating them by createdAt would quietly
  /// shift the whole record. Same reason DailyLog.logDate exists.
  updateDate DateTime
  authorId   String
  author     User     @relation("TaskUpdateAuthor", fields: [authorId], references: [id])
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  photos TaskUpdatePhoto[]

  @@index([taskId, updateDate])
  @@map("task_updates")
}

model TaskUpdatePhoto {
  id           String     @id @default(cuid())
  taskUpdateId String
  taskUpdate   TaskUpdate @relation(fields: [taskUpdateId], references: [id], onDelete: Cascade)
  storagePath  String
  caption      String?
  uploadedAt   DateTime   @default(now())

  @@index([taskUpdateId])
  @@map("task_update_photos")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  uploadedById String
  uploadedBy   User     @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

// ---- Global Update Board ----
//
// An org-wide feed of updates/announcements — chat threads with status/priority/due date,
// distinct from the per-project Construction Updates Board (Task with kind=CONSTRUCTION).
// See docs/client-discovery/UPDATE_BOARD_DESIGN.md for why this is a NEW model rather than
// a third Task.kind: Task.projectId is required and every permission/notification path in
// that module assumes one, while this board is deliberately flat — visible to every
// internal role regardless of project membership or staffing. Project/Building/Unit are
// OPTIONAL TAGS for filtering/context only; they are not an access boundary the way Unit
// XOR Building is for Sale/Lease/Loan.

model UpdateBoardPost {
  id         String    @id @default(cuid())
  title      String
  body       String?
  // Free-text, CustomOption-backed. Deliberately reuses the "task_status"/"task_priority"
  // categories (custom-options.service.ts) instead of new ones — zero extra config to seed,
  // and orgs can still relabel either category independently since CustomOption values are
  // looked up by category string, not by which model wrote them.
  status     String    @default("TODO")
  priority   String    @default("MEDIUM")
  dueDate    DateTime?
  // Leadership-only in practice: UpdateBoardService rejects a pinned:true from anyone
  // whose role isn't SUPER_ADMIN/FOUNDER/EXECUTIVE, regardless of who created the post.
  pinned     Boolean   @default(false)
  // "Leadership Only" — hides the post from everyone except SUPER_ADMIN/FOUNDER/EXECUTIVE,
  // its own creator, and anyone explicitly tagged on it (assignments). Anyone who can create
  // a post can set this on their own; it only narrows the audience below what the post would
  // otherwise reach. See UpdateBoardService.assertVisible.
  restricted Boolean   @default(false)

  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  // [{ url, label }] — plain links, no join table. A single JSON column (array-shaped),
  // not a native Postgres array of Json: nothing else in this schema uses Json[], and a
  // scalar column keeps the "read the whole small list, rewrite the whole small list" access
  // pattern this field actually has.
  links Json @default("[]")

  createdById String
  createdBy   User      @relation("UpdateBoardPostCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Soft delete, consistent with Project/Building/Unit elsewhere in this schema.
  deletedAt   DateTime?

  assignments UpdateBoardAssignment[]
  attachments UpdateBoardAttachment[]
  comments    UpdateBoardComment[]

  @@index([projectId])
  @@index([buildingId])
  @@index([unitId])
  @@index([status])
  @@index([pinned, createdAt])
  @@index([deletedAt])
  @@index([restricted])
  @@map("update_board_posts")
}

/// A person tagged on a post. Carries `notifiedAt` so re-saving a post does not re-notify
/// everybody already on it — only somebody newly added hears about it. Same shape as
/// TaskAssignment.
model UpdateBoardAssignment {
  postId     String
  userId     String
  post       UpdateBoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User            @relation("UpdateBoardAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime        @default(now())
  notifiedAt DateTime?

  @@id([postId, userId])
  @@index([userId])
  @@map("update_board_assignments")
}

model UpdateBoardAttachment {
  id           String          @id @default(cuid())
  postId       String
  post         UpdateBoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  storagePath  String
  fileName     String
  mimeType     String?
  uploadedById String
  uploadedBy   User            @relation("UpdateBoardAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([postId])
  @@map("update_board_attachments")
}

/// The chat thread on a post.
model UpdateBoardComment {
  id        String          @id @default(cuid())
  postId    String
  post      UpdateBoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation("UpdateBoardCommentAuthor", fields: [authorId], references: [id])
  content   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([postId, createdAt])
  @@map("update_board_comments")
}

// Per-org configuration for thresholds and probabilities used by alerts and forecasts.
// Single row per org; created on org creation, lazily defaulted in code if missing.
model OrgSettings {
  orgId                        String       @id
  org                          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Sale stage probabilities — JSON map of SaleStatus → probability (0..1)
  // Example: { "PROSPECT": 0.10, "LOI_SIGNED": 0.35, "UNDER_CONTRACT": 0.75, "CLOSED": 1.0 }
  saleStageProbabilities       Json         @default("{\"PROSPECT\":0.10,\"LOI_SIGNED\":0.35,\"UNDER_CONTRACT\":0.75,\"CLOSED\":1.0,\"CANCELLED\":0.0}")
  unitStaleDaysThreshold       Int          @default(90) // unit AVAILABLE longer than this -> stale alert
  budgetVarianceAlertPct       Decimal      @default(10) @db.Decimal(5, 2) // actuals+commitments > budget*(1+pct/100)
  saleStageAgeAlertDays        Int          @default(30) // sale in same stage longer than this -> flag
  saleActivityDroughtDays      Int          @default(14) // no activity for N days -> flag
  drawFundingExpectedDays      Int          @default(14) // default expected funding window
  // Sale priced below the unit's asking price by more than this % needs Founder/Co-Founder approval.
  discountApprovalThresholdPct Decimal      @default(5) @db.Decimal(5, 2)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  @@map("org_settings")
}

// ============================================================================
// Interior / Fit-Out Module + Sale Payment Schedule
// (Phase 1 — see docs/client-discovery/TDD_Interior_and_SalePayment.md)
// All additive: new tables + new enums + nullable back-relations. No breaking changes.
// ============================================================================

enum InteriorPhase {
  DESIGN
  CLIENT_APPROVAL
  CITY_APPROVAL
  PROCUREMENT
  EXECUTION
  SNAGGING
  HANDOVER
}

enum InteriorStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum InteriorContractType {
  PER_SQFT // client default
  FIXED
  COST_PLUS
}

enum SnagStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SalePaymentStatus {
  SCHEDULED
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
  /// Void — the sale it belonged to was cancelled. Distinct from WAIVED, which means
  /// FORGIVEN: an installment on a dead sale was never owed, it was not let off.
  CANCELLED
}

enum SalePaymentTrigger {
  ON_SIGNING
  ON_MILESTONE
  FIXED_DATE
  ON_HANDOVER
}

// A post-shell interior fit-out engagement for a unit (or whole building).
// Owns the operational work (phases, scope, sub-contractor invoices, snags).
// The client-facing per-sqft price lives on the linked Sale as a SalePayment installment.
model InteriorProject {
  id                String                   @id @default(cuid())
  // Anchor — exactly one of (unitId, buildingId); service-enforced (mirrors Sale/Loan).
  unitId            String?
  unit              Unit?                    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  buildingId        String?
  building          Building?                @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  // Optional context links — "interior is part of the contract agreement".
  saleId            String?
  sale              Sale?                    @relation(fields: [saleId], references: [id])
  leaseId           String?
  lease             Lease?                   @relation(fields: [leaseId], references: [id])
  name              String
  status            InteriorStatus           @default(NOT_STARTED)
  phase             InteriorPhase            @default(DESIGN)
  pmId              String? // same PM pool — no new role
  pm                User?                    @relation("InteriorPM", fields: [pmId], references: [id])
  contractType      InteriorContractType     @default(PER_SQFT)
  ratePerSqft       Decimal?                 @db.Decimal(12, 2)
  area              Decimal?                 @db.Decimal(10, 2) // sqft used for pricing
  contractValue     Decimal?                 @db.Decimal(14, 2) // internal cost-to-build; client price is on Sale
  encryptedFields   String? // optional AES blob (open question — currently unused)
  packageTemplateId String?
  packageTemplate   InteriorPackageTemplate? @relation(fields: [packageTemplateId], references: [id])
  startDate         DateTime?
  targetEnd         DateTime?
  handoverAt        DateTime?
  handoverSignedBy  String? // client representative who signed off at handover
  handoverNotes     String?
  // Approval audit (construction team + city)
  clientApprovedAt  DateTime?
  cityApprovedAt    DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime? // soft-delete (matches Sale/Unit/Loan)

  scopeItems InteriorScopeItem[]
  snags      SnagItem[]
  invoices   InteriorInvoice[]
  documents  Document[]
  actuals    Actual[]

  @@index([unitId])
  @@index([buildingId])
  @@index([saleId])
  @@index([status, phase])
  @@index([deletedAt])
  @@map("interior_projects")
}

// Reusable fit-out package (the "2-3 generic options" clients pick from; otherwise custom).
model InteriorPackageTemplate {
  id                 String                @id @default(cuid())
  name               String
  description        String?
  defaultRatePerSqft Decimal?              @db.Decimal(12, 2)
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  items              InteriorPackageItem[]
  interiorProjects   InteriorProject[]

  @@index([deletedAt])
  @@map("interior_package_templates")
}

// A preset BOQ line on a package template; copied into InteriorScopeItem when applied.
model InteriorPackageItem {
  id                String                  @id @default(cuid())
  packageTemplateId String
  packageTemplate   InteriorPackageTemplate @relation(fields: [packageTemplateId], references: [id], onDelete: Cascade)
  description       String
  category          String?
  quantity          Decimal?                @db.Decimal(12, 2)
  unit              String?
  unitPrice         Decimal?                @db.Decimal(12, 2)
  sequence          Int                     @default(0)
  createdAt         DateTime                @default(now())

  @@index([packageTemplateId])
  @@map("interior_package_items")
}

// BOQ / scope line item; can be seeded from a package template.
model InteriorScopeItem {
  id                String          @id @default(cuid())
  interiorProjectId String
  interiorProject   InteriorProject @relation(fields: [interiorProjectId], references: [id], onDelete: Cascade)
  description       String
  category          String? // flooring | ceiling | MEP_ROUGH | MEP_FINISH | joinery
  quantity          Decimal?        @db.Decimal(12, 2)
  unit              String? // sqft | nos | lm
  unitPrice         Decimal?        @db.Decimal(12, 2)
  total             Decimal?        @db.Decimal(14, 2)
  createdAt         DateTime        @default(now())

  @@index([interiorProjectId])
  @@map("interior_scope_items")
}

// Sub-contractor invoice for an interior project. Mirrors into an Actual (tagged
// interiorProjectId) so the cashflow forecast + TI reporting see the outflow.
model InteriorInvoice {
  id                String          @id @default(cuid())
  interiorProjectId String
  interiorProject   InteriorProject @relation(fields: [interiorProjectId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor          @relation(fields: [vendorId], references: [id])
  amount            Decimal         @db.Decimal(14, 2)
  invoiceNo         String?
  invoiceDate       DateTime?
  paidAt            DateTime?
  status            String          @default("PENDING") // PENDING | APPROVED | PAID
  actualId          String? // paired Actual id (set when mirrored)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([interiorProjectId])
  @@index([vendorId])
  @@map("interior_invoices")
}

// Punch-list item. Attaches to an interior project and (later) reusable on construction milestones.
model SnagItem {
  id                String           @id @default(cuid())
  interiorProjectId String?
  interiorProject   InteriorProject? @relation(fields: [interiorProjectId], references: [id], onDelete: Cascade)
  milestoneId       String?
  milestone         Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  description       String
  room              String?
  assigneeId        String?
  assignee          User?            @relation("SnagAssignee", fields: [assigneeId], references: [id])
  status            SnagStatus       @default(OPEN)
  photoPath         String? // Supabase storage key — the "before" / defect shot
  /// Proof-of-fix ("after") photo — REQUIRED to resolve a snag (client, 2026-08-14).
  /// Deliberately a separate column from `photoPath`: overwriting the defect shot would
  /// destroy the before/after comparison that makes the punch-list record worth keeping.
  /// Cleared when a snag is reopened, so a re-fix cannot be signed off on the proof of a
  /// fix that demonstrably did not hold (the storage object itself is not deleted).
  afterPhotoPath    String?
  dueDate           DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([interiorProjectId, status])
  @@index([milestoneId])
  @@map("snag_items")
}

// An installment on a Sale. Supports BOTH a fixed dueDate and a milestone trigger.
// Feeds the cashflow forecast (inflows) and powers overdue-payment alerts.
model SalePayment {
  id                String             @id @default(cuid())
  saleId            String
  sale              Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  label             String // "Deposit", "Foundation draw", "TI / interior", "Handover"
  sequence          Int                @default(0)
  trigger           SalePaymentTrigger @default(FIXED_DATE)
  // Either a fixed date OR a milestone trigger (service enforces ≥1).
  dueDate           DateTime?
  milestoneId       String?
  milestone         Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  // Stamped from milestone.completedAt when an ON_MILESTONE payment's milestone completes.
  effectiveDueDate  DateTime?
  amount            Decimal            @db.Decimal(14, 2)
  percentOfPrice    Decimal?           @db.Decimal(5, 2)
  paidAmount        Decimal            @default(0) @db.Decimal(14, 2)
  paidAt            DateTime?
  status            SalePaymentStatus  @default(SCHEDULED)
  /// Set when a unit swap (S3) rebased the schedule and THIS installment already had
  /// money against it, so its amount could not be restated. The buyer is now over- or
  /// under-collected against the new price and a human has to decide what to do about
  /// it. Same pattern, and the same reasoning, as LeaseRentInvoice.needsReview (R22):
  /// paidAmount is a record of what a buyer actually handed over, and silently moving
  /// the figure it was paid against destroys the discrepancy Finance needs to see.
  needsReview       Boolean            @default(false)
  reviewReason      String?
  interiorProjectId String? // set when this installment is the TI / interior charge
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([saleId, sequence])
  @@index([milestoneId])
  @@index([status, effectiveDueDate])
  @@map("sale_payments")
}

// ============================================================================
// Daily Construction Logs (Phase 4) — the client's #1 pain point.
// A dated field log scoped to a project (and optionally a building), with photos.
// Mobile-first capture; reuses StorageService for photo storage keys.
// ============================================================================

model DailyLog {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  // Daily logs were building-level only, so per-unit fit-out progress had nowhere to
  // go and was written as free text into a building's log. Nullable: a site-wide log
  // (weather, crew count, concrete pour) genuinely is not about one unit.
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  logDate    DateTime // the day being logged (distinct from createdAt)
  /// How this update arrived: WEB | MOBILE | EMAIL | WHATSAPP.
  ///
  /// Deliberately NOT a CustomOption and NOT settable by the caller. The values map to code
  /// paths (an ingestion adapter each), not to an org taxonomy — adding a value here would
  /// not create a way for updates to arrive. And the whole worth of an "arrived by email"
  /// badge is that it cannot be claimed: the create endpoint ignores any client-supplied
  /// value and the server stamps it, so Phase 6's ingestion is the only thing that can
  /// produce EMAIL or WHATSAPP.
  source     String    @default("WEB")

  /// Threaded replies. One level only — a reply cannot itself be replied to (enforced in
  /// service). Site updates are a conversation about one event, not a forum; arbitrary
  /// nesting buys indentation and costs the ability to read a day at a glance.
  parentId String?
  parent   DailyLog?  @relation("DailyLogThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  DailyLog[] @relation("DailyLogThread")

  /// Optionally pins the update to one checklist stage, so "waiting on the electrician"
  /// hangs off Rough Electrical rather than floating in the feed. Nullable and expected to
  /// stay mostly null: most updates are about the unit, not one step of it.
  stageId   String?
  stage     UnitConstructionStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  authorId  String
  author    User                   @relation("DailyLogAuthor", fields: [authorId], references: [id])
  notes     String // work done / summary
  weather   String?
  crewCount Int?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  photos DailyLogPhoto[]

  @@index([projectId, logDate])
  @@index([buildingId])
  @@index([unitId, logDate])
  @@index([source])
  @@index([parentId])
  @@index([stageId])
  @@map("daily_logs")
}

model DailyLogPhoto {
  id          String   @id @default(cuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  storagePath String // Supabase Storage key
  caption     String?
  uploadedAt  DateTime @default(now())

  @@index([dailyLogId])
  @@map("daily_log_photos")
}

// ============================================================================
// Broker / Referral tracking (Phase 4)
// Internal-only — brokers have NO login. Brokers bring leads; commission is
// earned when an attributed sale closes (flat fee OR % of sale price).
// ============================================================================

model Broker {
  id             String    @id @default(cuid())
  name           String
  company        String?
  email          String?
  phone          String?
  // Either a default % of sale price OR a flat fee. A sale may override the % via
  // Sale.brokerCommissionPct. Service prefers: sale override % → commissionRate % → commissionFlat.
  commissionRate Decimal?  @db.Decimal(5, 2)
  commissionFlat Decimal?  @db.Decimal(14, 2)
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  leads                  Lead[]
  sales                  Sale[]
  leases                 Lease[]
  commissionInstallments CommissionInstallment[]

  @@index([isActive, deletedAt])
  @@map("brokers")
}

// ============================================================================
// Broker commission paid in installments (R7, 2026-08-22).
//
// Lease.brokerCommissionAmt / Sale.brokerCommissionAmt + a single brokerCommissionPaidAt
// modelled commission as ONE payment. Real deals split it — Prime's own historical rent
// roll routinely shows a "1st Commission paid" and a separate "2nd Commission" per lease,
// sometimes with only one of the two actually paid. This is a genuine gap in the LIVE
// model, not just an import concern — the broker report (BrokersService.report) needs it
// independent of the historical-import feature that surfaced it.
//
// brokerCommissionAmt keeps meaning the TOTAL contracted commission. Installments are how
// much of it has actually moved and when — same relationship SalePayment already has to
// Sale.salePrice, which this table deliberately mirrors rather than inventing a second
// installment shape.
// ============================================================================

model CommissionInstallment {
  id       String    @id @default(cuid())
  // Polymorphic — exactly one of (leaseId, saleId) is set, enforced by a CHECK constraint
  // (brand-new table, so unlike Sale's unit/building split there is no migration-era data
  // that needs the DB to tolerate both null).
  leaseId  String?
  lease    Lease?    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  saleId   String?
  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Denormalized from the parent's brokerId at creation time (immutable after) so the
  // broker report can group/sum directly on this table, the same way it already groups
  // Lease/Sale rows by brokerId — a join-through-relation groupBy is not something Prisma
  // supports cleanly, and this table exists partly to make that report query correct.
  brokerId String
  broker   Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  // 1st, 2nd, … in the order they were agreed. Not unique per parent — a corrected entry
  // can reuse a sequence number; ordering for display is (sequence, createdAt).
  sequence Int       @default(1)
  amount   Decimal   @db.Decimal(14, 2)
  // Null = not yet paid. This is the field the broker report now sums instead of treating
  // the whole commission as one paid/unpaid flag.
  paidAt   DateTime?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaseId])
  @@index([saleId])
  @@index([brokerId, paidAt])
  @@map("commission_installments")
}
