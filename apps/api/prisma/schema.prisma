// ---- Marketing Leads ----

enum LeadSource {
  WEBSITE
  SOCIAL_MEDIA
  REFERRAL
  COLD_CALL
  WALK_IN
  SIGNAGE
  EMAIL_CAMPAIGN
  BROKER
  LOOPNET
  CREXI
  OTHER
}


enum LeadActivityType {
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  FOLLOW_UP
  NOTE
  STATUS_CHANGE
}

model Lead {
  id                String     @id @default(cuid())
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source            LeadSource
  name              String?
  email             String?
  phone             String?
  notes             String?
  status            String @default("NEW")
  // Polymorphic asset link — a lead can be interested in a specific Unit OR a
  // whole Building (e.g. an enterprise tenant inquiring about Leander Bldg 1).
  // Service layer enforces "at most one of (unitId, buildingId)" — both can be
  // null for project-level leads with no specific asset yet.
  unitId            String?
  unit              Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  buildingId        String?
  building          Building?  @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unitInterest      String?
  budget            Decimal?   @db.Decimal(14, 2)
  assignedTo        String?
  assignedUser      User?      @relation("LeadAssignee", fields: [assignedTo], references: [id])
  convertedToSaleId String?    @unique
  convertedToSale   Sale?      @relation(fields: [convertedToSaleId], references: [id])
  // Sprint 2 — Campaign attribution:
  //   campaignId — explicit named-campaign tag (e.g. "Spur Plaza Diwali Launch 2026")
  //   utm*       — raw passthrough from the web form / landing-page URL; preserved
  //                even when the campaign cannot be resolved server-side, so the
  //                attribution can be reconstructed later if a Campaign is created
  //                retroactively to match the utmCampaign value.
  campaignId        String?
  campaign          Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  // Broker attribution — which broker brought this lead (internal-only).
  brokerId          String?
  broker            Broker?    @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  createdBy         String
  createdByUser     User       @relation("LeadCreator", fields: [createdBy], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  activities    LeadActivity[]
  documents     Document[]
  // Multi-unit interest: a lead can express interest in several units (and a unit can have
  // a waitlist of interested leads) — in addition to the single primary unit link above.
  unitInterests LeadUnitInterest[]

  @@index([projectId])
  @@index([status])
  @@index([assignedTo])
  @@index([unitId])
  @@index([buildingId])
  @@index([campaignId])
  @@index([brokerId])
  @@map("leads")
}

model LeadUnitInterest {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())

  @@unique([leadId, unitId])
  @@index([unitId])
  @@map("lead_unit_interests")
}

model LeadActivity {
  id            String           @id @default(cuid())
  leadId        String
  lead          Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type          LeadActivityType
  note          String
  createdBy     String
  createdByUser User             @relation("ActivityCreator", fields: [createdBy], references: [id])
  createdAt     DateTime         @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

// ---- Campaigns (Sprint 2: marketing-spend attribution) ----
//
// A Campaign is a named marketing effort (e.g. "Spur Plaza Diwali Launch 2026")
// that runs through one channel (Meta, Google Ads, Newspaper, Broker, …) and may
// or may not be tied to a single project. Spend is tracked through CampaignSpend
// ledger entries — append-only, never overwritten — so reconciliation between
// manual entries, agency reports, and platform APIs stays auditable.

enum CampaignChannel {
  META
  GOOGLE_ADS
  NEWSPAPER
  BROKER
  EMAIL
  SIGNAGE
  EVENT
  OTHER
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignSpendSource {
  MANUAL // entered by Marketing/Founder
  META_API // future Meta Marketing API sync
  GOOGLE_API // future Google Ads API sync
  AGENCY_REPORT // bulk import from agency monthly statement
}

model Campaign {
  id            String          @id @default(cuid())
  name          String
  channel       CampaignChannel
  // External platform ID (Meta Ad Set ID, Google Campaign ID) — used by future
  // API sync to match incoming spend entries back to this campaign.
  externalId    String?
  // Optional pre-allocated planned budget. Real spend lives in CampaignSpend.
  plannedBudget Decimal?        @db.Decimal(14, 2)
  status        CampaignStatus  @default(PLANNED)
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  createdBy     String
  createdByUser User            @relation("CampaignCreator", fields: [createdBy], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime? // soft-delete preserves attribution history

  spend CampaignSpend[]
  leads Lead[]
  // Cross-project campaigns (Prime Developers brand campaign) leave this empty;
  // project-specific campaigns populate one row per linked project — a campaign
  // can span 0 (portfolio-wide), 1, or several projects.
  projects CampaignProject[]

  @@index([channel])
  @@index([status])
  @@index([externalId])
  @@index([deletedAt])
  @@map("campaigns")
}

model CampaignProject {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([campaignId, projectId])
  @@index([campaignId])
  @@index([projectId])
  @@map("campaign_projects")
}

model CampaignSpend {
  id             String              @id @default(cuid())
  campaignId     String
  campaign       Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amount         Decimal             @db.Decimal(14, 2)
  currency       String              @default("USD")
  spentOn        DateTime
  source         CampaignSpendSource
  // Vendor reference — Meta invoice ID, Google line-item ID, agency report row.
  // Used to deduplicate spend entries when the same period is re-imported.
  externalRef    String?
  recordedBy     String
  recordedByUser User                @relation("CampaignSpender", fields: [recordedBy], references: [id])
  createdAt      DateTime            @default(now())

  // Same campaign+source+externalRef must be unique to prevent double-import.
  // External APIs sending the same row twice will hit this constraint.
  @@unique([campaignId, source, externalRef], map: "campaign_spend_dedupe")
  @@index([campaignId])
  @@index([spentOn])
  @@index([source])
  @@map("campaign_spend")
}

// ---- Notifications ----

enum NotificationType {
  MILESTONE_OVERDUE
  LEASE_EXPIRING_30
  LEASE_EXPIRING_7
  LOAN_MATURITY_60
  COMMENT_FINANCIAL
  COMMENT_SALES
  COMMENT_MARKETING
  DRAW_REQUEST_SUBMITTED
  DRAW_REQUEST_APPROVED
  DRAW_REQUEST_FUNDED
  BUDGET_VARIANCE
  LEAD_ASSIGNED
  LEAD_STATUS_CHANGED
  // Interior fit-out + sale-payment schedule triggers
  INTERIOR_PHASE_CHANGED
  INTERIOR_HANDOVER_DUE
  SNAG_OVERDUE
  PAYMENT_DUE_7
  PAYMENT_OVERDUE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  enabled Boolean          @default(true)

  @@unique([userId, type])
  @@map("notification_preferences")
}

// ---- Cash Flow ----

enum CashFlowType {
  INFLOW
  OUTFLOW
}

model CashFlowEntry {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  month     DateTime
  entryType CashFlowType
  category  String
  amount    Float
  isActual  Boolean      @default(true)
  notes     String?
  createdAt DateTime     @default(now())

  @@index([projectId, month])
  @@map("cash_flow_entries")
}

// ---- Vendors & Contracts ----

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  TERMINATED
}

enum ChangeOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

model Vendor {
  id               String            @id @default(cuid())
  name             String
  contactName      String?
  email            String?
  phone            String?
  trade            String?
  contracts        Contract[]
  interiorInvoices InteriorInvoice[]
  createdAt        DateTime          @default(now())

  @@map("vendors")
}

model Contract {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor            @relation(fields: [vendorId], references: [id])
  description    String
  originalAmount Float
  currentAmount  Float
  status         ContractStatus    @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  changeOrders   ChangeOrder[]
  payments       ContractPayment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([projectId])
  @@map("contracts")
}

model ChangeOrder {
  id          String            @id @default(cuid())
  contractId  String
  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number      Int
  description String
  amount      Float
  status      ChangeOrderStatus @default(PENDING)
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@map("change_orders")
}

model ContractPayment {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  amount     Float
  paidDate   DateTime
  notes      String?
  createdAt  DateTime @default(now())

  @@map("contract_payments")
}

// ---- Documents ----

enum DocCategory {
  GENERAL
  PERMIT
  CONTRACT
  FINANCIAL
  DRAWING
  PHOTO
  LEGAL
  // Phase 1 — sales lifecycle
  BROCHURE
  LOI
  DEED
  // Phase 1 — buyer-portal categories (visible to CLIENT role when isClientVisible)
  BOOKING_AGREEMENT
  RECEIPT
  NOC
  POSSESSION_CERTIFICATE
  // Interior / fit-out phase gates
  CITY_APPROVAL
  HANDOVER_CERTIFICATE
}

model Document {
  id                String            @id @default(cuid())
  projectId         String?
  project           Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId        String?
  building          Building?         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId            String?
  unit              Unit?             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  saleId            String?
  sale              Sale?             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Interior fit-out attachment (city-approval doc, handover certificate, etc.)
  interiorProjectId String?
  interiorProject   InteriorProject?  @relation(fields: [interiorProjectId], references: [id], onDelete: Cascade)
  // Current-version metadata. On replace, the prior values are copied into a DocumentVersion row.
  fileName          String
  fileUrl           String
  storagePath       String?
  fileSize          Int?
  mimeType          String?
  // First-class link target so Sales can paste a DocuSign / Drive URL instead of uploading.
  // Either fileUrl OR externalUrl will be populated (storagePath null when external).
  externalUrl       String?
  category          DocCategory       @default(GENERAL)
  // Phase 2 portal flag. Default false — promotion is always an explicit internal action.
  isClientVisible   Boolean           @default(false)
  versionNumber     Int               @default(1)
  uploadedById      String
  uploadedBy        User              @relation("DocumentUploader", fields: [uploadedById], references: [id])
  versions          DocumentVersion[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@index([projectId])
  @@index([buildingId])
  @@index([unitId])
  @@index([saleId])
  @@index([leadId])
  @@index([interiorProjectId])
  @@index([category, deletedAt])
  @@index([isClientVisible, deletedAt])
  @@index([deletedAt])
  @@map("documents")
}

// Archive of prior document versions. Created when a Document's file is replaced.
model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  fileName      String
  fileUrl       String
  storagePath   String?
  fileSize      Int?
  mimeType      String?
  externalUrl   String?
  notes         String?
  uploadedById  String
  uploadedBy    User     @relation("VersionUploader", fields: [uploadedById], references: [id])
  // When this version was originally uploaded as the live document.
  uploadedAt    DateTime
  // When this version was superseded (i.e., archived).
  archivedAt    DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

// ---- Buyer / Client Portal ----

enum ClientStatus {
  ONBOARDING
  ACTIVE
  COMPLETED
  TERMINATED
}

// A Client is a buyer who has been provisioned portal access after a Sale closes.
// Created automatically by SalesService when status -> CLOSED.
model Client {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation("ClientUser", fields: [userId], references: [id], onDelete: Cascade)
  saleId      String       @unique
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  unitId      String
  unit        Unit         @relation(fields: [unitId], references: [id])
  status      ClientStatus @default(ONBOARDING)
  invitedAt   DateTime?
  activatedAt DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([projectId])
  @@index([unitId])
  @@index([status, deletedAt])
  @@index([deletedAt])
  @@map("clients")
}

// ---- Investors ----

enum CapitalCallStatus {
  PENDING
  PAID
  OVERDUE
}

model Investor {
  id            String           @id @default(cuid())
  name          String
  email         String?          @unique
  phone         String?
  entityName    String?
  positions     EquityPosition[]
  capitalCalls  CapitalCall[]
  distributions Distribution[]
  createdAt     DateTime         @default(now())

  @@map("investors")
}

model EquityPosition {
  id           String   @id @default(cuid())
  investorId   String
  investor     Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pctOwnership Float
  committedAmt Float
  calledAmt    Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([investorId])
  @@index([projectId])
  @@map("equity_positions")
}

model CapitalCall {
  id         String            @id @default(cuid())
  investorId String
  investor   Investor          @relation(fields: [investorId], references: [id])
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id])
  amount     Float
  dueDate    DateTime
  paidDate   DateTime?
  status     CapitalCallStatus @default(PENDING)
  notes      String?
  createdAt  DateTime          @default(now())

  @@index([investorId])
  @@index([projectId])
  @@map("capital_calls")
}

model Distribution {
  id         String   @id @default(cuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id])
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  amount     Float
  distDate   DateTime
  distType   String
  notes      String?
  createdAt  DateTime @default(now())

  @@index([investorId])
  @@index([projectId])
  @@map("distributions")
}

// ---- Audit Log (Immutable) ----

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String // table/model name
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  // No updatedAt — immutable by design
  // No delete cascade — audit events are never deleted

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

// ---- Custom Options (admin-configurable dropdown values) ----

model CustomOption {
  id          String   @id @default(cuid())
  category    String   // e.g. "project_phase", "unit_status", "sale_status"
  value       String   // slug stored in DB, e.g. "INTERIOR_FITOUT"
  label       String   // display label, e.g. "Interior Fit-Out"
  color       String?  // tailwind color token, e.g. "blue", "amber"
  sortOrder   Int      @default(0)
  isSystem    Boolean  @default(false) // system defaults cannot be deleted
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, value])
  @@index([category, isActive])
  @@map("custom_options")
}

// ---- Tasks ----

model Task {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId    String?
  building      Building?    @relation(fields: [buildingId], references: [id])
  unitId        String?
  unit          Unit?        @relation(fields: [unitId], references: [id])
  title         String
  description   String?
  status        String   @default("TODO")
  priority      String @default("MEDIUM")
  dueDate       DateTime?
  assignedTo    String?
  assignedUser  User?        @relation("TaskAssignee", fields: [assignedTo], references: [id])
  createdBy     String
  createdByUser User         @relation("TaskCreator", fields: [createdBy], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([projectId])
  @@index([assignedTo])
  @@index([status])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  uploadedById String
  uploadedBy   User     @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

// Per-org configuration for thresholds and probabilities used by alerts and forecasts.
// Single row per org; created on org creation, lazily defaulted in code if missing.
model OrgSettings {
  orgId                        String       @id
  org                          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Sale stage probabilities — JSON map of SaleStatus → probability (0..1)
  // Example: { "PROSPECT": 0.10, "LOI_SIGNED": 0.35, "UNDER_CONTRACT": 0.75, "CLOSED": 1.0 }
  saleStageProbabilities       Json         @default("{\"PROSPECT\":0.10,\"LOI_SIGNED\":0.35,\"UNDER_CONTRACT\":0.75,\"CLOSED\":1.0,\"CANCELLED\":0.0}")
  unitStaleDaysThreshold       Int          @default(90) // unit AVAILABLE longer than this -> stale alert
  budgetVarianceAlertPct       Decimal      @default(10) @db.Decimal(5, 2) // actuals+commitments > budget*(1+pct/100)
  saleStageAgeAlertDays        Int          @default(30) // sale in same stage longer than this -> flag
  saleActivityDroughtDays      Int          @default(14) // no activity for N days -> flag
  drawFundingExpectedDays      Int          @default(14) // default expected funding window
  // Sale priced below the unit's asking price by more than this % needs Founder/Co-Founder approval.
  discountApprovalThresholdPct Decimal      @default(5) @db.Decimal(5, 2)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  @@map("org_settings")
}

// ============================================================================
// Interior / Fit-Out Module + Sale Payment Schedule
// (Phase 1 — see docs/client-discovery/TDD_Interior_and_SalePayment.md)
// All additive: new tables + new enums + nullable back-relations. No breaking changes.
// ============================================================================

enum InteriorPhase {
  DESIGN
  CLIENT_APPROVAL
  CITY_APPROVAL
  PROCUREMENT
  EXECUTION
  SNAGGING
  HANDOVER
}

enum InteriorStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum InteriorContractType {
  PER_SQFT // client default
  FIXED
  COST_PLUS
}

enum SnagStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SalePaymentStatus {
  SCHEDULED
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

enum SalePaymentTrigger {
  ON_SIGNING
  ON_MILESTONE
  FIXED_DATE
  ON_HANDOVER
}

// A post-shell interior fit-out engagement for a unit (or whole building).
// Owns the operational work (phases, scope, sub-contractor invoices, snags).
// The client-facing per-sqft price lives on the linked Sale as a SalePayment installment.
model InteriorProject {
  id                String               @id @default(cuid())
  // Anchor — exactly one of (unitId, buildingId); service-enforced (mirrors Sale/Loan).
  unitId            String?
  unit              Unit?                @relation(fields: [unitId], references: [id])
  buildingId        String?
  building          Building?            @relation(fields: [buildingId], references: [id])
  // Optional context links — "interior is part of the contract agreement".
  saleId            String?
  sale              Sale?                @relation(fields: [saleId], references: [id])
  leaseId           String?
  lease             Lease?               @relation(fields: [leaseId], references: [id])
  name              String
  status            InteriorStatus       @default(NOT_STARTED)
  phase             InteriorPhase        @default(DESIGN)
  pmId              String? // same PM pool — no new role
  pm                User?                @relation("InteriorPM", fields: [pmId], references: [id])
  contractType      InteriorContractType @default(PER_SQFT)
  ratePerSqft       Decimal?             @db.Decimal(12, 2)
  area              Decimal?             @db.Decimal(10, 2) // sqft used for pricing
  contractValue     Decimal?             @db.Decimal(14, 2) // internal cost-to-build; client price is on Sale
  encryptedFields   String? // optional AES blob (open question — currently unused)
  packageTemplateId String?
  packageTemplate   InteriorPackageTemplate? @relation(fields: [packageTemplateId], references: [id])
  startDate         DateTime?
  targetEnd         DateTime?
  handoverAt        DateTime?
  handoverSignedBy  String? // client representative who signed off at handover
  handoverNotes     String?
  // Approval audit (construction team + city)
  clientApprovedAt  DateTime?
  cityApprovedAt    DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime? // soft-delete (matches Sale/Unit/Loan)

  scopeItems InteriorScopeItem[]
  snags      SnagItem[]
  invoices   InteriorInvoice[]
  documents  Document[]
  actuals    Actual[]

  @@index([unitId])
  @@index([buildingId])
  @@index([saleId])
  @@index([status, phase])
  @@index([deletedAt])
  @@map("interior_projects")
}

// Reusable fit-out package (the "2-3 generic options" clients pick from; otherwise custom).
model InteriorPackageTemplate {
  id                 String                @id @default(cuid())
  name               String
  description        String?
  defaultRatePerSqft Decimal?              @db.Decimal(12, 2)
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  items              InteriorPackageItem[]
  interiorProjects   InteriorProject[]

  @@index([deletedAt])
  @@map("interior_package_templates")
}

// A preset BOQ line on a package template; copied into InteriorScopeItem when applied.
model InteriorPackageItem {
  id                String                  @id @default(cuid())
  packageTemplateId String
  packageTemplate   InteriorPackageTemplate @relation(fields: [packageTemplateId], references: [id], onDelete: Cascade)
  description       String
  category          String?
  quantity          Decimal?                @db.Decimal(12, 2)
  unit              String?
  unitPrice         Decimal?                @db.Decimal(12, 2)
  sequence          Int                     @default(0)
  createdAt         DateTime                @default(now())

  @@index([packageTemplateId])
  @@map("interior_package_items")
}

// BOQ / scope line item; can be seeded from a package template.
model InteriorScopeItem {
  id                String          @id @default(cuid())
  interiorProjectId String
  interiorProject   InteriorProject @relation(fields: [interiorProjectId], references: [id], onDelete: Cascade)
  description       String
  category          String? // flooring | ceiling | MEP_ROUGH | MEP_FINISH | joinery
  quantity          Decimal?        @db.Decimal(12, 2)
  unit              String? // sqft | nos | lm
  unitPrice         Decimal?        @db.Decimal(12, 2)
  total             Decimal?        @db.Decimal(14, 2)
  createdAt         DateTime        @default(now())

  @@index([interiorProjectId])
  @@map("interior_scope_items")
}

// Sub-contractor invoice for an interior project. Mirrors into an Actual (tagged
// interiorProjectId) so the cashflow forecast + TI reporting see the outflow.
model InteriorInvoice {
  id                String          @id @default(cuid())
  interiorProjectId String
  interiorProject   InteriorProject @relation(fields: [interiorProjectId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor          @relation(fields: [vendorId], references: [id])
  amount            Decimal         @db.Decimal(14, 2)
  invoiceNo         String?
  invoiceDate       DateTime?
  paidAt            DateTime?
  status            String          @default("PENDING") // PENDING | APPROVED | PAID
  actualId          String? // paired Actual id (set when mirrored)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([interiorProjectId])
  @@index([vendorId])
  @@map("interior_invoices")
}

// Punch-list item. Attaches to an interior project and (later) reusable on construction milestones.
model SnagItem {
  id                String           @id @default(cuid())
  interiorProjectId String?
  interiorProject   InteriorProject? @relation(fields: [interiorProjectId], references: [id], onDelete: Cascade)
  milestoneId       String?
  milestone         Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  description       String
  room              String?
  assigneeId        String?
  assignee          User?            @relation("SnagAssignee", fields: [assigneeId], references: [id])
  status            SnagStatus       @default(OPEN)
  photoPath         String? // Supabase storage key
  dueDate           DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([interiorProjectId, status])
  @@index([milestoneId])
  @@map("snag_items")
}

// An installment on a Sale. Supports BOTH a fixed dueDate and a milestone trigger.
// Feeds the cashflow forecast (inflows) and powers overdue-payment alerts.
model SalePayment {
  id                String             @id @default(cuid())
  saleId            String
  sale              Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  label             String // "Deposit", "Foundation draw", "TI / interior", "Handover"
  sequence          Int                @default(0)
  trigger           SalePaymentTrigger @default(FIXED_DATE)
  // Either a fixed date OR a milestone trigger (service enforces ≥1).
  dueDate           DateTime?
  milestoneId       String?
  milestone         Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  // Stamped from milestone.completedAt when an ON_MILESTONE payment's milestone completes.
  effectiveDueDate  DateTime?
  amount            Decimal            @db.Decimal(14, 2)
  percentOfPrice    Decimal?           @db.Decimal(5, 2)
  paidAmount        Decimal            @default(0) @db.Decimal(14, 2)
  paidAt            DateTime?
  status            SalePaymentStatus  @default(SCHEDULED)
  interiorProjectId String? // set when this installment is the TI / interior charge
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([saleId, sequence])
  @@index([milestoneId])
  @@index([status, effectiveDueDate])
  @@map("sale_payments")
}

// ============================================================================
// Daily Construction Logs (Phase 4) — the client's #1 pain point.
// A dated field log scoped to a project (and optionally a building), with photos.
// Mobile-first capture; reuses StorageService for photo storage keys.
// ============================================================================

model DailyLog {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  logDate    DateTime // the day being logged (distinct from createdAt)
  authorId   String
  author     User      @relation("DailyLogAuthor", fields: [authorId], references: [id])
  notes      String // work done / summary
  weather    String?
  crewCount  Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  photos DailyLogPhoto[]

  @@index([projectId, logDate])
  @@index([buildingId])
  @@map("daily_logs")
}

model DailyLogPhoto {
  id          String   @id @default(cuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  storagePath String // Supabase Storage key
  caption     String?
  uploadedAt  DateTime @default(now())

  @@index([dailyLogId])
  @@map("daily_log_photos")
}

// ============================================================================
// Broker / Referral tracking (Phase 4)
// Internal-only — brokers have NO login. Brokers bring leads; commission is
// earned when an attributed sale closes (flat fee OR % of sale price).
// ============================================================================

model Broker {
  id             String    @id @default(cuid())
  name           String
  company        String?
  email          String?
  phone          String?
  // Either a default % of sale price OR a flat fee. A sale may override the % via
  // Sale.brokerCommissionPct. Service prefers: sale override % → commissionRate % → commissionFlat.
  commissionRate Decimal?  @db.Decimal(5, 2)
  commissionFlat Decimal?  @db.Decimal(14, 2)
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  leads Lead[]
  sales Sale[]

  @@index([isActive, deletedAt])
  @@map("brokers")
}
