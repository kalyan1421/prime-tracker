  user      User?    @relation(fields: [userId], references: [id])
  action    String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String // table/model name
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  // No updatedAt — immutable by design
  // No delete cascade — audit events are never deleted

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

// ---- Custom Options (admin-configurable dropdown values) ----

model CustomOption {
  id          String   @id @default(cuid())
  category    String // e.g. "project_phase", "unit_status", "sale_status"
  value       String // slug stored in DB, e.g. "INTERIOR_FITOUT"
  label       String // display label, e.g. "Interior Fit-Out"
  color       String? // tailwind color token, e.g. "blue", "amber"
  sortOrder   Int      @default(0)
  isSystem    Boolean  @default(false) // system defaults cannot be deleted
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, value])
  @@index([category, isActive])
  @@map("custom_options")
}

// ---- Tasks ----

model Task {
  id            String           @id @default(cuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// LEGACY single-building link, kept for the same reason as `unitId` below: existing
  /// rows, existing queries, and the board's group-by. Mirrored from `buildings` when an
  /// item covers exactly one building.
  buildingId    String?
  building      Building?        @relation(fields: [buildingId], references: [id])
  /// The real building link. Site work routinely spans buildings — one contractor doing
  /// the same job across B1 and B2 is one item, not two.
  buildings     TaskBuilding[]
  /// LEGACY single-unit link. Kept so existing rows and queries keep working, and
  /// maintained as a mirror of `units` when — and only when — an item covers exactly
  /// one unit. New code reads `units`; nothing should write both by hand, because
  /// dual-writing is how the two drift apart.
  unitId        String?
  unit          Unit?            @relation(fields: [unitId], references: [id])
  /// The real unit link. A single work item routinely covers several units at once
  /// ("UNITS 402,403,404" on the client's board), which a scalar unitId cannot say.
  units         TaskUnit[]
  /// TASK        — ordinary work item, what this table has always held
  /// CONSTRUCTION — a site/fit-out item on the construction board
  ///
  /// One table rather than two: Task already carries assignee, status, priority,
  /// comments, attachments and permissions, and a parallel module would duplicate
  /// every one of them. The discriminator exists so the two do not end up in the same
  /// list — a PM's site board and a cross-project admin to-do list are different views
  /// of different work, and mixing them makes both unusable.
  kind          String           @default("TASK")
  title         String
  description   String?
  status        String           @default("TODO")
  priority      String           @default("MEDIUM")
  dueDate       DateTime?
  /// LEGACY single-assignee link. Mirrored from `assignees` when exactly one person
  /// holds the item, so old filters and the `@@index([assignedTo])` keep working.
  assignedTo    String?
  assignedUser  User?            @relation("TaskAssignee", fields: [assignedTo], references: [id])
  /// The real assignee link. Site work is held by a crew, not an individual: the client's
  /// board routinely tags two or three people on one item, and a scalar cannot say that
  /// without someone being silently dropped.
  assignees     TaskAssignment[]
  createdBy     String
  createdByUser User             @relation("TaskCreator", fields: [createdBy], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  comments    TaskComment[]
  attachments TaskAttachment[]
  updates     TaskUpdate[]

  @@index([projectId])
  @@index([assignedTo])
  @@index([status])
  @@index([kind, projectId])
  @@map("tasks")
}

/// Which units a work item covers. Many-to-many because one item routinely spans
/// several units and one unit accumulates many items over a build.
///
/// NOT the same thing as UnitsService.combine(), which MERGES units — creates a new
/// summed-area unit and archives the sources behind mergedIntoId. These units stay
/// separate and keep their own leases, sales and rent history; only the WORK is shared.
/// A task covering several buildings. Same shape and same reasoning as TaskUnit.
model TaskBuilding {
  taskId     String
  buildingId String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@id([taskId, buildingId])
  @@index([buildingId])
  @@map("task_buildings")
}

/// A person holding a task. Carries `notifiedAt` so re-saving an item does not re-notify
/// everybody already on it — only somebody newly added hears about it.
model TaskAssignment {
  taskId     String
  userId     String
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User      @relation("TaskAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  notifiedAt DateTime?

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignments")
}

model TaskUnit {
  taskId String
  unitId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([taskId, unitId])
  @@index([unitId])
  @@map("task_units")
}

/// A dated progress update on a work item — the "Updates" column of the client's board.
///
/// Distinct from TaskComment, which is discussion. An update is a report of what
/// happened on site on a given DAY, and it is what the construction board is for.
model TaskUpdate {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// The day being REPORTED, which is not when it was typed. Site updates are written
  /// up in the evening or the next morning; dating them by createdAt would quietly
  /// shift the whole record. Same reason DailyLog.logDate exists.
  updateDate DateTime
  authorId   String
  author     User     @relation("TaskUpdateAuthor", fields: [authorId], references: [id])
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  photos TaskUpdatePhoto[]

  @@index([taskId, updateDate])
  @@map("task_updates")
}

model TaskUpdatePhoto {
  id           String     @id @default(cuid())
  taskUpdateId String
  taskUpdate   TaskUpdate @relation(fields: [taskUpdateId], references: [id], onDelete: Cascade)
  storagePath  String
  caption      String?
  uploadedAt   DateTime   @default(now())

  @@index([taskUpdateId])
  @@map("task_update_photos")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  uploadedById String
  uploadedBy   User     @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@map("task_attachments")
}

// Per-org configuration for thresholds and probabilities used by alerts and forecasts.
// Single row per org; created on org creation, lazily defaulted in code if missing.
model OrgSettings {
  orgId                        String       @id
  org                          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Sale stage probabilities — JSON map of SaleStatus → probability (0..1)
  // Example: { "PROSPECT": 0.10, "LOI_SIGNED": 0.35, "UNDER_CONTRACT": 0.75, "CLOSED": 1.0 }
  saleStageProbabilities       Json         @default("{\"PROSPECT\":0.10,\"LOI_SIGNED\":0.35,\"UNDER_CONTRACT\":0.75,\"CLOSED\":1.0,\"CANCELLED\":0.0}")
  unitStaleDaysThreshold       Int          @default(90) // unit AVAILABLE longer than this -> stale alert
  budgetVarianceAlertPct       Decimal      @default(10) @db.Decimal(5, 2) // actuals+commitments > budget*(1+pct/100)
  saleStageAgeAlertDays        Int          @default(30) // sale in same stage longer than this -> flag
  saleActivityDroughtDays      Int          @default(14) // no activity for N days -> flag
  drawFundingExpectedDays      Int          @default(14) // default expected funding window
  // Sale priced below the unit's asking price by more than this % needs Founder/Co-Founder approval.
  discountApprovalThresholdPct Decimal      @default(5) @db.Decimal(5, 2)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  @@map("org_settings")
}

// ============================================================================
// Interior / Fit-Out Module + Sale Payment Schedule
// (Phase 1 — see docs/client-discovery/TDD_Interior_and_SalePayment.md)
// All additive: new tables + new enums + nullable back-relations. No breaking changes.
// ============================================================================

enum InteriorPhase {
  DESIGN
  CLIENT_APPROVAL
  CITY_APPROVAL
  PROCUREMENT
  EXECUTION
  SNAGGING
  HANDOVER
}

enum InteriorStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum InteriorContractType {
  PER_SQFT // client default
  FIXED
  COST_PLUS
}

enum SnagStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SalePaymentStatus {
  SCHEDULED
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

enum SalePaymentTrigger {
  ON_SIGNING
  ON_MILESTONE
  FIXED_DATE
  ON_HANDOVER
}

// A post-shell interior fit-out engagement for a unit (or whole building).
// Owns the operational work (phases, scope, sub-contractor invoices, snags).
// The client-facing per-sqft price lives on the linked Sale as a SalePayment installment.
model InteriorProject {
  id                String                   @id @default(cuid())
  // Anchor — exactly one of (unitId, buildingId); service-enforced (mirrors Sale/Loan).
  unitId            String?
  unit              Unit?                    @relation(fields: [unitId], references: [id])
  buildingId        String?
  building          Building?                @relation(fields: [buildingId], references: [id])
  // Optional context links — "interior is part of the contract agreement".
  saleId            String?
  sale              Sale?                    @relation(fields: [saleId], references: [id])
  leaseId           String?
  lease             Lease?                   @relation(fields: [leaseId], references: [id])
  name              String
  status            InteriorStatus           @default(NOT_STARTED)
  phase             InteriorPhase            @default(DESIGN)
  pmId              String? // same PM pool — no new role
  pm                User?                    @relation("InteriorPM", fields: [pmId], references: [id])
  contractType      InteriorContractType     @default(PER_SQFT)
  ratePerSqft       Decimal?                 @db.Decimal(12, 2)
  area              Decimal?                 @db.Decimal(10, 2) // sqft used for pricing
  contractValue     Decimal?                 @db.Decimal(14, 2) // internal cost-to-build; client price is on Sale
  encryptedFields   String? // optional AES blob (open question — currently unused)
  packageTemplateId String?
  packageTemplate   InteriorPackageTemplate? @relation(fields: [packageTemplateId], references: [id])
  startDate         DateTime?
  targetEnd         DateTime?
  handoverAt        DateTime?
  handoverSignedBy  String? // client representative who signed off at handover
  handoverNotes     String?
  // Approval audit (construction team + city)
  clientApprovedAt  DateTime?
  cityApprovedAt    DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime? // soft-delete (matches Sale/Unit/Loan)

  scopeItems InteriorScopeItem[]
  snags      SnagItem[]
  invoices   InteriorInvoice[]
  documents  Document[]
  actuals    Actual[]

  @@index([unitId])
  @@index([buildingId])
  @@index([saleId])
  @@index([status, phase])
  @@index([deletedAt])
  @@map("interior_projects")
}

// Reusable fit-out package (the "2-3 generic options" clients pick from; otherwise custom).
model InteriorPackageTemplate {
  id                 String                @id @default(cuid())
  name               String
  description        String?
  defaultRatePerSqft Decimal?              @db.Decimal(12, 2)
  active             Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  items              InteriorPackageItem[]
  interiorProjects   InteriorProject[]

  @@index([deletedAt])
  @@map("interior_package_templates")
}

// A preset BOQ line on a package template; copied into InteriorScopeItem when applied.
model InteriorPackageItem {
  id                String                  @id @default(cuid())
  packageTemplateId String
  packageTemplate   InteriorPackageTemplate @relation(fields: [packageTemplateId], references: [id], onDelete: Cascade)
  description       String
  category          String?
  quantity          Decimal?                @db.Decimal(12, 2)
  unit              String?
  unitPrice         Decimal?                @db.Decimal(12, 2)
  sequence          Int                     @default(0)
  createdAt         DateTime                @default(now())

  @@index([packageTemplateId])
  @@map("interior_package_items")
}

// BOQ / scope line item; can be seeded from a package template.
model InteriorScopeItem {
  id                String          @id @default(cuid())
  interiorProjectId String
  interiorProject   InteriorProject @relation(fields: [interiorProjectId], references: [id], onDelete: Cascade)
  description       String
  category          String? // flooring | ceiling | MEP_ROUGH | MEP_FINISH | joinery
  quantity          Decimal?        @db.Decimal(12, 2)
  unit              String? // sqft | nos | lm
  unitPrice         Decimal?        @db.Decimal(12, 2)
  total             Decimal?        @db.Decimal(14, 2)
  createdAt         DateTime        @default(now())

  @@index([interiorProjectId])
  @@map("interior_scope_items")
}

// Sub-contractor invoice for an interior project. Mirrors into an Actual (tagged
// interiorProjectId) so the cashflow forecast + TI reporting see the outflow.
model InteriorInvoice {
  id                String          @id @default(cuid())
  interiorProjectId String
  interiorProject   InteriorProject @relation(fields: [interiorProjectId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor          @relation(fields: [vendorId], references: [id])
  amount            Decimal         @db.Decimal(14, 2)
  invoiceNo         String?
  invoiceDate       DateTime?
  paidAt            DateTime?
  status            String          @default("PENDING") // PENDING | APPROVED | PAID
  actualId          String? // paired Actual id (set when mirrored)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([interiorProjectId])
  @@index([vendorId])
  @@map("interior_invoices")
}

// Punch-list item. Attaches to an interior project and (later) reusable on construction milestones.
model SnagItem {
  id                String           @id @default(cuid())
  interiorProjectId String?
  interiorProject   InteriorProject? @relation(fields: [interiorProjectId], references: [id], onDelete: Cascade)
  milestoneId       String?
  milestone         Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  description       String
  room              String?
  assigneeId        String?
  assignee          User?            @relation("SnagAssignee", fields: [assigneeId], references: [id])
  status            SnagStatus       @default(OPEN)
  photoPath         String? // Supabase storage key
  dueDate           DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([interiorProjectId, status])
  @@index([milestoneId])
  @@map("snag_items")
}

// An installment on a Sale. Supports BOTH a fixed dueDate and a milestone trigger.
// Feeds the cashflow forecast (inflows) and powers overdue-payment alerts.
model SalePayment {
  id                String             @id @default(cuid())
  saleId            String
  sale              Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  label             String // "Deposit", "Foundation draw", "TI / interior", "Handover"
  sequence          Int                @default(0)
  trigger           SalePaymentTrigger @default(FIXED_DATE)
  // Either a fixed date OR a milestone trigger (service enforces ≥1).
  dueDate           DateTime?
  milestoneId       String?
  milestone         Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  // Stamped from milestone.completedAt when an ON_MILESTONE payment's milestone completes.
  effectiveDueDate  DateTime?
  amount            Decimal            @db.Decimal(14, 2)
  percentOfPrice    Decimal?           @db.Decimal(5, 2)
  paidAmount        Decimal            @default(0) @db.Decimal(14, 2)
  paidAt            DateTime?
  status            SalePaymentStatus  @default(SCHEDULED)
  interiorProjectId String? // set when this installment is the TI / interior charge
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([saleId, sequence])
  @@index([milestoneId])
  @@index([status, effectiveDueDate])
  @@map("sale_payments")
}

// ============================================================================
// Daily Construction Logs (Phase 4) — the client's #1 pain point.
// A dated field log scoped to a project (and optionally a building), with photos.
// Mobile-first capture; reuses StorageService for photo storage keys.
// ============================================================================

model DailyLog {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  // Daily logs were building-level only, so per-unit fit-out progress had nowhere to
  // go and was written as free text into a building's log. Nullable: a site-wide log
  // (weather, crew count, concrete pour) genuinely is not about one unit.
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  logDate    DateTime // the day being logged (distinct from createdAt)
  authorId   String
  author     User      @relation("DailyLogAuthor", fields: [authorId], references: [id])
  notes      String // work done / summary
  weather    String?
  crewCount  Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  photos DailyLogPhoto[]

  @@index([projectId, logDate])
  @@index([buildingId])
  @@index([unitId, logDate])
  @@map("daily_logs")
}

model DailyLogPhoto {
  id          String   @id @default(cuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  storagePath String // Supabase Storage key
  caption     String?
  uploadedAt  DateTime @default(now())

  @@index([dailyLogId])
  @@map("daily_log_photos")
}

// ============================================================================
// Broker / Referral tracking (Phase 4)
// Internal-only — brokers have NO login. Brokers bring leads; commission is
// earned when an attributed sale closes (flat fee OR % of sale price).
// ============================================================================

model Broker {
  id             String    @id @default(cuid())
  name           String
  company        String?
  email          String?
  phone          String?
  // Either a default % of sale price OR a flat fee. A sale may override the % via
  // Sale.brokerCommissionPct. Service prefers: sale override % → commissionRate % → commissionFlat.
  commissionRate Decimal?  @db.Decimal(5, 2)
  commissionFlat Decimal?  @db.Decimal(14, 2)
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  leads  Lead[]
  sales  Sale[]
  leases Lease[]

  @@index([isActive, deletedAt])
  @@map("brokers")
}
