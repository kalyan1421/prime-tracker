// ---- Documents ----

enum DocCategory {
  GENERAL
  PERMIT
  CONTRACT
  FINANCIAL
  DRAWING
  PHOTO
  LEGAL
  // Phase 1 — sales lifecycle
  BROCHURE
  LOI
  DEED
  // Phase 1 — buyer-portal categories (visible to CLIENT role when isClientVisible)
  BOOKING_AGREEMENT
  RECEIPT
  NOC
  POSSESSION_CERTIFICATE
  // Interior / fit-out phase gates
  CITY_APPROVAL
  HANDOVER_CERTIFICATE
}

model Document {
  id                String                  @id @default(cuid())
  projectId         String?
  project           Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId        String?
  building          Building?               @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId            String?
  unit              Unit?                   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  saleId            String?
  sale              Sale?                   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              Lead?                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Interior fit-out attachment (city-approval doc, handover certificate, etc.)
  interiorProjectId String?
  interiorProject   InteriorProject?        @relation(fields: [interiorProjectId], references: [id], onDelete: Cascade)
  // Current-version metadata. On replace, the prior values are copied into a DocumentVersion row.
  fileName          String
  fileUrl           String
  storagePath       String?
  fileSize          Int?
  mimeType          String?
  // First-class link target so Sales can paste a DocuSign / Drive URL instead of uploading.
  // Either fileUrl OR externalUrl will be populated (storagePath null when external).
  externalUrl       String?
  category          DocCategory             @default(GENERAL)
  // Phase 2 portal flag. Default false — promotion is always an explicit internal action.
  isClientVisible   Boolean                 @default(false)
  versionNumber     Int                     @default(1)
  uploadedById      String
  uploadedBy        User                    @relation("DocumentUploader", fields: [uploadedById], references: [id])
  versions          DocumentVersion[]
  leaseAssignments  LeaseTenantAssignment[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  @@index([projectId])
  @@index([buildingId])
  @@index([unitId])
  @@index([saleId])
  @@index([leadId])
  @@index([interiorProjectId])
  @@index([category, deletedAt])
  @@index([isClientVisible, deletedAt])
  @@index([deletedAt])
  @@map("documents")
}

// Archive of prior document versions. Created when a Document's file is replaced.
model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  fileName      String
  fileUrl       String
  storagePath   String?
  fileSize      Int?
  mimeType      String?
  externalUrl   String?
  notes         String?
  uploadedById  String
  uploadedBy    User     @relation("VersionUploader", fields: [uploadedById], references: [id])
  // When this version was originally uploaded as the live document.
  uploadedAt    DateTime
  // When this version was superseded (i.e., archived).
  archivedAt    DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

